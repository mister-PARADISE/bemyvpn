/* Ресурс-скрипт Windows для терминальной оболочки: только сведения о файле.

   Манифеста и значка здесь НЕТ намеренно. Значок консольному exe рисовать
   некуда, а манифест с requireAdministrator сделал бы невозможным запуск
   `bemyvpn version` или `bemyvpn status` без диалога UAC — терминал поднимает
   туннель уже из-под администратора, если пользователь его так запустил.

   Сведения о файле нужны по той же причине, что и окну (см. apps/bmv-gui/bemyvpn.rc):
   без них в свойствах файла пусто, а безымянный неподписанный exe эвристики
   Defender/SmartScreen считают подозрительным сами по себе.
   Версию подставляет build.rs из BMV_VERSION — из того же источника, что и
   ответ команды `bemyvpn version`; CI сверяет одно с другим у готового exe. */
#pragma code_page(65001)

1 VERSIONINFO
FILEVERSION BMV_VER_NUM
PRODUCTVERSION BMV_VER_NUM
FILEOS 0x40004L    /* VOS_NT_WINDOWS32 */
FILETYPE 0x1L      /* VFT_APP */
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"   /* русский (0x419) + Unicode (1200) */
        BEGIN
            VALUE "CompanyName",      "BeMyVPN"
            VALUE "FileDescription",  "BeMyVPN — терминал и сервер"
            VALUE "FileVersion",      BMV_VER_STR
            VALUE "InternalName",     "bemyvpn"
            VALUE "LegalCopyright",   "© BeMyVPN"
            VALUE "OriginalFilename", "bemyvpn.exe"
            VALUE "ProductName",      "BeMyVPN"
            VALUE "ProductVersion",   BMV_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x419, 1200
    END
END
