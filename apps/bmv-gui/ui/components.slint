// Переиспользуемые блоки — построчный перенос iOS ContentView.swift: диск
// состояния, плитки, кнопки, парящий блок с ореолом, поле ввода, чипы.
import { Theme } from "theme.slint";
import { IconCopy, IconCheck, IconAntennaOff } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

// Модель карточки хоста (заполняет Rust).
export struct HostRow {
    id: string,
    name: string,
    flag-img: image,
    has-flag: bool,
    subtitle: string,
    locked: bool,
    usable: bool,
    fill: float,         // заполненность 0..1 (полоса под подписью)
    code: string,
    ip: string,
    country: string,
    guests: string,
    access: string,
    proto: string,       // имя протокола
    proto-id: string,    // сырой id протокола (для значка)
    // Подпись отклика — готовая («24 мс»), из общего справочника.
    // Меряется по РАСКРЫТИЮ карточки, а не для всего списка сразу: проба —
    // это сетевой запрос, и делать их пачкой ради строк, на которые никто не
    // смотрит, значит зря дёргать чужие машины.
    ping: string,
    /// НАСКОЛЬКО ТРЕВОЖНА ЦИФРА, а не сама цифра: 0 спокойно · 1 янтарь ·
    /// 2 красный · 3 нет ответа (`bmv_common::view::Alarm`), −1 — ещё не мерили.
    ///
    /// Раньше сюда ехали миллисекунды, и разметка сравнивала их с 250 и 500 —
    /// то есть держала вторую копию линейки пинга, которую приходилось сверять
    /// тестом. Порог живёт в справочнике; окну достаточно знать уровень.
    ping-alarm: int,
}

/// ДИСК СОСТОЯНИЯ — ОДНА ДЕТАЛЬ НА ВСЕ РАЗМЕРЫ.
///
/// Заливка `tint·disc-fill` плюс кольцо `tint·disc-ring` были написаны девятью
/// копиями с диаметрами 38/72/74/84/88 — по одной на каждое место, где диск
/// понадобился. Копии разошлись мгновенно: 84 в мёртвом компоненте против 72 на
/// живых страницах, из-за чего компонент и лежал мёртвым — страницам он не
/// подходил размером, а размер был вписан числом.
///
/// Размер здесь ЕДИНСТВЕННЫЙ параметр — `d`. Ни своей заливки, ни толщины
/// кольца, ни тени: как только у диска появится второй способ выглядеть,
/// начнётся вторая копия. Значок кладёт вызывающий (`@children`).
///
/// НАРУЖУ БОЛЬШЕ НЕ ОТДАЁТСЯ: страницы ставят не «диск», а `Hero` (крупный, при
/// бездействии) или `StatusLine` (мелкий, в работе) — оба здесь же. Пока диск
/// был экспортирован, каждая страница обкладывала его своей коробкой в 74px и
/// своим центрированием, и три эти копии разошлись.
component StateDisc inherits Rectangle {
    in property <color> tint: Theme.accent;
    in property <length> d: 38px;
    /// Расходящаяся волна — «идёт процесс». Всегда 1200мс и ×1.28.
    in property <bool> pulsing: false;
    width: root.d;
    height: root.d;
    // Часы тикают только пока волна нужна: элемент существует под `if`, и
    // вместе с ним исчезает и перерисовка каждого кадра.
    if root.pulsing: Rectangle {
        property <float> t: Math.mod(animation-tick() / 1ms, 1200) / 1200;
        property <length> ring: root.d * (1 + 0.28 * self.t);
        x: (root.d - self.ring) / 2;
        y: (root.d - self.ring) / 2;
        width: self.ring;
        height: self.ring;
        border-radius: self.ring / 2;
        border-width: 2px;
        border-color: root.tint.with-alpha(0.5 * (1 - self.t));
    }
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.d / 2;
        background: Theme.disc-fill(root.tint);
        border-width: 1px;
        border-color: Theme.disc-ring(root.tint);
    }
    // Значок кладёт вызывающий.
    HorizontalLayout {
        alignment: center;
        VerticalLayout { alignment: center; @children }
    }
}

// ── Плитки ───────────────────────────────────────────────────────────────────

// Каркас плитки: подпись мелко сверху, значение снизу (TileBody на iOS).
component TileFrame inherits Rectangle {
    in property <color> stroke: Theme.hairline;
    /// Заливка плитки — нейтральная ступень s3, ОДНА И ТА ЖЕ у плиток панели
    /// состояния и у плиток внутри раскрытой карточки хоста. Ручка оставлена
    /// затем, что раскрытая карточка задаёт заливку одним местом на всю сетку
    /// (см. `tile-fill` в vpn_page.slint), а не семью вызовами по отдельности.
    in property <color> fill: Theme.tile;
    // Равные колонки: и min-, и preferred-width = 0 → ширину задаёт ТОЛЬКО stretch
    // (иначе Slint сперва даёт каждой плитке preferred по её содержимому, и длинный
    // код перетягивает место у IP). clip — чтобы длинное значение не вылезало.
    min-width: 0px;
    preferred-width: 0px;
    clip: true;
    height: 52px;
    border-radius: 12px;
    background: root.fill;
    border-width: 1px;
    border-color: root.stroke;
    animate border-color { duration: 180ms; easing: ease-out; }
}

/// Подпись плитки — мелкая, ЗАГЛАВНЫМИ. Один компонент на все три плитки:
/// раньше эти три строки были скопированы в каждую плитку по отдельности, и
/// починка надстрочных знаков (ниже) в одной из копий тихо разошлась бы с
/// остальными.
///
/// ЗАЧЕМ ЯВНАЯ ВЫСОТА И ВЫРАВНИВАНИЕ ВНИЗ.
///
/// Slint (femtovg) обрезает текст по прямоугольнику САМОГО элемента Text, а
/// неявная высота этого прямоугольника кончается на линии ЗАГЛАВНЫХ букв
/// (cap-height). Всё, что торчит выше, срезается начисто — а у русских
/// ЗАГЛАВНЫХ «Й» и «Ё» надстрочный знак стоит именно выше cap-height. Поэтому
/// «ГОСТЕЙ» рисовалось как «ГОСТЕИ»: не бледно, а вообще без серпика. Строчные
/// «й» и «ё» не страдают — их знак ниже линии заглавных, он внутри коробки.
///
/// Лечится ТОЛЬКО запасом высоты у самого Text, причём запас должен лечь СВЕРХУ:
/// проверено опытом — ни высота с выравниванием по умолчанию (запас уходит
/// вниз), ни выравнивание без запаса, ни высокий родитель не помогают, помогает
/// пара «высота + выравнивание вниз». 14px при кегле 10px даёт 2px сверху —
/// этого хватает с запасом (знак цел уже при 13px).
component TileLabel inherits Text {
    color: Theme.dim;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.7px;
    height: 14px;
    vertical-alignment: bottom;
}

// Плитка-факт. Значок — ПОСЛЕ значения (как копи-значок у CopyTile), значение
// всегда прижато влево → все плитки в сетке выровнены одинаково.
export component StatTile inherits TileFrame {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.fg;
    VerticalLayout {
        // ПАРА ЦЕНТРИРУЕТСЯ ПО ВЫСОТЕ. Раньше стояли фиксированные отступы
        // 9px сверху и снизу, а сумма строк с их межстрочными интервалами
        // перекрывала 52px — значение выдавливало к нижнему краю, и казалось,
        // что оно проваливается из ячейки.
        alignment: center;
        padding-left: 11px; padding-right: 11px; padding-top: 8px; padding-bottom: 8px;
        spacing: 3px;
        TileLabel { text: root.label; }
        // Значение и значок — ПО ЦЕНТРУ ячейки. Раньше текст растягивался
        // (horizontal-stretch), прижимая значок к правому краю, и в соседних
        // плитках значки оказывались по разные стороны — взгляд цеплялся за
        // разнобой. Заголовок остаётся слева: он подпись к ячейке, а не содержимое.
        HorizontalLayout {
            spacing: 5px;
            alignment: center;
            Text {
                text: root.value; color: root.tint; font-size: 13.5px; font-weight: 600;
                overflow: elide; min-width: 0px; vertical-alignment: center;
            }
            VerticalLayout { alignment: center; @children }
        }
    }
}

/// Плитка отклика до хоста. ЦВЕТ И СОДЕРЖИМОЕ — ПО УРОВНЮ ТРЕВОГИ, а не по
/// буквам подписи: сравнивать показанную строку с «—» значило держать третье
/// представление одного значения (были ещё число и текст) — и стоило поменять
/// прочерк в справочнике, как плитка молча переставала узнавать «нет ответа».
///
///   • ещё не мерили (−1) — многоточие: место занято, ждать понятно;
///   • ответа нет (3) — перечёркнутая антенна: у «нет отклика» отдельный знак,
///     а не прочерк, который легко принять за «данных нет»;
///   • число есть (0/1/2) — цифра, цвет по уровню.
///
/// АКЦЕНТА В ПИНГЕ НЕТ ВОВСЕ: мята в этом приложении значит «работает», а не
/// «быстро». Норма молчит — обычный цвет текста.
export component PingTile inherits StatTile {
    /// Готовая подпись из справочника («24 мс»).
    in property <string> ping;
    /// Уровень тревоги: 0 спокойно · 1 янтарь · 2 красный · 3 нет ответа.
    /// −1 — замера ещё не было (у справочника такого состояния нет: ждать умеет
    /// только оболочка).
    in property <int> alarm: -1;

    label: "ПИНГ";
    // Без слова «нет»: перечёркнутая антенна говорит сама.
    value: root.alarm < 0 ? "…" : root.alarm == 3 ? "" : root.ping;
    tint: root.alarm == 1 ? Theme.amber
        : root.alarm == 2 ? Theme.red
        : (root.alarm == 3 || root.alarm < 0) ? Theme.dim
        : Theme.fg;

    if root.alarm == 3: IconAntennaOff { width: 13px; height: 13px; tint: Theme.dim; }
}

// Плитка со значением, которое копируется тапом (код, IP).
export component CopyTile inherits TileFrame {
    in property <string> label;
    in property <string> value;
    callback copy(string);
    property <bool> copied: false;
    stroke: copied ? Theme.edge-done(Theme.accent) : Theme.hairline;
    reset := Timer {
        interval: Theme.copied-ms;
        running: root.copied;
        triggered() => { root.copied = false; }
    }
    VerticalLayout {
        alignment: center;   // см. StatTile: иначе значение проваливается вниз
        padding-left: 11px; padding-right: 11px; padding-top: 8px; padding-bottom: 8px;
        spacing: 3px;
        TileLabel { text: root.label; }
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.copied ? "Скопировано" : root.value;
                color: root.copied ? Theme.accent : Theme.fg;
                font-size: 13.5px; font-weight: 600;
                overflow: elide; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center;
            }
            if root.value != "" && root.value != "—": VerticalLayout {
                alignment: center;
                if !root.copied: IconCopy { width: 13px; height: 13px; tint: Theme.accent; }
                if root.copied: IconCheck { width: 13px; height: 13px; tint: Theme.accent; }
            }
        }
    }
    ta := TouchArea {
        clicked => {
            if (root.value != "" && root.value != "—") {
                root.copy(root.value);
                root.copied = true;
            }
        }
    }
}

/// ПАРЯЩИЙ БЛОК — панель состояния и нав-бар. Одна отделка на оба: два слоя над
/// страницей читаются как один язык, а не как две разные плашки.
///
/// ВЫСОТУ ДЕРЖИТ ПЕРЕПАД К ФОНУ, А НЕ ПОДПОРКИ ПО КРАЮ.
///
///  1. ЗАЛИВКА НЕПРОЗРАЧНАЯ И СВЕТЛЕЕ ФОНА НА 11.5 по L*. Прежние 0.97 не
///     покупали ничего: размытия под блоком нет ни на одной оболочке, зато
///     сквозь панель на снимке читался текст списка под ней.
///  2. КРОМКИ СВЕТА СВЕРХУ БОЛЬШЕ НЕТ. Она была подпоркой под тёмную палитру и
///     компенсировала слабый перепад: на прежних поверхностях блок отличался от
///     фона всего на 6.4 по L*, и край приходилось обводить руками. Замер
///     показал, что и тень тут ни при чём — до чёрного фону 8 единиц из 255,
///     тень углубляет его на 1–3 в ЛЮБОЙ палитре. Теперь перепад 13.5, край
///     виден сам, а «полоска в 1 пиксель» сверху — просто мусор на виду.
///     По бокам и снизу остаётся тихая рамка (`stroke`).
///  3. ТЕНЬ КОРОТКАЯ, НО С ПОЛОГИМ СПАДОМ. Дальняя 30-пиксельная была не видна
///     вовсе и читалась как виньетка; сменившая её короткая-плотная (размытие 9
///     при 90 %) ушла в другую крайность — у самой кромки блока фон падал сразу
///     почти в чёрный, и край тени ОБРЫВАЛСЯ, а не спадал. Теперь размытие
///     БОЛЬШЕ, а непрозрачность МЕНЬШЕ: тот же короткий вылет, но кривая
///     пологая. Сторона подъезда — параметр: у панели (прижата сверху) тень
///     ВНИЗ, у нав-бара (прижат снизу) — ВВЕРХ. Раньше у бара тень уезжала под
///     него, в полосу, на которую никто не смотрит.
///
///     ПЛОТНОСТЬ УБАВЛЕНА С 0.6 ДО 0.35, ВЫЛЕТ И РАЗМЫТИЕ НЕ ТРОНУТЫ. Замер по
///     снимку: при 0.6 самая тёмная точка тени была 4/255 при фоне 9/255 —
///     глубина 5 единиц из 255, то есть тень и в полную силу почти ничего не
///     делала. Это не свойство настройки, а свойство фона: до чёрного странице
///     остаётся восемь единиц, глубже чёрной тени падать некуда.
///
///     ТЕНЬ И ОРЕОЛ — РАЗНЫЕ МЕХАНИЗМЫ. Ореол (FloatHalo) — это фон страницы,
///     гасящий проезжающее ПОД блоком содержимое; тень — тёмный след самого
///     блока. Ореол рисуется ПОД тенью (он объявлен раньше), поэтому тень
///     ложится на уже погашенный фон, а не смешивается с ним в грязную полосу.
///
/// Гашение содержимого, уходящего под блок, живёт не здесь, а в FloatHalo:
/// оно рисуется ПОД карточкой, а дети в Slint всегда над фоном родителя.
export component FloatCard inherits Rectangle {
    in property <length> radius: 22px;
    /// Рамка по бокам и снизу. У панели её место занимает кольцо состояния.
    in property <color> stroke: Theme.hairline-float;
    /// Блок прижат снизу (нав-бар) — тень уходит ВВЕРХ, к содержимому.
    in property <bool> lift-up: false;
    border-radius: root.radius;
    background: Theme.float-bg;
    border-width: 1px;
    border-color: root.stroke;
    drop-shadow-blur: 16px;
    // Доля, а не шестнадцатеричная альфа: `#0000005A` не сверить глазом с `0.35`
    // в Swift, а `with-alpha(0.35)` — можно.
    drop-shadow-color: #000000.with-alpha(0.35);
    drop-shadow-offset-y: root.lift-up ? -5px : 5px;
    @children
}

/// ОРЕОЛ ПАРЯЩЕГО БЛОКА: гашение содержимого, уходящего под блок. Ставится
/// ПЕРЕД своим FloatCard и с той же геометрией — тогда он лежит под ним.
///
/// ЭТО СВОЙСТВО БЛОКА, А НЕ ПОЛОСА РЯДОМ С НИМ. Полоса гасила только «до» и
/// «после»: сбоку от карточки содержимое ехало в полную яркость, а в вырезах
/// скруглённых углов пролезало наружу и обрывалось ножом. Ореол — силуэт самого
/// блока, размытый наружу, поэтому расстояние до контура одинаково считается со
/// всех сторон, включая вырезы углов.
///
/// Механизм — штатная тень Slint в цвет страницы: тень и есть размытый силуэт.
/// Никакого второго приёма для боков и углов не нужно.
///
/// Кликов не перехватывает: в Slint ловит только TouchArea.
///
/// На коротком списке невидим по построению: это фон страницы, растворяющийся в
/// фоне страницы. Тенью посреди пустоты он стать не может.
/// ЧИСЛА ВЫВЕДЕНЫ ИЗ ГЕОМЕТРИИ ВЫРЕЗА, А НЕ ПОДОБРАНЫ, И СЧИТАЮТСЯ ПО СВОЕМУ
/// РАДИУСУ. Самая дальняя от контура точка выреза скруглённого угла — сам угол
/// габаритной коробки, и он отстоит от дуги ровно на R·(√2−1): 9.11 у панели
/// (R 22) и 11.60 у бара (R 28). Гашение, спадающее прямо от контура, в этой
/// точке даёт уже половину яркости — вырез не вычистить, пока гашение не полное
/// на этом расстоянии. Отсюда `solid` (плюс полпункта на округление); раньше
/// здесь стояло плоское 12 — потолок обоих блоков, и панель гасила в полную силу
/// на 20% дольше, чем ей нужно.
///
/// Для гауссианы «полное» = 3.09σ, а вся протяжённость = spread + blur, отсюда:
///   solid + 5.09σ = veil,  spread = solid + 3.09σ,  blur = 2σ.
/// Тень Slint размывает силуэт с σ = blur/2 и доходит наружу ровно на blur.
/// При veil = 18: панель — spread 14.7, blur 3.3; бар — spread 15.7, blur 2.3.
export component FloatHalo inherits Rectangle {
    /// Радиус скругления блока, который ореол обнимает.
    in property <length> radius: 22px;
    /// Блок прижат снизу (нав-бар) — «за блок» значит вниз, а не вверх.
    in property <bool> lift-up: false;
    property <length> solid: root.radius * 0.4142136 + 0.5px;
    property <length> sigma: (Theme.veil - root.solid) / 5.09;
    property <length> spread: root.solid + 3.09 * root.sigma;
    Rectangle {
        x: -root.spread;
        y: root.lift-up ? -root.spread : -Theme.halo-back;
        width: root.width + 2 * root.spread;
        height: root.height + root.spread + Theme.halo-back;
        // Раздутый контур блока: смещение наружу на d превращает скругление
        // радиуса R в скругление R + d — потому силуэт и повторяет форму.
        border-radius: root.radius + root.spread;
        drop-shadow-blur: 2 * root.sigma;
        drop-shadow-color: Theme.bg;
    }
}

/// ПАНЕЛЬ СОСТОЯНИЯ СТРАНИЦЫ ЦЕЛИКОМ: ореол, карточка, отступы, кольцо
/// состояния. Каркас был написан ТРИЖДЫ — по копии на вкладку, — и все три
/// копии приходилось править вместе: и когда завесу укоротили с 24 до 18, и
/// когда у кольца убавили силу, и когда панель перестала быть соседом
/// прокрутки. Теперь правка одна.
///
/// Панель — НЕ сосед прокрутки сверху, а НАКЛАДКА. Содержимое идёт во всю
/// высоту ПОД ней и видно в боковых зазорах (по `Theme.pad` слева и справа от
/// карточки): оно уходит под панель, а не обрывается о её край. Соседом по
/// колонке панель занимала бы собственную полосу во всю ширину, и по бокам от
/// скруглённой карточки стояла бы пустая полоса цвета страницы.
///
/// СТАВИТСЯ ПОСЛЕ прокрутки: `z` в Slint нет, поверх рисуется объявленный
/// последним.
///
/// У обёртки нет ни фона, ни тени — ровно затем, чтобы сквозь боковые зазоры
/// было видно, как содержимое проходит насквозь. Фон и тень — только у самой
/// карточки (`FloatCard`), по её скруглённому контуру. Ореол — отдельным
/// соседом ПЕРЕД ней: дети рисуются над фоном родителя, поэтому гашение может
/// лежать под карточкой только раньше её в объявлении.
export component FloatPanel inherits Rectangle {
    /// Цвет состояния — им светится кольцо. ТИШЕ СОДЕРЖИМОГО: на 0.45 обводка
    /// выходила ярче самой панели, и вся «высота» держалась на ней.
    in property <color> tint: Theme.accent;
    x: 0;
    y: 0;
    width: 100%;
    // Ровно по содержимому: иначе накладка растянулась бы во весь экран и
    // накрыла страницу целиком.
    height: box.preferred-height;
    // Геометрия ореола — ровно коробка карточки: отступ страницы сверху и с
    // боков, 12 снизу.
    FloatHalo {
        x: Theme.pad; y: Theme.pad;
        width: parent.width - 2 * Theme.pad;
        height: parent.height - Theme.pad - 12px;
    }
    box := VerticalLayout {
        padding: Theme.pad;
        padding-bottom: 12px;
        // Общий парящий блок: фон и тень — те же, что у нав-бара.
        FloatCard {
            stroke: root.tint.with-alpha(0.30);
            // Глушит клики по пустым местам карточки: без неё тап проваливался
            // бы на карточку хоста, лежащую ПОД панелью. Стоит ПЕРВОЙ —
            // содержимое объявлено ниже и в попадании выигрывает у неё.
            TouchArea {}
            VerticalLayout {
                alignment: start;   // иначе строки разъезжаются по высоте
                padding-top: 16px; padding-bottom: 18px;
                padding-left: 18px; padding-right: 18px;
                spacing: 8px;
                @children
            }
        }
    }
}

/// ПРОКРУЧИВАЕМАЯ ЧАСТЬ СТРАНИЦЫ — вторая половина того же приёма: идёт во всю
/// высоту, под парящей панелью и под нав-баром. Тоже была написана трижды, и
/// нижний отступ уже правили во всех трёх копиях разом (120 → 114, вслед за
/// укороченной завесой).
export component PageScroll inherits ScrollView {
    /// Высота парящей панели: содержимое начинается ровно под ней и уходит под
    /// неё при прокрутке. Числом это было бы враньём — высота панели меняется
    /// вместе с состоянием.
    in property <length> panel-h;
    width: 100%;
    height: 100%;
    vertical-scrollbar-policy: ScrollBarPolicy.always-off;
    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
    // СОДЕРЖИМОЕ ПРИЖАТО К ВЕРХУ, и пустота внизу короткой страницы — это
    // ЧЕСТНЫЙ ВИД короткой страницы, а не поломка. Пробовали раздать свободное
    // место (`viewport-height: max(…)` + выравнивание по центру): пустота не
    // исчезает — она РАЗДВАИВАЕТСЯ. На вкладке «Сервер» вместо одного провала
    // внизу вышло два, а на вкладке VPN между панелью и первым разделом
    // появилась полоса фона в полсотни точек, хотя всё правило панели в том и
    // состоит, что содержимое начинается ПРЯМО под ней и уходит ПОД неё.
    // Снимки обеих вкладок сравнивались на живом окне.
    VerticalLayout {
        alignment: start;
        padding: Theme.pad;
        padding-top: root.panel-h + 6px;   // 6 = 18 (завеса) − 12 (нижний отступ обёртки панели)
        // Ниже плавает нав-бар: низ покоящегося содержимого = верх его завесы.
        padding-bottom: 114px;
        spacing: Theme.gap;
        @children
    }
}

/// ГЕРОЙ ПАНЕЛИ: крупный круг со значком, заголовок, подпись. Показывается,
/// когда показывать больше нечего (VPN выключен, раздача выключена, связи нет).
///
/// Копий было три, и они разошлись ровно там, где расхождение не видно на своём
/// экране, — В ОБРЕЗКЕ ТЕКСТА: где-то заголовок обрезался многоточием, где-то
/// переносился, а у подписи на вкладке «Хост» обрезка вообще осталась по
/// умолчанию. А умолчание (`overflow: clip`) режет текст по прямоугольнику
/// самого `Text`, высота которого кончается на линии ЗАГЛАВНЫХ, — и у «Й» и «Ё»
/// надстрочный знак срезается начисто («к ЙОШКАР-ОЛА» рисовалось как «к
/// ИОШКАР-ОЛА»). Имя хоста и текст ошибки приходят по сети, с любыми буквами.
///
/// ПОЛИТИКА ОДНА НА ОБЕ СТРОКИ: переносить по словам и не обрезать. Переносится
/// то, что не влезло, — а не пропадает.
export component Hero inherits VerticalLayout {
    in property <color> tint: Theme.dim;
    /// Расходящаяся волна — «идёт процесс».
    in property <bool> pulsing: false;
    in property <string> title;
    /// Пустая подпись места не занимает: у страницы «Сервер» под заголовком
    /// стоит свой адрес моноширинным, а не общая подпись.
    in property <string> sub;
    spacing: 8px;
    Rectangle {
        height: 74px;
        StateDisc {
            x: (parent.width - self.width) / 2;
            y: 1px;
            d: 72px;
            tint: root.tint;
            pulsing: root.pulsing;
            @children
        }
    }
    Text {
        text: root.title;
        color: Theme.fg; font-size: 21px; font-weight: 800;
        horizontal-alignment: center; wrap: word-wrap; overflow: elide;
    }
    if root.sub != "": Text {
        text: root.sub;
        color: Theme.dim; font-size: 13px;
        horizontal-alignment: center; wrap: word-wrap; overflow: elide;
    }
}

// ── Кнопки ───────────────────────────────────────────────────────────────────

/// Главная кнопка страницы. СПОКОЙНАЯ: подкраска ~15% + рамка ~40% + цветной
/// текст — тот же приём, что у ShareButton, у действующей ячейки нав-бара и у
/// «Подключить» в карточке хоста.
///
/// Был сплошной градиент во всю ширину. Он кричал громче всего на экране и
/// перетягивал внимание с того, ради чего на экран смотрят: на вкладке
/// «Сервер» синяя плашка «Сохранить и проверить» была заметнее и адреса, и
/// состояния связи. Один стиль на все кнопки — ещё и способ не выбирать
/// каждый раз заново, что здесь «главнее».
export component CalmButton inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    in property <length> corner: 14px;
    in property <color> hue: Theme.accent;
    callback clicked;
    height: 50px;
    border-radius: root.corner;
    // Та же подкраска, что у выбранного чипа: кнопка тоже лежит на странице, и
    // прозрачным акцентом она смешивалась с почти чёрным фоном — выходила
    // ТЕМНЕЕ соседнего поля ввода (13.6 против 15.5 по L*) и читалась вдавленной.
    background: Theme.picked(root.hue);
    border-width: 1px;
    border-color: Theme.edge(root.hue, ta.has-hover);
    opacity: root.enabled ? 1.0 : 0.5;
    animate border-color { duration: 160ms; easing: ease-out; }
    Text {
        text: root.title; color: root.hue; font-size: 16px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// ── Карточка и подписи ───────────────────────────────────────────────────────

/// Заголовок раздела. ГОДИТСЯ И В КОЛОНКЕ, И В СТРОКЕ.
///
/// В `HorizontalLayout` Slint раздаёт лишнее место всем детям поровну, когда ни
/// у кого нет `horizontal-stretch`, — коробка подписи растягивается, а текст
/// внутри неё прижимается к верхнему краю строки и разъезжается с соседями по
/// высоте. Из-за этого деталь обходили: рядом с «Лимитом гостей» те же три
/// строчки были переписаны руками, а на вкладке VPN каждому вызову приходилось
/// дописывать выравнивание. Чиним договор ДЕТАЛИ: выравнивание по центру она
/// несёт сама. В колонке это ничего не меняет — там высота ровно по строке.
export component SectionLabel inherits Text {
    color: Theme.dim;
    font-size: 13px;
    font-weight: 700;
    vertical-alignment: center;
}

// ── Поле ввода в стиле iOS ───────────────────────────────────────────────────
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> secure: false;
    callback edited;
    callback accepted;
    height: 48px;
    border-radius: 14px;
    background: Theme.card;
    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.fg;
        font-size: 15px;
        input-type: root.secure ? InputType.password : InputType.text;
        text <=> root.text;
        single-line: true;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
    if root.text == "": Text {
        x: 14px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 15px;
        vertical-alignment: center;
    }
}

// Толстый чип: значок сверху, название снизу (bigChip iOS).
export component BigChip inherits Rectangle {
    in property <string> name;
    in property <bool> on: false;
    callback clicked;
    height: 64px;
    border-radius: 14px;
    // Выбранный чип — общее правило приложения: своя ступень плюс подкраска
    // (Theme.picked). Сплошной градиент во всю плитку кричал сильнее самого
    // выбора: на вкладке «Хост» таких чипов подряд шесть, и экран из них
    // выходил в синих плашках.
    background: root.on ? Theme.picked(Theme.accent)
        : ta.has-hover ? Theme.touched(Theme.accent)
        : Theme.card;
    border-width: 1px;
    border-color: root.on ? Theme.edge(Theme.accent, ta.has-hover) : Theme.hairline;
    animate background, border-color { duration: 160ms; easing: ease-out; }
    VerticalLayout {
        alignment: center;
        spacing: 5px;
        HorizontalLayout { alignment: center; @children }
        Text {
            text: root.name;
            color: root.on ? Theme.accent : Theme.dim;
            font-size: 13px; font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ── Рабочее состояние: значок компактный, место отдано пользе ────────────────

/// Строка состояния для работающего режима: значок, название, часы справа.
///
/// Диск здесь вчетверо меньше геройского — тот же `StateDisc`, только с другим
/// `d`. Убирать значок в работе нельзя: он опознаёт экран с одного взгляда; а
/// держать 72px картинки там, где нужны код и цифры, — расточительство, потому
/// что панель висит на экране постоянно.
export component StatusLine inherits HorizontalLayout {
    in property <string> name;
    in property <string> clock;
    in property <color> tint: Theme.accent;
    spacing: 10px;
    StateDisc { d: 38px; tint: root.tint; @children }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.name; color: Theme.fg; font-size: 17px; font-weight: 800; overflow: elide; }
    }
    if root.clock != "": VerticalLayout {
        alignment: center;
        Text {
            text: root.clock; color: root.tint;
            font-size: 14px; font-weight: 700; font-family: "monospace";
        }
    }
}

/// Код сети крупно — то, ради чего открывают вкладку.
export component BigCode inherits Text {
    color: Theme.accent;
    font-size: 26px;
    font-weight: 800;
    font-family: "monospace";
    letter-spacing: 2px;
    horizontal-alignment: center;
}

/// Негромкая кнопка внутри панели. Для РЕДКИХ действий («Новый код»): тянуться
/// к верху экрана за ними приходится нечасто, поэтому им хватает строчки.
export component QuietButton inherits Rectangle {
    in property <string> title;
    in property <bool> feedback: false;
    property <bool> did: false;
    callback clicked;
    height: 34px;
    min-width: 0px;
    preferred-width: 0px;
    clip: true;
    border-radius: 10px;
    background: ta.has-hover ? #FFFFFF0A : transparent;
    border-width: 1px;
    border-color: root.did ? Theme.edge-done(Theme.accent) : Theme.hairline;
    animate border-color { duration: 180ms; easing: ease-out; }
    reset := Timer { interval: Theme.copied-ms; running: root.did; triggered() => { root.did = false; } }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.did ? "Готово" : root.title;
            color: root.did ? Theme.accent : Theme.dim;
            font-size: 12.5px; font-weight: 700; vertical-alignment: center;
            overflow: elide; min-width: 0px;
        }
    }
    ta := TouchArea { clicked => { if (root.feedback) { root.did = true; } root.clicked(); } }
}

/// Кнопка «поделиться» — крупная (48px), стоит В НИЗУ панели состояния.
///
/// Код сети и QR — то, ради чего эту панель открывают, поэтому они живут прямо
/// под кодом, а не в отдельной полке у нав-бара: там они оторвались бы от того,
/// что копируют.
export component ShareButton inherits Rectangle {
    in property <string> title;
    in property <bool> feedback: false;
    property <bool> did: false;
    callback clicked;
    height: 48px;
    min-width: 0px;
    preferred-width: 0px;
    clip: true;
    border-radius: 15px;
    // Ступень s3 — ТА ЖЕ, ЧТО У ПЛИТОК РЯДОМ. Кнопка живёт ТОЛЬКО внутри
    // парящей панели, а панель светлее карточек списка: увести кнопку на s1
    // значило бы посадить её НИЖЕ собственной подложки — в одной панели плитки
    // были бы над фоном, а кнопки под ним. Правило приложения одно: кнопка на
    // поверхности — на ступень выше этой поверхности. Кнопки НА СТРАНИЦЕ
    // («вставить», «перейти», «Сканировать QR» на телефонах) по тому же правилу
    // стоят на s2 — все три на одной ступени.
    background: ta.has-hover ? Theme.tile.brighter(0.12) : Theme.tile;
    border-width: 1px;
    border-color: root.did ? Theme.edge-done(Theme.accent) : Theme.accent.with-alpha(0.24);
    animate border-color, background { duration: 160ms; easing: ease-out; }
    reset := Timer { interval: Theme.copied-ms; running: root.did; triggered() => { root.did = false; } }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.did ? "Скопировано" : root.title;
            color: Theme.accent;
            font-size: 14px; font-weight: 700; vertical-alignment: center;
            overflow: elide; min-width: 0px;
        }
    }
    ta := TouchArea { clicked => { if (root.feedback) { root.did = true; } root.clicked(); } }
}

/// Тихий знак состояния у заголовка раздела. Пришёл на смену оранжевой полосе
/// во всю ширину: та кричала сильнее, чем стоило сообщение, и вдобавок дышала,
/// перетягивая взгляд с самого списка. Приглушённый список уже говорит «данные
/// могут врать» — словам остаётся только назвать причину, тихо.
export component StateChip inherits HorizontalLayout {
    in property <string> text;
    in property <color> tint: Theme.amber;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tint; }
    }
    Text { text: root.text; color: root.tint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
}
