// Переиспользуемые блоки — построчный перенос iOS ContentView.swift:
// плитки (Stat/Copy/Action), кнопки, карточка, герой-круг с пульсом, поле ввода.
import { Theme } from "theme.slint";
import { IconCopy, IconCheck, IconRefresh, IconAntennaOff } from "icons.slint";

// Модель карточки хоста (заполняет Rust).
export struct HostRow {
    id: string,
    name: string,
    flag-img: image,
    has-flag: bool,
    subtitle: string,
    locked: bool,
    usable: bool,
    fill: float,         // заполненность 0..1 (полоса под подписью)
    code: string,
    ip: string,
    country: string,
    guests: string,
    access: string,
    proto: string,       // имя протокола
    proto-id: string,    // сырой id протокола (для значка)
    // Задержка до хоста: «24 мс», «—» (не отвечает) или «…» (меряем).
    // Меряется по РАСКРЫТИЮ карточки, а не для всего списка сразу: проба —
    // это сетевой запрос, и делать их пачкой ради строк, на которые никто не
    // смотрит, значит зря дёргать чужие машины.
    ping: string,
    /// Задержка в мс для ЦВЕТА: -1 — неизвестна/нет ответа. Отдельным числом,
    /// а не разбором строки «24 мс»: to-float об суффикс спотыкается, а цвет
    /// не должен зависеть от того, как мы решили подписать значение.
    ping-ms: int,
}

// ── Точка статуса (с пульсом) ────────────────────────────────────────────────
export component Dot inherits Rectangle {
    in property <color> fill: Theme.green;
    in property <bool> pulse: false;
    property <float> t: Math.mod(animation-tick() / 1ms, 2000) / 2000;
    width: 11px;
    height: 11px;
    border-radius: 5.5px;
    background: root.fill;
    opacity: pulse ? (t < 0.5 ? 1 - 1.3 * t : 0.35 + 1.3 * (t - 0.5)) : 1.0;
}

// ── Герой-круг: заливка/кольцо в цвет статуса + расходящаяся волна ───────────
export component HeroCircle inherits Rectangle {
    in property <color> tint: Theme.accent;
    in property <bool> pulsing: false;
    in property <bool> glow: false;
    property <float> t: Math.mod(animation-tick() / 1ms, 1200) / 1200;
    height: 88px;
    // Волна расходится, пока идёт процесс (проверка/пробитие).
    if pulsing: Rectangle {
        property <length> d: 84px * (1 + 0.28 * root.t);
        x: (parent.width - self.d) / 2;
        y: (88px - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        border-width: 2px;
        border-color: root.tint.with-alpha(0.5 * (1 - root.t));
    }
    // Свечение (тень iOS) — мягкий ореол позади круга.
    if glow: Rectangle {
        x: (parent.width - 108px) / 2;
        y: -10px;
        width: 108px;
        height: 108px;
        border-radius: 54px;
        background: @radial-gradient(circle, root.tint.with-alpha(0.22) 0%, transparent 70%);
    }
    Rectangle {
        x: (parent.width - 84px) / 2;
        y: 2px;
        width: 84px;
        height: 84px;
        border-radius: 42px;
        background: root.tint.with-alpha(0.13);
        border-width: 1px;
        border-color: root.tint.with-alpha(0.3);
    }
    // Значок кладёт страница (@children поверх круга).
    @children
}

// ── Плитки ───────────────────────────────────────────────────────────────────

// Каркас плитки: подпись мелко сверху, значение снизу (TileBody на iOS).
component TileFrame inherits Rectangle {
    in property <color> stroke: #FFFFFF12;
    // Равные колонки: и min-, и preferred-width = 0 → ширину задаёт ТОЛЬКО stretch
    // (иначе Slint сперва даёт каждой плитке preferred по её содержимому, и длинный
    // код перетягивает место у IP). clip — чтобы длинное значение не вылезало.
    min-width: 0px;
    preferred-width: 0px;
    clip: true;
    height: 52px;
    border-radius: 12px;
    background: Theme.tile;
    border-width: 1px;
    border-color: root.stroke;
    animate border-color { duration: 180ms; easing: ease-out; }
}

/// Подпись плитки — мелкая, ЗАГЛАВНЫМИ. Один компонент на все три плитки:
/// раньше эти три строки были скопированы в StatTile, CopyTile и ActionTile, и
/// починка надстрочных знаков (ниже) в одной из копий тихо разошлась бы с
/// остальными.
///
/// ЗАЧЕМ ЯВНАЯ ВЫСОТА И ВЫРАВНИВАНИЕ ВНИЗ.
///
/// Slint (femtovg) обрезает текст по прямоугольнику САМОГО элемента Text, а
/// неявная высота этого прямоугольника кончается на линии ЗАГЛАВНЫХ букв
/// (cap-height). Всё, что торчит выше, срезается начисто — а у русских
/// ЗАГЛАВНЫХ «Й» и «Ё» надстрочный знак стоит именно выше cap-height. Поэтому
/// «ГОСТЕЙ» рисовалось как «ГОСТЕИ»: не бледно, а вообще без серпика. Строчные
/// «й» и «ё» не страдают — их знак ниже линии заглавных, он внутри коробки.
///
/// Лечится ТОЛЬКО запасом высоты у самого Text, причём запас должен лечь СВЕРХУ:
/// проверено опытом — ни высота с выравниванием по умолчанию (запас уходит
/// вниз), ни выравнивание без запаса, ни высокий родитель не помогают, помогает
/// пара «высота + выравнивание вниз». 14px при кегле 10px даёт 2px сверху —
/// этого хватает с запасом (знак цел уже при 13px).
component TileLabel inherits Text {
    color: Theme.dim;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.7px;
    height: 14px;
    vertical-alignment: bottom;
}

// Плитка-факт. Значок — ПОСЛЕ значения (как копи-значок у CopyTile), значение
// всегда прижато влево → все плитки в сетке выровнены одинаково.
export component StatTile inherits TileFrame {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.fg;
    VerticalLayout {
        // ПАРА ЦЕНТРИРУЕТСЯ ПО ВЫСОТЕ. Раньше стояли фиксированные отступы
        // 9px сверху и снизу, а сумма строк с их межстрочными интервалами
        // перекрывала 52px — значение выдавливало к нижнему краю, и казалось,
        // что оно проваливается из ячейки.
        alignment: center;
        padding-left: 11px; padding-right: 11px; padding-top: 8px; padding-bottom: 8px;
        spacing: 3px;
        TileLabel { text: root.label; }
        // Значение и значок — ПО ЦЕНТРУ ячейки. Раньше текст растягивался
        // (horizontal-stretch), прижимая значок к правому краю, и в соседних
        // плитках значки оказывались по разные стороны — взгляд цеплялся за
        // разнобой. Заголовок остаётся слева: он подпись к ячейке, а не содержимое.
        HorizontalLayout {
            spacing: 5px;
            alignment: center;
            Text {
                text: root.value; color: root.tint; font-size: 13.5px; font-weight: 600;
                overflow: elide; min-width: 0px; vertical-alignment: center;
            }
            VerticalLayout { alignment: center; @children }
        }
    }
}

/// Плитка отклика до хоста.
///
///   • идёт первый замер — КРУГОВАЯ СТРЕЛКА ВРАЩАЕТСЯ: движение честно говорит
///     «сейчас меряю», в отличие от многоточия, которое просто стоит и молчит;
///   • ответа нет — перечёркнутая антенна: у «нет отклика» отдельный знак, а не
///     прочерк, который легко принять за «данных нет»;
///   • число есть — просто цифра, без анимации.
export component PingTile inherits StatTile {
    in property <string> ping;
    property <bool> waiting: root.ping == "…" || root.ping == "";
    property <bool> no-answer: root.ping == "—";
    property <bool> dim: false;

    in property <int> ms: -1;
    // ОДНА ЛИНЕЙКА НА ОБА ПИНГА (здесь и на вкладке «Сервер»). Раньше их было
    // две, и меньшее число выходило тревожнее большего: 137 мс до хоста
    // краснело, 162 мс до координатора числилось «хорошо».
    //
    // ЗЕЛЁНОГО В ПИНГЕ НЕТ ВОВСЕ: в этом приложении зелёный значит «работает», а
    // не «быстро». Норма молчит — обычный цвет текста.
    property <color> ping-tint:
        root.ms < 0 ? Theme.fg
        : root.ms < 250 ? Theme.fg
        : root.ms <= 500 ? Theme.amber
        : Theme.red;

    label: "ПИНГ";
    // Без слова «нет»: перечёркнутая антенна говорит сама.
    value: (root.waiting || root.no-answer) ? "" : root.ping;
    tint: root.no-answer ? Theme.dim : root.ping-tint;

    // На мобилках эта стрелка ВРАЩАЕТСЯ. Здесь — пульсирует: значки у нас
    // векторные (Path), а Slint не умеет ни `rotation-angle` на них, ни
    // отдельного элемента поворота. Смысл сохранён — движение говорит «идёт
    // замер», — а изображать вращение подменой команд пути было бы трюком
    // ради трюка.
    if root.waiting: IconRefresh {
        width: 13px; height: 13px; tint: Theme.accent;
        opacity: root.dim ? 0.35 : 1.0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
        Timer {
            interval: 450ms;
            // Живёт только пока идёт замер: сам элемент существует лишь под
            // `if root.waiting`, так что лишних таймеров не остаётся.
            running: true;
            triggered => { root.dim = !root.dim; }
        }
    }
    if root.no-answer: IconAntennaOff { width: 13px; height: 13px; tint: Theme.dim; }

}

// Плитка со значением, которое копируется тапом (код, IP).
export component CopyTile inherits TileFrame {
    in property <string> label;
    in property <string> value;
    callback copy(string);
    property <bool> copied: false;
    stroke: copied ? Theme.green.with-alpha(0.5) : #FFFFFF12;
    reset := Timer {
        interval: 1.3s;
        running: root.copied;
        triggered() => { root.copied = false; }
    }
    VerticalLayout {
        alignment: center;   // см. StatTile: иначе значение проваливается вниз
        padding-left: 11px; padding-right: 11px; padding-top: 8px; padding-bottom: 8px;
        spacing: 3px;
        TileLabel { text: root.label; }
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.copied ? "Скопировано" : root.value;
                color: root.copied ? Theme.green : Theme.fg;
                font-size: 13.5px; font-weight: 600;
                overflow: elide; horizontal-stretch: 1; min-width: 0px; vertical-alignment: center;
            }
            if root.value != "" && root.value != "—": VerticalLayout {
                alignment: center;
                if !root.copied: IconCopy { width: 13px; height: 13px; tint: Theme.accent; }
                if root.copied: IconCheck { width: 13px; height: 13px; tint: Theme.green; }
            }
        }
    }
    ta := TouchArea {
        clicked => {
            if (root.value != "" && root.value != "—") {
                root.copy(root.value);
                root.copied = true;
            }
        }
    }
}

// Плитка-кнопка (перепроверить пинг).
export component ActionTile inherits TileFrame {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.fg;
    in property <bool> busy: false;
    callback action;
    VerticalLayout {
        padding-left: 11px; padding-right: 11px; padding-top: 9px; padding-bottom: 9px;
        spacing: 4px;
        TileLabel { text: root.label; }
        HorizontalLayout {
            spacing: 5px;
            Text {
                text: root.busy ? "проверяю…" : root.value;
                color: root.busy ? Theme.dim : root.tint;
                font-size: 13.5px; font-weight: 600;
                overflow: elide; horizontal-stretch: 1; vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                IconRefresh { width: 13px; height: 13px; tint: Theme.accent; opacity: root.busy ? 0.5 : 1.0; }
            }
        }
    }
    TouchArea { clicked => { root.action(); } }
}

/// ПАРЯЩИЙ БЛОК — панель состояния и нав-бар. Одна отделка на оба: два слоя над
/// страницей читаются как один язык, а не как две разные плашки.
///
/// ВЫСОТУ ДЕРЖАТ ТРИ НОСИТЕЛЯ, А НЕ ОДНА ТЕНЬ.
///
///  1. ЗАЛИВКА НЕПРОЗРАЧНАЯ. Прежние 0.97 не покупали ничего: размытия под
///     блоком нет ни на одной оболочке, зато сквозь панель на снимке читался
///     текст списка под ней.
///  2. КРОМКА СВЕТА 1px ТОЛЬКО СВЕРХУ. Это и есть физический верхний край
///     блока; по бокам и снизу остаётся тихая рамка (`stroke`).
///  3. ТЕНЬ КОРОТКАЯ. Дальняя 30-пиксельная убрана: на почти-чёрном фоне
///     (#0B0E14) она размывалась в грязь и не сообщала ничего. Сторона подъезда
///     — параметр: у панели (прижата сверху) тень ВНИЗ, у нав-бара (прижат
///     снизу) — ВВЕРХ. Раньше у бара тень уезжала под него, в полосу, на
///     которую никто не смотрит.
export component FloatCard inherits Rectangle {
    in property <length> radius: 22px;
    /// Рамка по бокам и снизу. У панели её место занимает кольцо состояния.
    in property <color> stroke: #FFFFFF0D;
    /// Блок прижат снизу (нав-бар) — тень уходит ВВЕРХ, к содержимому.
    in property <bool> lift-up: false;
    border-radius: root.radius;
    background: Theme.float-bg;
    border-width: 1px;
    border-color: root.stroke;
    drop-shadow-blur: 9px;
    drop-shadow-color: #000000E6;
    drop-shadow-offset-y: root.lift-up ? -5px : 5px;
    // Кромка света. Поджата на радиус с боков — иначе полоса торчала бы из
    // скруглённых углов.
    Rectangle {
        x: root.radius;
        y: 0px;
        width: root.width - 2 * root.radius;
        height: 1px;
        background: #FFFFFF24;
    }
    // ЗАВЕСА: содержимое, уходящее под блок, ГАСНЕТ, А НЕ СРЕЗАЕТСЯ.
    //
    // Раньше список обрывался о кромку панели ножом. Полоса в цвет страницы,
    // сходящая на нет от края блока наружу, превращает обрыв в уход.
    //
    // Живёт ВНУТРИ FloatCard намеренно: одна правка накрывает и панель
    // состояния (все три вкладки), и нав-бар. Рисуется ЗА пределами блока
    // (y отрицательный или больше высоты) — Slint не обрезает детей без
    // `clip`, а порядок объявления даёт нужную укладку: FloatCard объявлен
    // после прокрутки, значит завеса над списком, но сам блок над завесой.
    //
    // Кликов не перехватывает: в Slint ловит только TouchArea.
    //
    // На коротком списке невидима: это фон страницы, растворяющийся в фоне
    // страницы. Тенью посреди пустоты она стать не может по построению.
    Rectangle {
        x: 0px;
        y: root.lift-up ? -Theme.veil : root.height;
        width: root.width;
        height: Theme.veil;
        background: root.lift-up
            ? @linear-gradient(180deg, Theme.bg.with-alpha(0.0) 0%, Theme.bg 100%)
            : @linear-gradient(180deg, Theme.bg 0%, Theme.bg.with-alpha(0.0) 100%);
    }
    // ПОЛОСКА ЗА БЛОКОМ, СО СТОРОНЫ КРАЯ ЭКРАНА. Блок прижат к краю, но не
    // вплотную, и в этот просвет пролезали обрывки содержимого: из-под нав-бара
    // торчала половина строки «Раздача работает, пока…», над панелью —
    // заголовок «Подключиться по коду». Ничего полезного там нет и быть не
    // может: полоса высотой в палец, прижатая к краю. Гасить нечего — просто
    // фон, и градиент не нужен: снаружи полосу обрезает сам край окна.
    Rectangle {
        x: 0px;
        y: root.lift-up ? root.height : -60px;
        width: root.width;
        height: 60px;
        background: Theme.bg;
    }
    @children
}

// ── Кнопки ───────────────────────────────────────────────────────────────────

// Кнопка в карточке: значок + подпись на приподнятой плитке (CardButton iOS).
export component CardButton inherits Rectangle {
    in property <string> title;
    in property <bool> copied: false;    // внешнее «Скопировано ✓» (управляет страница)
    in property <bool> feedback: false;  // сам показать «Скопировано» после клика (копи-кнопки)
    property <bool> did: false;
    property <bool> show: root.copied || root.did;
    callback clicked;
    height: 44px;
    min-width: 0px;         // в ряду «Код | QR» кнопки строго 50/50 —
    preferred-width: 0px;   // ширину задаёт stretch, а не длина «Скопировано»
    clip: true;
    border-radius: 12px;
    background: ta.has-hover ? Theme.tile.brighter(0.12) : Theme.tile;
    border-width: 1px;
    border-color: root.show ? Theme.green.with-alpha(0.5) : #FFFFFF14;
    animate border-color { duration: 180ms; easing: ease-out; }
    reset := Timer { interval: 1.3s; running: root.did; triggered() => { root.did = false; } }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.show ? "Скопировано" : root.title;
            color: root.show ? Theme.green : Theme.fg;
            font-size: 14px; font-weight: 700; overflow: elide; min-width: 0px; vertical-alignment: center;
        }
    }
    ta := TouchArea { clicked => { if (root.feedback) { root.did = true; } root.clicked(); } }
}

/// Главная кнопка страницы. СПОКОЙНАЯ: подкраска ~15% + рамка ~40% + цветной
/// текст — тот же приём, что у ShareButton, у действующей ячейки нав-бара и у
/// «Подключить» в карточке хоста.
///
/// Был сплошной градиент во всю ширину. Он кричал громче всего на экране и
/// перетягивал внимание с того, ради чего на экран смотрят: на вкладке
/// «Сервер» синяя плашка «Сохранить и проверить» была заметнее и адреса, и
/// состояния связи. Один стиль на все кнопки — ещё и способ не выбирать
/// каждый раз заново, что здесь «главнее».
export component CalmButton inherits Rectangle {
    in property <string> title;
    in property <bool> enabled: true;
    in property <length> corner: 14px;
    in property <color> hue: Theme.accent;
    callback clicked;
    height: 50px;
    border-radius: root.corner;
    background: ta.has-hover ? root.hue.with-alpha(0.22) : root.hue.with-alpha(0.15);
    border-width: 1px;
    border-color: root.hue.with-alpha(0.4);
    opacity: root.enabled ? 1.0 : 0.5;
    animate background { duration: 160ms; easing: ease-out; }
    Text {
        text: root.title; color: root.hue; font-size: 16px; font-weight: 700;
        horizontal-alignment: center; vertical-alignment: center;
        width: 100%; height: 100%;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// ── Карточка и подписи ───────────────────────────────────────────────────────

export component Card inherits Rectangle {
    border-radius: 16px;
    background: Theme.card;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        @children
    }
}

export component SectionLabel inherits Text {
    color: Theme.dim;
    font-size: 13px;
    font-weight: 700;
}

// ── Поле ввода в стиле iOS ───────────────────────────────────────────────────
export component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <bool> secure: false;
    callback edited;
    callback accepted;
    height: 48px;
    border-radius: 14px;
    background: Theme.card;
    input := TextInput {
        x: 14px;
        width: parent.width - 28px;
        height: parent.height;
        vertical-alignment: center;
        color: Theme.fg;
        font-size: 15px;
        input-type: root.secure ? InputType.password : InputType.text;
        text <=> root.text;
        single-line: true;
        edited => { root.edited(); }
        accepted => { root.accepted(); }
    }
    if root.text == "": Text {
        x: 14px;
        height: parent.height;
        text: root.placeholder;
        color: Theme.dim;
        font-size: 15px;
        vertical-alignment: center;
    }
}

// Толстый чип: значок сверху, название снизу (bigChip iOS).
export component BigChip inherits Rectangle {
    in property <string> name;
    in property <bool> on: false;
    callback clicked;
    height: 64px;
    border-radius: 14px;
    // Выбранный чип — тот же спокойный приём, что и у кнопок: подкраска +
    // рамка + цветной текст. Сплошной градиент во всю плитку кричал сильнее
    // самого выбора: на вкладке «Хост» таких чипов подряд шесть, и экран из
    // них выходил в синих плашках.
    background: root.on
        ? (ta.has-hover ? Theme.accent.with-alpha(0.22) : Theme.accent.with-alpha(0.15))
        : (ta.has-hover ? Theme.card.brighter(0.15) : Theme.card);
    border-width: 1px;
    border-color: root.on ? Theme.accent.with-alpha(0.4) : #FFFFFF12;
    animate background, border-color { duration: 160ms; easing: ease-out; }
    VerticalLayout {
        alignment: center;
        spacing: 5px;
        HorizontalLayout { alignment: center; @children }
        Text {
            text: root.name;
            color: root.on ? Theme.accent : Theme.dim;
            font-size: 13px; font-weight: 700;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// ── Рабочее состояние: значок компактный, место отдано пользе ────────────────

/// Кружок со значком — тот же опознавательный знак, что и в герой-круге, но
/// вчетверо меньше. Убирать значок в работе нельзя: он опознаёт экран с одного
/// взгляда; а держать 74px картинки там, где нужны код и цифры, — расточительство,
/// потому что панель висит на экране постоянно.
export component Badge inherits Rectangle {
    in property <color> tint: Theme.accent;
    width: 38px;
    height: 38px;
    border-radius: 19px;
    background: root.tint.with-alpha(0.13);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.3);
    HorizontalLayout {
        alignment: center;
        VerticalLayout { alignment: center; @children }
    }
}

/// Строка состояния для работающего режима: значок, название, часы справа.
export component StatusLine inherits HorizontalLayout {
    in property <string> name;
    in property <string> clock;
    in property <color> tint: Theme.accent;
    spacing: 10px;
    Badge { tint: root.tint; @children }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Text { text: root.name; color: Theme.fg; font-size: 17px; font-weight: 800; overflow: elide; }
    }
    if root.clock != "": VerticalLayout {
        alignment: center;
        Text {
            text: root.clock; color: root.tint;
            font-size: 14px; font-weight: 700; font-family: "monospace";
        }
    }
}

/// Код сети крупно — то, ради чего открывают вкладку.
export component BigCode inherits Text {
    color: Theme.accent;
    font-size: 26px;
    font-weight: 800;
    font-family: "monospace";
    letter-spacing: 2px;
    horizontal-alignment: center;
}

/// Негромкая кнопка внутри панели. Для РЕДКИХ действий («Новый код»): тянуться
/// к верху экрана за ними приходится нечасто, поэтому им хватает строчки.
export component QuietButton inherits Rectangle {
    in property <string> title;
    in property <bool> feedback: false;
    property <bool> did: false;
    callback clicked;
    height: 34px;
    min-width: 0px;
    preferred-width: 0px;
    clip: true;
    border-radius: 10px;
    background: ta.has-hover ? #FFFFFF0A : transparent;
    border-width: 1px;
    border-color: root.did ? Theme.green.with-alpha(0.5) : #FFFFFF14;
    animate border-color { duration: 180ms; easing: ease-out; }
    reset := Timer { interval: 1.3s; running: root.did; triggered() => { root.did = false; } }
    HorizontalLayout {
        alignment: center;
        spacing: 6px;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.did ? "Готово" : root.title;
            color: root.did ? Theme.green : Theme.dim;
            font-size: 12.5px; font-weight: 700; vertical-alignment: center;
            overflow: elide; min-width: 0px;
        }
    }
    ta := TouchArea { clicked => { if (root.feedback) { root.did = true; } root.clicked(); } }
}

/// Кнопка «поделиться» — крупная (48px), стоит В НИЗУ панели состояния.
///
/// Код сети и QR — то, ради чего эту панель открывают, поэтому они живут прямо
/// под кодом, а не в отдельной полке у нав-бара: там они оторвались бы от того,
/// что копируют.
export component ShareButton inherits Rectangle {
    in property <string> title;
    in property <bool> feedback: false;
    property <bool> did: false;
    callback clicked;
    height: 48px;
    min-width: 0px;
    preferred-width: 0px;
    clip: true;
    border-radius: 15px;
    // Ступень s3 — ТА ЖЕ, ЧТО У ПЛИТОК РЯДОМ. Кнопка живёт ТОЛЬКО внутри
    // парящей панели, а панель светлее карточек списка: увести кнопку на s1
    // значило бы посадить её НИЖЕ собственной подложки — в одной панели плитки
    // были бы над фоном, а кнопки под ним. Правило приложения одно: кнопка на
    // поверхности — на ступень выше этой поверхности (так же покрашены
    // CardButton и «Сканировать QR» на карточке).
    background: ta.has-hover ? Theme.tile.brighter(0.12) : Theme.tile;
    border-width: 1px;
    border-color: root.did ? Theme.green.with-alpha(0.5) : Theme.accent.with-alpha(0.24);
    animate border-color, background { duration: 160ms; easing: ease-out; }
    reset := Timer { interval: 1.3s; running: root.did; triggered() => { root.did = false; } }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        VerticalLayout { alignment: center; @children }
        Text {
            text: root.did ? "Скопировано" : root.title;
            color: root.did ? Theme.green : Theme.accent;
            font-size: 14px; font-weight: 700; vertical-alignment: center;
            overflow: elide; min-width: 0px;
        }
    }
    ta := TouchArea { clicked => { if (root.feedback) { root.did = true; } root.clicked(); } }
}

/// Тихий знак состояния у заголовка раздела. Пришёл на смену оранжевой полосе
/// во всю ширину: та кричала сильнее, чем стоило сообщение, и вдобавок дышала,
/// перетягивая взгляд с самого списка. Приглушённый список уже говорит «данные
/// могут врать» — словам остаётся только назвать причину, тихо.
export component StateChip inherits HorizontalLayout {
    in property <string> text;
    in property <color> tint: Theme.amber;
    spacing: 5px;
    VerticalLayout {
        alignment: center;
        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.tint; }
    }
    Text { text: root.text; color: root.tint; font-size: 11px; font-weight: 700; vertical-alignment: center; }
}
