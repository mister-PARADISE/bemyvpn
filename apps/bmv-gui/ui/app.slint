// Главное окно BeMyVPN-desktop — построчная копия iOS ContentView: тёмный фон,
// активная страница, ПЛАВАЮЩИЙ нав-бар поверх снизу (Сервер | VPN | Хост) с умной
// центральной ячейкой (Старт/Стоп). Всё состояние — входные свойства, действия —
// колбэки; заполняет их Rust (main.rs).
import { Theme } from "theme.slint";
import { HostRow, CalmButton, FloatCard, FloatHalo } from "components.slint";
import { IconServer, IconRouter, IconShield, IconBolt, IconX, IconQr, IconRenew, IconPower } from "icons.slint";
import { VpnPage } from "vpn_page.slint";
import { HostPage } from "host_page.slint";
import { ServerPage } from "server_page.slint";

// Ячейка нав-бара: значок + подпись.
//
// ПРАВИЛО БАРА: ячейка ведёт на свою вкладку, а когда ты УЖЕ на ней —
// становится включателем этой вкладки. Так центр работал и раньше («VPN» →
// «Старт»/«Стоп»), теперь то же самое умеет «Хост». Тупика с возвратом при
// этом не возникает: с любой вкладки видно, куда уйти.
//
// Подсветка спокойная — подкраска и рамка. Раньше действующая ячейка была
// залита градиентом во всю яркость и перетягивала на себя весь экран.
//
// РОВНО ПО ТРЕТИ ШИРИНЫ, что бы в ячейке ни было написано. Для этого нужны ОБА
// нуля — и min-width, и preferred-width. С одним лишь min-width Slint сперва
// раздаёт каждой ячейке место по её содержимому и только остаток делит поровну:
// подпись меняется («Хост» → «Раздать», «VPN» → «Старт»), меняется и дележ —
// границы ячеек скачут при каждом переключении вкладки. Ровно так же до этого
// разъезжались плитки в карточке хоста.
component NavCell inherits Rectangle {
    in property <string> label;
    /// Ячейка сейчас работает включателем (мы на её вкладке).
    in property <bool> acting: false;
    /// Мы на этой вкладке, но действия у неё нет (вкладка «Сервер»).
    in property <bool> current: false;
    in property <color> tint: Theme.dim;
    /// Цвет состояния: зелёный «включить», красный «выключить».
    in property <color> hue: Theme.accent;
    /// Точка «работает» — только на ячейках, ведущих на ДРУГУЮ вкладку: на своей
    /// состояние и так написано словом на кнопке.
    in property <bool> live: false;
    in property <color> live-tint: Theme.green;
    callback clicked;
    min-width: 0px;
    preferred-width: 0px;
    Rectangle {
        x: 2px; y: 3px;
        width: parent.width - 4px; height: parent.height - 6px;
        border-radius: 22px;
        background: root.acting ? root.hue.with-alpha(0.14)
                  : root.current ? Theme.accent.with-alpha(0.16)
                  : transparent;
        border-width: root.acting ? 1px : 0px;
        border-color: root.hue.with-alpha(0.37);
        animate background { duration: 160ms; easing: ease-in-out; }
    }
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout { alignment: center; VerticalLayout { alignment: center; height: 22px; @children } }
        Text {
            text: root.label; font-size: 11px; font-weight: 700;
            horizontal-alignment: center; color: root.tint; overflow: elide;
        }
    }
    if root.live: Rectangle {
        x: parent.width / 2 + 12px;
        y: 11px;
        width: 7px; height: 7px;
        border-radius: 3.5px;
        background: root.live-tint;
        border-width: 2px;
        border-color: Theme.float-bg;
    }
    TouchArea { clicked => { root.clicked(); } }
}

export { HostRow }

export component AppWindow inherits Window {
    title: "BeMyVPN";
    default-font-size: 14px;
    background: Theme.bg;
    // СТАРТОВЫЙ РАЗМЕР ЗАДАЁТ RUST (см. window_size): ширина всегда проектная,
    // 400 точек, высота — от высоты ЭКРАНА, с запасом на системные панели.
    in property <length> win-w: 400px;
    in property <length> win-h: 820px;
    // Можно ли тянуть окно мышью. Только Windows: там окно живёт среди
    // изменяемых окон, и намертво прибитый размер читается как поломка.
    // На macOS и Linux окно остаётся фиксированным — макет свёрстан под одну
    // ширину, и растягивание его разгоняет.
    in property <bool> resizable: false;
    preferred-width: root.win-w;
    preferred-height: root.win-h;
    // Минимум, ниже которого макет разваливается: список хостов вырождается в
    // щель, а плитки в карточке налезают друг на друга.
    min-width: root.resizable ? 360px : root.win-w;
    min-height: root.resizable ? 420px : root.win-h;
    // Потолка у растягивания нет. Отдельного «бесконечно» в Slint не завезли,
    // поэтому заведомо недостижимая величина.
    max-width: root.resizable ? 100000px : root.win-w;
    max-height: root.resizable ? 100000px : root.win-h;

    // ── интерфейс для Rust (VPN) ──
    in property <[HostRow]> hosts;
    in property <[string]> recent-names;
    in property <[string]> recent-ids;
    in property <int> vpn-state;
    in property <string> vpn-status: "VPN выключен";
    in property <string> vpn-host-id;
    in property <string> vpn-sub;
    in property <string> vpn-ip;
    in property <string> vpn-country;
    in property <string> vpn-guests;
    in property <string> vpn-proto;
    in property <string> vpn-proto-id;
    in property <string> vpn-elapsed;
    in property <image> vpn-qr-img;
    // ── хост ──
    in property <int> host-state;
    in property <string> host-status;
    in property <string> host-code;
    in property <string> host-error;
    in property <string> host-ip;
    in property <string> host-guests;
    in property <string> host-elapsed;
    in-out property <string> host-name;
    in-out property <bool> host-public: true;
    in-out property <int> host-max: 8;
    in-out property <string> host-password;
    in-out property <string> host-protocol: "noise";
    in property <image> host-qr-img;
    // ── сервер ──
    in property <string> coord-url;
    in property <int> coord-state;
    in property <string> update-version;
    in property <string> update-tag;
    in property <int> update-state;
    in property <string> update-error;
    in property <int> coord-ping;
    in property <int> coord-hosts;
    in property <string> coord-ip;
    in property <bool> coord-is-default: true;
    in property <string> config-error;
    in property <[string]> server-history;
    // ── навигация/ввод ──
    in-out property <int> tab: 0;            // 0 VPN · 1 Хост · 2 Сервер
    in-out property <string> code;
    in-out property <string> guest-password;
    in-out property <string> coord-field;
    // QR-оверлей: "" скрыт, иначе код для показа.
    in-out property <string> qr-overlay: "";
    in property <image> qr-overlay-img;

    callback connect(string);
    // Карточку хоста раскрыли — Rust замерит отклик до него.
    callback expanded-host(string);
    callback connect-code();
    callback quick-connect();
    callback disconnect();
    callback toggle-host();
    callback set-coord(string);
    callback reset-coord();
    callback paste();
    callback copy-code();
    callback copy-text(string);
    callback new-code();
    callback apply-host();
    callback show-qr(string);
    callback do-update();   // Rust рисует qr-overlay-img и открывает оверлей

    // «Пульс» цикла: idle winit-loop на macOS не сливает invoke_from_event_loop,
    // пока не придёт событие ввода — фоновые обновления статуса (подключение из
    // root-хелпера, живой каталог) зависали в очереди. Пустой таймер будит цикл
    // 4×/сек → отложенные апдейты применяются вовремя. Копейки CPU.
    Timer {
        interval: 250ms;
        running: true;
        triggered => {}
    }

    VerticalLayout {
        // ── область страницы (во всю высоту; нав-бар плавает поверх) ──
        Rectangle {
            vertical-stretch: 1;
            if tab == 0: VpnPage {
                hosts: root.hosts;
                recent-names: root.recent-names;
                recent-ids: root.recent-ids;
                vpn-state: root.vpn-state;
                vpn-status: root.vpn-status;
                coord-state: root.coord-state;
                update-version: root.update-version;
                update-state: root.update-state;
                update-error: root.update-error;
                do-update() => { root.do-update(); }
                vpn-host-id: root.vpn-host-id;
                vpn-sub: root.vpn-sub;
                vpn-ip: root.vpn-ip;
                vpn-country: root.vpn-country;
                vpn-guests: root.vpn-guests;
                vpn-proto: root.vpn-proto;
                vpn-proto-id: root.vpn-proto-id;
                vpn-elapsed: root.vpn-elapsed;
                host-count: root.hosts.length;
                code <=> root.code;
                guest-password <=> root.guest-password;
                connect(id) => { root.connect(id); }
                expanded-host(id) => { root.expanded-host(id); }
                connect-code() => { root.connect-code(); }
                disconnect() => { root.disconnect(); }
                paste() => { root.paste(); }
                copy-text(t) => { root.copy-text(t); }
                show-qr(c) => { root.show-qr(c); }
            }
            if tab == 1: HostPage {
                host-state: root.host-state;
                host-status: root.host-status;
                host-code: root.host-code;
                host-error: root.host-error;
                host-ip: root.host-ip;
                host-guests: root.host-guests;
                host-elapsed: root.host-elapsed;
                host-name <=> root.host-name;
                host-public <=> root.host-public;
                host-max <=> root.host-max;
                host-password <=> root.host-password;
                host-protocol <=> root.host-protocol;
                toggle() => { root.toggle-host(); }
                copy-code() => { root.copy-code(); }
                copy-text(t) => { root.copy-text(t); }
                new-code() => { root.new-code(); }
                apply-host() => { root.apply-host(); }
                open-qr() => { root.show-qr(root.host-code); }
            }
            if tab == 2: ServerPage {
                coord-url: root.coord-url;
                coord-state: root.coord-state;
                vpn-state: root.vpn-state;
                coord-ping: root.coord-ping;
                coord-hosts: root.coord-hosts;
                coord-ip: root.coord-ip;
                coord-is-default: root.coord-is-default;
                config-error: root.config-error;
                history: root.server-history;
                coord-field <=> root.coord-field;
                set-coord(t) => { root.set-coord(t); }
                reset-coord() => { root.reset-coord(); }
                copy-text(t) => { root.copy-text(t); }
            }
        }
    }

    // ── Плавающий нав-бар (поверх страницы, как ZStack .bottom на iOS) ──
    //
    // ВТОРОЙ ПАРЯЩИЙ СЛОЙ, отделка та же, что у панели состояния: общий
    // FloatCard — один фон, одна тень. Свой цвет, подобранный на глаз, разошёлся
    // бы с панелью при первой же правке темы.
    //
    // Приподнят над нижним краем на 30px (было 22): бар и так парит, а лишние
    // несколько точек воздуха под ним читаются как «лежит поверх», а не
    // «приклеен к краю». Нижний отступ прокрутки на страницах подрос на ту же
    // величину (120px), иначе последняя карточка списка пряталась бы под баром.
    // Ореол бара — ОТДЕЛЬНЫМ СОСЕДОМ ПЕРЕД ним, иначе он лёг бы поверх заливки:
    // в Slint дети рисуются над фоном родителя, а `z` нет вовсе.
    FloatHalo {
        radius: 28px;
        lift-up: true;
        x: bar.x; y: bar.y; width: bar.width; height: bar.height;
    }
    bar := FloatCard {
        radius: 28px;
        // Бар прижат снизу — тень уходит ВВЕРХ, к содержимому. Вниз она уезжала
        // под сам бар, в полосу, на которую никто не смотрит.
        lift-up: true;
        x: 18px;
        y: parent.height - self.height - 30px;
        width: parent.width - 36px;
        height: 66px;
        HorizontalLayout {
            padding: 6px;
            spacing: 4px;
            // «Сервер» — навигация всегда: у вкладки нет своего включателя.
            // Зато на ней горит состояние связи, видное С ЛЮБОЙ вкладки:
            // красная точка «нет связи», жёлтая «проверяю». Когда всё
            // хорошо — точки нет: молчание и есть «ок». Раньше об обрыве
            // кричала оранжевая полоса на вкладке VPN.
            NavCell {
                horizontal-stretch: 1;
                label: "Сервер";
                current: tab == 2;
                tint: tab == 2 ? Theme.accent : Theme.dim;
                live: coord-state != 1;
                // Обрыв — янтарь, как и «проверяю»: он чинится сам за секунды.
                live-tint: Theme.amber;
                clicked => { tab = 2; }
                IconServer { width: 21px; height: 21px; tint: tab == 2 ? Theme.accent : Theme.dim; }
            }
            // Центр: переход на VPN, а на самой вкладке — Старт/Стоп.
            NavCell {
                horizontal-stretch: 1;
                label: tab != 0 ? "VPN"
                     : (vpn-state == 0 ? "Старт" : vpn-state == 1 ? "Отмена" : vpn-state == 3 ? "Ещё раз" : "Стоп");
                acting: tab == 0;
                // ЗАПУСК — АКЦЕНТ, А НЕ ЗЕЛЁНЫЙ. Зелёный горел ровно тогда,
                // когда человек НЕ защищён; для приложения, у которого главный
                // вопрос «я сейчас под защитой?», это обман глазом. Кнопка —
                // действие, а не состояние. Зелёный освободился под состояние:
                // поднятый туннель, идущая раздача, живая связь с сервером.
                // «Стоп» остаётся красным: на кнопке выхода красный понятен без
                // обучения и читается как «прервать», а не как «беда».
                hue: (vpn-state == 0 || vpn-state == 3) ? Theme.accent : Theme.red;
                tint: tab != 0 ? Theme.dim
                    : ((vpn-state == 0 || vpn-state == 3) ? Theme.accent : Theme.red);
                live: tab != 0 && vpn-state != 0;
                live-tint: vpn-state == 2 ? Theme.green : vpn-state == 3 ? Theme.red : Theme.amber;
                clicked => {
                    if (tab != 0) { tab = 0; }
                    else if (vpn-state == 0 || vpn-state == 3) { root.quick-connect(); }
                    else { root.disconnect(); }
                }
                if tab != 0: IconShield { width: 21px; height: 21px; tint: Theme.dim; }
                if tab == 0 && vpn-state == 0: IconBolt { width: 21px; height: 21px; tint: Theme.accent; }
                if tab == 0 && vpn-state == 3: IconRenew { width: 21px; height: 21px; tint: Theme.accent; }
                if tab == 0 && (vpn-state == 1 || vpn-state == 2): IconX { width: 21px; height: 21px; tint: Theme.red; }
            }
            // «Хост» — по тому же правилу, что и центр.
            NavCell {
                horizontal-stretch: 1;
                label: tab != 1 ? "Хост"
                     : (host-state == 0 ? "Раздать" : host-state == 1 ? "Отмена" : host-state == 3 ? "Ещё раз" : "Стоп");
                acting: tab == 1;
                // «Раздать» — акцент по тому же правилу, что и «Старт».
                hue: (host-state == 0 || host-state == 3) ? Theme.accent : Theme.red;
                tint: tab != 1 ? Theme.dim
                    : ((host-state == 0 || host-state == 3) ? Theme.accent : Theme.red);
                live: tab != 1 && host-state != 0;
                live-tint: host-state == 2 ? Theme.green : host-state == 3 ? Theme.red : Theme.amber;
                clicked => {
                    if (tab != 1) { tab = 1; }
                    else { root.toggle-host(); }
                }
                if tab != 1: IconRouter { width: 21px; height: 21px; tint: Theme.dim; }
                if tab == 1 && host-state == 0: IconPower { width: 21px; height: 21px; tint: Theme.accent; }
                if tab == 1 && host-state == 3: IconRenew { width: 21px; height: 21px; tint: Theme.accent; }
                if tab == 1 && (host-state == 1 || host-state == 2): IconX { width: 21px; height: 21px; tint: Theme.red; }
            }
        }
    }

    // ── QR-оверлей приглашения (полноэкранный, как iOS QRSheet) ──
    if root.qr-overlay != "": Rectangle {
        background: Theme.bg.with-alpha(0.97);
        TouchArea {}   // перехват кликов под оверлеем
        VerticalLayout {
            alignment: center;
            spacing: 22px;
            padding: 40px;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 264px; height: 264px;
                    border-radius: 18px;
                    background: white;
                    Image { source: root.qr-overlay-img; width: 244px; height: 244px; }
                }
            }
            Text {
                text: root.qr-overlay; color: Theme.accent;
                font-size: 26px; font-weight: 800; font-family: "monospace"; letter-spacing: 2px;
                horizontal-alignment: center;
            }
            Text { text: "Отсканируйте, чтобы подключиться к этой сети"; color: Theme.dim; font-size: 13px; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                // Та же спокойная кнопка, что и везде. Сплошной градиент здесь
                // был единственным ярким пятном на почти пустом экране и
                // перетягивал взгляд с самого QR-кода, ради которого экран и
                // открыли.
                CalmButton {
                    width: 220px;
                    title: "Закрыть";
                    clicked => { root.qr-overlay = ""; }
                }
            }
        }
    }
}
