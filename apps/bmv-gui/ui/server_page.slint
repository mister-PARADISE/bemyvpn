// Вкладка «Сервер» — координатор. Трафик через него НЕ идёт.
//
// Как и остальные вкладки: панель состояния ПАРИТ поверх прокрутки, настройки
// проходят под ней. Панель адаптивная — когда связь есть, круг уступает место цифрам
// (пинг, хостов, свой адрес), потому что смотреть на большой значок «всё
// хорошо» смысла нет.
//
// Адрес показывается доменом, без «https://»: схема у нас всегда одна, и шесть
// символов перед каждым адресом ничего не сообщают.
import { Theme } from "theme.slint";
import { StatTile, CopyTile, SectionLabel, CalmButton, Field, Badge, StatusLine, FloatCard } from "components.slint";
import { IconAntenna, IconAntennaOff } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

export component ServerPage inherits Rectangle {
    in property <string> coord-url;     // уже без схемы (Rust её срезает)
    in property <int> coord-state;      // 0 проверяю · 1 на связи · 2 нет связи
    // Нужен ровно для одного: подписать, что пинг снят ИЗНУТРИ туннеля.
    in property <int> vpn-state;        // 2 = туннель поднят
    in property <int> coord-ping;       // мс
    in property <int> coord-hosts;
    in property <string> coord-ip;
    in property <bool> coord-is-default: true;
    // Настройки не прочитались/не сохранились. Молчать тут нельзя: приложение с
    // битым конфигом уезжает на СТАНДАРТНЫЙ сервер, а человек уверен, что
    // работает его собственный.
    in property <string> config-error;
    in property <[string]> history;
    in-out property <string> coord-field;
    callback set-coord(string);
    callback reset-coord();
    callback copy-text(string);

    // ОБРЫВ СВЯЗИ — НЕ БЕДА, а янтарь. Он чинится сам за секунды, и кричать о
    // нём красным (кружок, значок, рамка вокруг самого большого блока экрана,
    // точка на нав-баре — четырьмя способами разом) значит расходовать цвет
    // тревоги на то, что пройдёт само. Красный остаётся там, где само не
    // пройдёт: ошибка настроек и ошибка подключения.
    property <color> tint: coord-state == 1 ? Theme.green : Theme.amber;
    // При обрыве важно сказать, что связь восстанавливается САМА: клиент
    // переподключается по дедлайну тишины, вручную ничего делать не нужно.
    property <string> status-text: coord-state == 1 ? "На связи" : coord-state == 2 ? "Нет связи — восстанавливаю…" : "Проверяю связь…";
    // ТА ЖЕ ЛИНЕЙКА, ЧТО У ПИНГА ДО ХОСТА (components.slint, PingTile). Раньше
    // линеек было две, и меньшее число выходило тревожнее большего.
    property <color> ping-color: coord-ping < 250 ? Theme.fg : coord-ping <= 500 ? Theme.amber : Theme.red;

    // ── ПРОКРУЧИВАЕМОЕ (во всю высоту; панель ПАРИТ поверх) ─────────────
    ScrollView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            alignment: start;
            padding: Theme.pad;
            // Отступ РОВНО в высоту панели: содержимое начинается сразу под ней
            // и уходит под неё при прокрутке. Число здесь было бы враньём —
            // высота панели меняется вместе с состоянием.
            padding-top: panel.height + 12px;   // 12 = 24 (завеса) − 12 (нижний отступ обёртки панели)
            padding-bottom: 120px;  // низ покоящегося содержимого = верх завесы нав-бара
            spacing: Theme.gap;

            Text {
                text: "Сервер только помогает найти хостов и связаться с ними. Ваш трафик идёт напрямую к хосту, мимо сервера.";
                color: Theme.dim; font-size: 12px; wrap: word-wrap;
            }

            if root.config-error != "": Text {
                text: root.config-error;
                color: Theme.red; font-size: 13px; wrap: word-wrap;
            }

            SectionLabel { text: "Другой адрес сервера"; }
            Field { placeholder: "адрес сервера"; text <=> root.coord-field; accepted => { root.set-coord(root.coord-field); } }
            CalmButton { title: "Сохранить и проверить"; clicked => { root.set-coord(root.coord-field); } }
            if !root.coord-is-default: Text {
                text: "Вернуть стандартный сервер";
                color: Theme.dim; font-size: 13px; horizontal-alignment: center;
                TouchArea { clicked => { root.reset-coord(); } }
            }

            if root.history.length > 0: SectionLabel { text: "Недавние серверы"; }
            if root.history.length > 0: HorizontalLayout {
                spacing: 8px;
                for url in root.history: Rectangle {
                    height: 36px;
                    border-radius: 16px;
                    background: Theme.card-hi;
                    HorizontalLayout {
                        padding-left: 14px; padding-right: 14px;
                        Text { text: url; color: Theme.fg; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { root.coord-field = url; root.set-coord(url); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }

    // ── ПАРЯЩАЯ ПАНЕЛЬ (накладка поверх прокрутки) ───────────────────────
    //
    // Панель — НЕ сосед прокрутки сверху, а НАКЛАДКА. Список идёт во всю
    // высоту ПОД ней и виден в боковых зазорах (по Theme.pad слева и справа от
    // карточки): содержимое уходит под панель, а не обрывается о её край.
    //
    // Соседом по VerticalLayout панель занимала собственную полосу во всю
    // ширину: список упирался в её низ, а по бокам от скруглённой карточки
    // стояла пустая полоса цвета страницы — тот самый «квадрат с таким же
    // фоном, как основа», на который жаловались.
    //
    // Объявлена ПОСЛЕ ScrollView намеренно: `z` в Slint нет, поверх рисуется
    // тот, кто объявлен последним.
    panel := Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        // Ровно по содержимому: иначе накладка растянулась бы во весь экран и
        // накрыла список целиком.
        height: panel-box.preferred-height;
        // У ОБЁРТКИ НЕТ НИ ФОНА, НИ ТЕНИ — ровно затем, чтобы сквозь боковые
        // зазоры было видно, как список проходит насквозь. Фон и тень — только
        // у самой карточки (FloatCard), по её скруглённому контуру.
        panel-box := VerticalLayout {
            padding: Theme.pad;
            padding-bottom: 12px;
            // Общий парящий блок: фон и тень — те же, что у нав-бара.
            FloatCard {
                // Кольцо состояния — ТИШЕ СОДЕРЖИМОГО и уведено под кромку
                // света: на 0.45 обводка была ярче самой панели, и вся «высота»
                // держалась на ней. Покажут состояние иначе — панель не станет
                // от этого плоской.
                stroke: root.tint.with-alpha(0.30);
                // Глушит клики по пустым местам карточки: без неё тап
                // проваливался бы на карточку хоста, лежащую ПОД панелью.
                // Стоит ПЕРВОЙ — содержимое объявлено ниже и в попадании
                // выигрывает у неё.
                TouchArea {}
                VerticalLayout {
                    alignment: start;   // иначе строки разъезжаются по высоте
                    padding-top: 16px; padding-bottom: 18px;
                    padding-left: 18px; padding-right: 18px;
                    spacing: 8px;

                    // ── связь есть: значок компактный, место отдано цифрам ──
                    if root.coord-state == 1: StatusLine {
                        name: root.status-text;
                        tint: root.tint;
                        IconAntenna { width: 19px; height: 19px; tint: root.tint; }
                    }
                    if root.coord-state == 1: Text {
                        text: root.coord-url; color: Theme.dim; font-size: 13px;
                        font-family: "monospace"; overflow: elide;
                    }
                    if root.coord-state == 1: HorizontalLayout {
                        spacing: 8px;
                        StatTile {
                            // Обычная плитка, а не кнопка: проверка идёт сама
                            // каждую секунду, и нажатие экономило бы в лучшем
                            // случае их же.
                            label: "ПИНГ"; value: root.coord-ping + " мс";
                            tint: root.ping-color; horizontal-stretch: 1;
                        }
                        StatTile { label: "ХОСТОВ"; value: root.coord-hosts; horizontal-stretch: 1; }
                    }
                    if root.coord-state == 1: CopyTile {
                        label: "ВАШ IP"; value: root.coord-ip == "" ? "—" : root.coord-ip;
                        copy(t) => { root.copy-text(t); }
                    }
                    // Когда туннель поднят, замер до координатора идёт ИЗНУТРИ
                    // него: окно ходит в сеть через свой же VPN. То есть цифра
                    // — «туннель + координатор», а не путь до сервера, о
                    // котором человек думает, глядя на слово «ПИНГ».
                    // На Android такой подписи нет и не нужно: там приложение
                    // исключено из туннеля целиком, и цифра честная сама по себе.
                    if root.coord-state == 1 && root.vpn-state == 2: Text {
                        text: "Пинг измерен через туннель — в него входит и путь до хоста";
                        color: Theme.dim; font-size: 11px;
                        horizontal-alignment: center; wrap: word-wrap;
                    }

                    // ── связи нет или проверяем: крупный круг ──
                    if root.coord-state != 1: Rectangle {
                        height: 74px;
                        if root.coord-state == 0: Rectangle {
                            property <float> t: Math.mod(animation-tick() / 1ms, 1200) / 1200;
                            property <length> d: 72px * (1 + 0.28 * self.t);
                            x: (parent.width - self.d) / 2;
                            y: (74px - self.d) / 2;
                            width: self.d; height: self.d;
                            border-radius: self.d / 2;
                            border-width: 2px;
                            border-color: root.tint.with-alpha(0.5 * (1 - self.t));
                        }
                        Rectangle {
                            x: (parent.width - 72px) / 2;
                            y: 1px;
                            width: 72px; height: 72px;
                            border-radius: 36px;
                            background: root.tint.with-alpha(0.13);
                            border-width: 1px;
                            border-color: root.tint.with-alpha(0.3);
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    if root.coord-state == 0: IconAntenna { width: 32px; height: 32px; tint: root.tint; }
                                    if root.coord-state == 2: IconAntennaOff { width: 32px; height: 32px; tint: root.tint; hole: Theme.bg; }
                                }
                            }
                        }
                    }
                    if root.coord-state != 1: Text {
                        text: root.status-text; color: Theme.fg; font-size: 21px; font-weight: 800;
                        horizontal-alignment: center; wrap: word-wrap;
                    }
                    if root.coord-state != 1: Text {
                        text: root.coord-url; color: Theme.dim; font-size: 13px;
                        font-family: "monospace"; horizontal-alignment: center; overflow: elide;
                    }
                }
            }
        }
    }
}
