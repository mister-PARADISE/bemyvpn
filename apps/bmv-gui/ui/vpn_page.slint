// Вкладка «VPN» — герой-статус, подключение по коду, недавние, список хостов.
//
// Как и остальные вкладки: панель состояния ПАРИТ поверх прокрутки, всё
// остальное проходит под ней. Панель адаптивная — когда подключено, круг уступает место
// цифрам (адрес хоста, гости, часы). Копирование кода сети и QR живут на нижней
// полке (app.slint), под большим пальцем.
import { Theme } from "theme.slint";
import { HostRow, StatTile, PingTile, CopyTile, SectionLabel, Field,
         StatusLine, StateChip, ShareButton, CalmButton, FloatPanel, PageScroll, Hero } from "components.slint";
import { IconShield, IconShieldCheck, IconShieldSlash, IconShieldLock, IconMask, IconLock, IconLockOpen,
         IconPeople, IconCopy, IconQr, IconPaste, IconArrowRight, IconChevronRight, IconChevronUp } from "icons.slint";

// Значок протокола по id — семейство щита.
component ProtoIcon inherits Rectangle {
    in property <string> id;
    in property <color> tint: Theme.dim;
    /// Прорезь в щите — В ЦВЕТ ТОГО, НА ЧЁМ ЗНАЧОК ЛЕЖИТ. Значок стоит и в
    /// строке имени (там подложка — сама карточка, а она меняется при
    /// раскрытии), и в плитке «ПРОТОКОЛ» (там s3). Один вписанный цвет на оба
    /// случая рисовал бы поперёк щита щель чужого оттенка.
    in property <color> hole: Theme.card;
    if id == "" || id == "noise" || id == "noise-aes": IconShieldLock { width: 100%; height: 100%; tint: root.tint; hole: root.hole; }
    if id == "noise-obfs": IconMask { width: 100%; height: 100%; tint: root.tint; }
    // ПУСТОЙ протокол — это «Обычный» (щит с замком), а не «без шифра»: хост
    // просто не объявил имя, канал всё равно шифрованный. Раньше он попадал в
    // последнюю ветку и рисовался перечёркнутым щитом — самый опасный из
    // возможных обманов. Последняя ветка ловит всё остальное незнакомое: пустое
    // место читалось бы как «тут ничего нет», а не как «мы это не опознали».
    if id != "" && id != "noise" && id != "noise-aes" && id != "noise-obfs": IconShieldSlash { width: 100%; height: 100%; tint: root.tint; hole: root.hole; }
}

/// СВЕЧЕНИЕ ПОДКЛЮЧЁННОЙ КАРТОЧКИ: МЯГКОЕ СИЯНИЕ НАРУЖУ, А НЕ ВТОРАЯ ОБВОДКА.
///
/// Ставится ВНУТРЬ карточки, но не пачкает её: каждая ступень — не заливка, а
/// КОЛЬЦО шириной ровно в свой вылет (`border-width: d` при радиусе `radius + d`),
/// то есть полоса от контура карточки наружу на d. Внутри контура кольцо не
/// рисует ничего, поэтому свечению не нужно лежать ПОД карточкой — а значит, и
/// разбирать карточку на обёртку с корпусом не пришлось.
///
/// МЕХАНИЗМ — ЛЕСЕНКА РАЗДУТЫХ КОНТУРОВ. Смещение контура наружу на d превращает
/// скругление R в R + d, то есть раздутый прямоугольник — ТОЧНАЯ линия равного
/// расстояния до контура: одинаковая сверху, снизу, сбоку и в вырезах углов. Тем
/// же приёмом собран ореол парящего слоя (`FloatHalo`). Родное размытие тут не
/// годится ровно по той причине, по которой отсюда убрали тень:
/// `drop-shadow-blur` у Slint, `radius` у SwiftUI и `elevation` у Compose —
/// РАЗНЫЕ величины, и три одинаковых числа дали бы три разных вылета (замер:
/// 13.3 против 8.5). Лесенка от единиц оболочки не зависит вовсе.
///
/// ПОЛОСЫ НЕ НАКЛАДЫВАЮТСЯ, И ЭТО ГЛАВНОЕ. Каждая точка красится РОВНО ОДИН РАЗ,
/// сразу нужной непрозрачностью `peak·(1 − d/reach)`. Первый заход складывал
/// двадцать четыре полупрозрачных кольца друг на друга — математически то же
/// самое, а на экране НЕТ: у каждого кольца выходила альфа 0.009, это 2.3 из
/// 255, и оболочки округляли её по-разному. Замер: у контура 57 по зелёному в
/// окне и на iPhone против 63 на Android — расхождение 12%, ровно цена одной
/// единицы округления, помноженной на двадцать четыре наложения. Одно наложение
/// вместо двадцати четырёх убирает эту цену целиком: одиночное смешивание все
/// три оболочки считают одинаково (проверено на кромке `hairline` — везде до
/// единицы одно и то же).
///
/// СТЫКОВ МЕЖДУ ПОЛОСАМИ НЕ ВИДНО, И ЭТО НЕ ВЕЗЕНИЕ: сглаживание делит
/// пограничную точку между соседними полосами по покрытию, а покрытия дают в
/// сумме единицу — выходит ровно та же альфа, что и посередине между ними.
///
/// ПОЧЕМУ СВЕТ МОЖНО ТАМ, ГДЕ ТЕНЬ БЫЛА НЕЛЬЗЯ. Страница `#08090B` — 8/255, до
/// чистого чёрного восемь единиц: тёмному пятну падать некуда, и тень честно
/// давала 2–3 единицы. У света ход в двадцать семь раз больше: мята по зелёному
/// каналу 224 против 9 у фона. Замер на живом окне — в шапке `[glow]` источника.
component CardGlow inherits Rectangle {
    /// Скругление карточки, которую свечение обнимает.
    in property <length> radius;
    // Ровно коробка карточки: от неё считаются все вылеты. Слинт детям размер
    // родителя сам не даёт, поэтому сказано здесь — чтобы на месте применения об
    // этом было нечего забыть.
    width: 100%;
    height: 100%;
    /// Полос в спаде. 24 на вылет 12 — по полпикселя на полосу, меньше пикселя на
    /// любом экране, поэтому лесенки не видно: перепад альфы на полосу (0.22/24)
    /// даёт по зелёному каналу две единицы из 255.
    property <int> steps: 24;
    property <length> band: Theme.glow-reach / root.steps;
    for i in root.steps: Rectangle {
        /// Внешний край полосы: сама она занимает [d − band, d] от контура.
        property <length> d: root.band * (i + 1);
        x: -self.d;
        y: -self.d;
        width: root.width + 2 * self.d;
        height: root.height + 2 * self.d;
        border-radius: root.radius + self.d;
        border-width: root.band;
        // Непрозрачность берётся по СЕРЕДИНЕ полосы — там, где она и должна быть.
        border-color: Theme.accent.with-alpha(Theme.glow-peak * (1 - (i + 0.5) / root.steps));
    }
}

// Карточка хоста: свёрнутый вид + раскрытие (детали + Подключить).
component HostCard inherits Rectangle {
    in property <HostRow> h;
    in property <bool> expanded: false;
    /// МЫ СЕЙЧАС В ЭТОЙ СЕТИ. Не «выбрана» и не «раскрыта» — это разные вещи:
    /// раскрыта может быть одна карточка, а работает соединение с другой.
    /// Поэтому признак отдельный и живёт СВОИМ языком (см. кромку и чип ниже).
    in property <bool> live: false;
    in-out property <string> guest-password;
    callback toggle();
    // ID хоста, а не номер строки: список пересобирается целиком на каждое
    // обновление каталога, и номер к моменту нажатия мог указывать на другой хост.
    callback connect(string);
    callback copy-text(string);
    /// «КАРТОЧКА ПОДРОСЛА» — прокрутке пора её догонять. Зовётся ТОЛЬКО из тика
    /// часов ниже, и это не стиль, а условие жизни: см. следом.
    callback grew();

    /// ЗА РОСТОМ КАРТОЧКИ ЕДЕТ ТИК ЧАСОВ, А НЕ `changed height`.
    ///
    /// `changed height` здесь стоял — и УБИВАЛ ПРИЛОЖЕНИЕ насмерть при
    /// переключении вкладок («Хост»/«Сервер» → «VPN», паника `Recursion
    /// detected` в property-графе Slint). Дело НЕ в теле обработчика: Slint
    /// заводит слежение за размером, вычисляя отслеживаемое выражение ПРЯМО В
    /// МОМЕНТ РОЖДЕНИЯ карточки (`ChangeTracker::init`), а рождаются карточки
    /// внутри `Repeater::ensure_updated`, который зовётся из вычисления
    /// `viewport-height` прокрутки. Замкнутый круг: высота карточки берётся из
    /// раскладки, раскладка уже считается — и Slint честно ловит рекурсию.
    /// Пустой `changed height` упал бы ровно так же, поэтому «проверим на ноль»
    /// тут не лечит НИЧЕГО.
    ///
    /// ПРАВИЛО, КОТОРОЕ ЭТО ДЕЛАЕТ НЕВОЗМОЖНЫМ: прокрутки касается только тик
    /// часов. Часы срабатывают из цикла событий — там раскладка НЕ считается, и
    /// читать геометрию так же безопасно, как в обработчике нажатия. Отслеживаем
    /// же мы `expanded` — обычный признак, к раскладке отношения не имеющий.
    ///
    /// 8 тиков по 30мс = 240мс, чуть длиннее 220мс роста высоты: список едет
    /// вместе с карточкой и доезжает к концу роста, как и раньше. Сворачивание
    /// не догоняем — там показывать нечего.
    property <int> chase: 0;
    changed expanded => { if (root.expanded) { root.chase = 8; } }
    Timer {
        interval: 30ms;
        running: root.chase > 0;
        triggered => {
            root.chase -= 1;
            root.grew();
        }
    }
    /// Заливка плиток внутри раскрытой карточки: ЧИСТАЯ СТУПЕНЬ s3, БЕЗ ПОДКРАСКИ.
    ///
    /// Мята с плиток снята: в раскрытой карточке их семь, и семь подкрашенных
    /// ячеек читались как «всё это включено», хотя это просто цифры о хосте.
    /// Ступень s3 для того и заведена — она отличима от своей подложки (10.25 L*
    /// над s2 раскрытой карточки), но остаётся нейтральной. Та же ступень лежит
    /// под плитками панели состояния, так что по оттенку они одно и то же.
    property <color> tile-fill: Theme.tile;
    border-radius: 16px;
    /// ВНУТРИ КАРТОЧКИ МЯТЫ НЕТ — ОДНИ СТУПЕНИ.
    ///
    /// Пробовали и так, и эдак: сперва мятой красили карточку целиком (цвет
    /// доставался оболочке, а не содержимому), потом — плитки внутри (семь
    /// подкрашенных ячеек читались как «всё это включено»). Осталась чистая
    /// лестница: свёрнутая карточка s1 (6.64 L*), раскрытая s2 (9.06), плитки
    /// внутри неё s3 (19.31). Все три различимы, и ни одна ничего не обещает.
    ///
    /// «РАСКРЫТА» ЧИТАЕТСЯ БЕЗ ПОДКРАСКИ — ступенью и рамкой. Рамка при этом
    /// осталась мятной (`edge-soft`), так что признак не один: человеку с
    /// нарушением цветовосприятия остаётся ступень, которой у свёрнутых нет.
    ///
    /// ── «ПОДКЛЮЧЕНО» ГОВОРИТ СВЕЧЕНИЕ ВОКРУГ, А НЕ КРОМКА И НЕ ЗАЛИВКА ───────
    ///
    /// Заливка в этом приложении уже занята и занята плотно: ступень отвечает на
    /// «раскрыта ли», подкраска (`picked`) — на «выбрано ли». Кромка занята тоже:
    /// мятая `edge-soft` означает «раскрыта». Подключён при этом может быть ОДИН
    /// хост, тогда как раскрыт — совсем ДРУГОЙ, и увидеть надо оба сразу.
    ///
    /// ЗДЕСЬ БЫЛА ОБВОДКА — МЯТА В ПОЛНУЮ СИЛУ И ВДВОЕ ТОЛЩЕ. Владелец посмотрел
    /// и сказал: «всмысле обводка а не свечение?» — и он прав, обводка спорила с
    /// кромкой «раскрыта» тем же языком, только громче: две линии одной толщины
    /// с разной насыщенностью отличать глазом тяжело. Свечение живёт СНАРУЖИ
    /// карточки, где не занято ничего, поэтому оно ни с чем не складывается и ни
    /// с чем не спорит: подключённая карточка честно показывает и то, что она
    /// раскрыта (ступень плюс кромка), и то, что через неё идёт трафик (сияние).
    ///
    /// ПРИЗНАК НЕ ОДИН ЦВЕТ, И ИХ ДВА. Свечение СВЕТЛЕЕ фона — на чёрно-белом
    /// снимке оно остаётся ореолом (по серому +37 единиц из 255 у контура), а
    /// не пропадает, как пропала бы разница двух оттенков одной яркости. Плюс
    /// слово: чип «Подключено» в строке имени, который читается вообще без цвета.
    background: root.expanded ? Theme.card-hi : Theme.card;
    border-width: 1px;
    border-color: root.expanded ? Theme.edge-soft(Theme.accent) : Theme.hairline;
    animate background, border-color { duration: 200ms; easing: ease-in-out; }

    // СВЕЧЕНИЕ — ПЕРЕД содержимым: оно рисуется поверх фона карточки, но внутри
    // её контура не кладёт ни точки (см. CardGlow), так что содержимому не мешает.
    // Появляется и пропадает разом с чипом «Подключено» — это одна и та же весть.
    if root.live: CardGlow { radius: 16px; }

    VerticalLayout {
        padding: 14px;
        spacing: 0px;

        // ── свёрнутая строка (тап раскрывает) ──
        header := TouchArea {
            clicked => { root.toggle(); }
            HorizontalLayout {
                spacing: 12px;
                // Флаг-аватарка слева.
                //
                // ПЛАШКА НА СТУПЕНЬ НИЖЕ ПЛИТКИ (s2, а не s3), САМ ФЛАГ ПРИГЛУШЁН.
                // Флаг — единственное полностью насыщенное пятно на экране, и
                // сидел он на самой светлой подложке темы: в списке глаз ловил
                // его раньше имени хоста, ради которого на строку и смотрят.
                // ПЛАШКА — ВСЕГДА НА СТУПЕНЬ ВЫШЕ СВОЕЙ КАРТОЧКИ. Жёстко
                // вписанный s2 совпадал с фоном РАСКРЫТОЙ карточки — плашка
                // пропадала целиком, от неё оставалась одна
                // рамка. Теперь она идёт следом за карточкой.
                Rectangle {
                    width: 56px; height: 56px;
                    border-radius: 14px;
                    background: root.expanded ? Theme.tile : Theme.card-hi;
                    border-width: 1px;
                    // Кромка БЕЛАЯ: плашка лежит ВНУТРИ карточки, а не на
                    // странице (см. «не везде» в theme.slint).
                    border-color: Theme.hairline-inner;
                    if h.has-flag: Image { source: h.flag-img; width: 34px; height: 24px; opacity: 0.85; }
                    if !h.has-flag: Text { text: "🌍"; font-size: 26px; opacity: 0.85; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    // ЗНАЧОК ПРОТОКОЛА — В СТРОКЕ ИМЕНИ, ПЕРЕД НИМ.
                    //
                    // Значок есть У КАЖДОГО протокола: раньше он был только у
                    // «Маскировки», и его отсутствие означало сразу две
                    // противоположные вещи — «Обычный» (шифр есть) и «Без
                    // шифра» (шифра нет). Хуже всего доставалось опасному
                    // случаю: незащищённый хост выглядел в списке ровно как
                    // защищённый.
                    //
                    // Стоял он в строке ПОДПИСИ, под именем; теперь — рядом с
                    // самим именем, потому что защита относится к хосту, а не к
                    // счётчику гостей. Первым, а не в хвосте: у значка ширина
                    // фиксированная, у имени — сжимаемая (overflow: elide), и
                    // узкое окно ужимает именно имя. Значок в хвосте прижимался
                    // бы к огрызку имени; слева же значки выстраиваются в ровный
                    // столбец, а многоточие съедает хвост имени — как ему и
                    // положено.
                    HorizontalLayout {
                        spacing: 5px;
                        VerticalLayout {
                            alignment: center;   // иначе значок липнет к верху строки
                            ProtoIcon {
                                id: h.proto-id; width: 14px; height: 14px;
                                hole: root.expanded ? Theme.card-hi : Theme.card;
                            }
                        }
                        Text {
                            text: h.name; color: Theme.fg; font-size: 16px; font-weight: 600;
                            overflow: elide; min-width: 0px; vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        // Чип «Подключено» — В СТРОКЕ ИМЕНИ, а не отдельной
                        // полосой: он говорит про сам хост, и читать его надо
                        // там же, где читают имя. Ширина у него фиксированная,
                        // у имени — сжимаемая, так что уступает место имя (ему
                        // на то и `overflow: elide`).
                        if root.live: VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            StateChip { text: "Подключено"; tint: Theme.accent; }
                        }
                    }
                    // Подпись: страна и гости. Значка здесь больше нет — он
                    // переехал к имени.
                    Text { text: h.subtitle; color: Theme.dim; font-size: 13px; overflow: elide; }
                    // Полоса заполненности.
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: #FFFFFF17;
                        Rectangle {
                            x: 0;
                            width: parent.width * h.fill;
                            height: 3px;
                            border-radius: 1.5px;
                            background: h.fill < 0.8 ? Theme.accent : Theme.amber;
                        }
                    }
                }
                if h.locked: VerticalLayout { alignment: center; IconLock { width: 15px; height: 15px; tint: Theme.dim; } }
                VerticalLayout {
                    alignment: center;
                    if !root.expanded: IconChevronRight { width: 15px; height: 15px; tint: Theme.dim; }
                    if root.expanded: IconChevronUp { width: 15px; height: 15px; tint: Theme.dim; }
                }
            }
        }

        // ── детали (раскрыто) — АНИМИРОВАННОЕ раскрытие по высоте ──
        // clip + анимация height от 0 до реальной высоты содержимого.
        Rectangle {
            clip: true;
            height: root.expanded ? detail.preferred-height : 0px;
            animate height { duration: 220ms; easing: ease-in-out; }
            detail := VerticalLayout {
                width: parent.width;
                padding-top: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    CopyTile { label: "КОД"; value: h.code; fill: root.tile-fill; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                    CopyTile { label: "IP"; value: h.ip; fill: root.tile-fill; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile { label: "СТРАНА"; value: h.country; fill: root.tile-fill; horizontal-stretch: 1; }
                    StatTile { label: "ГОСТЕЙ"; value: h.guests; fill: root.tile-fill; horizontal-stretch: 1; }
                    PingTile { ping: h.ping; alarm: h.ping-alarm; fill: root.tile-fill; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile {
                        label: "ДОСТУП"; value: h.access; fill: root.tile-fill; horizontal-stretch: 1;
                        if h.locked: IconLock { width: 12px; height: 12px; tint: Theme.fg; }
                        if !h.locked: IconLockOpen { width: 12px; height: 12px; tint: Theme.fg; }
                    }
                    StatTile {
                        label: "ПРОТОКОЛ"; value: h.proto; fill: root.tile-fill; horizontal-stretch: 1;
                        ProtoIcon { id: h.proto-id; width: 12px; height: 12px; tint: Theme.fg; hole: root.tile-fill; }
                    }
                }
                // Кромка БЕЛАЯ: поле лежит ВНУТРИ раскрытой карточки, рядом с
                // плитками, и берёт их волосяную (см. «не везде» в theme.slint).
                if h.locked: Field {
                    placeholder: "Пароль"; secure: true; text <=> root.guest-password;
                    stroke: Theme.hairline-inner;
                }
                // Та же спокойная кнопка, что и на остальных экранах — теперь
                // общий компонент, а не её копия здесь.
                CalmButton {
                    title: "Подключить";
                    enabled: h.usable;
                    clicked => { root.connect(root.h.id); }
                }
            }
        }
    }
}

export component VpnPage inherits Rectangle {
    in property <[HostRow]> hosts;
    in property <[string]> recent-names;   // подписи недавних чипов
    in property <[string]> recent-ids;
    in property <int> vpn-state;
    in property <string> vpn-status;
    in property <int> coord-state;
    in property <string> vpn-host-id;
    in property <string> vpn-sub;
    in property <string> vpn-ip;
    in property <string> vpn-guests;
    in property <string> vpn-proto;
    in property <string> vpn-proto-id;
    in property <string> vpn-country;
    in property <string> vpn-elapsed;
    in property <int> host-count;
    /// Сколько СНИЗУ закрыто нав-баром (бар + подъём + гашение). Приходит из
    /// app.slint, посчитанное от самого бара: см. `bar-cover` там.
    in property <length> bar-cover;
    /// Версия свежего релиза («1.6») или "" — плашки нет. Приходит от
    /// координатора уже с проверенной подписью, здесь только показ.
    in property <string> update-version;
    /// 0 — простаивает · 1 — качаю · 2 — готово, нужен перезапуск · 3 — ошибка
    in property <int> update-state;
    in property <string> update-error;
    in-out property <string> code;
    in-out property <string> guest-password;
    // Раскрытая карточка помнится ПО ID, а не по номеру строки. Номер переживал
    // пересборку списка: состав менялся — и раскрытой оказывалась карточка
    // другого хоста, а замер отклика продолжал мерить прежний.
    property <string> expanded: "";
    callback connect(string);
    // Карточку раскрыли — можно замерить отклик до этого хоста ("" = свернули).
    callback expanded-host(string);
    callback connect-code();
    callback disconnect();
    callback paste();
    callback copy-text(string);
    callback do-update();
    callback show-qr(string);

    // ЦВЕТ СОСТОЯНИЯ, А НЕ ЦВЕТ ЭКРАНА. Выключено — dim: раньше здесь стоял
    // акцент, и после слияния зелёного с мятой кольцо панели горело бы одной
    // мятой и при «VPN выключен», и при «Подключено» — то есть отвечало бы
    // одинаково на единственный вопрос, ради которого сюда смотрят.
    property <color> tint: vpn-state == 1 ? Theme.amber : vpn-state == 2 ? Theme.accent : vpn-state == 3 ? Theme.red : Theme.dim;

    // ── ВИДИМАЯ ПОЛОСА: ЭКРАН МИНУС ОБА ПАРЯЩИХ СЛОЯ ────────────────────
    //
    // Ни верх, ни низ окна видимой полосой не являются: сверху лежит панель
    // состояния со своим гашением, снизу — нав-бар со своим. Карточка, упёршаяся
    // низом в край окна, «видима» только на бумаге — на деле она под баром.
    /// Верх полосы — ровно верхний отступ прокрутки (панель + остаток завесы).
    property <length> band-top: panel.height + 6px;
    /// Низ полосы: окно минус то, что закрывает нав-бар (`bar-cover`).
    property <length> band-bottom: scroll.visible-height - root.bar-cover;

    /// ПОКАЗАТЬ РАСКРЫТУЮ КАРТОЧКУ ЦЕЛИКОМ. Одно правило на всю оболочку — и то
    /// же самое, что на iPhone и на Android.
    ///
    /// Помещается в полосу — ЦЕНТРИРУЕМ по вертикали: так спокойнее всего, глазу
    /// не надо искать, куда уехала карточка. Не помещается — центрировать
    /// НЕЛЬЗЯ: спрячется её начало вместе с именем хоста. Тогда прижимаем ВЕРХ
    /// карточки к верху полосы и показываем, сколько влезло.
    ///
    /// Сдвиг зажат обоими концами: выше начала списка и ниже его конца прокрутка
    /// не уедет, поэтому первую карточку короткого списка центрировать нечем —
    /// она честно остаётся на месте.
    ///
    /// ЗВАТЬ ТОЛЬКО ИЗ ТИКА ЧАСОВ. Здесь читается геометрия карточки, а значит
    /// считается раскладка страницы; из обработчика размера (`changed height`)
    /// раскладка уже считается — и Slint валит приложение с `Recursion detected`.
    /// Разбор — в карточке, у `chase`. Единственный вход сюда — `grew()`.
    function reveal(card-y: length, card-h: length) {
        scroll.viewport-y = max(
            min(0px, scroll.visible-height - scroll.viewport-height),
            min(0px, (card-h <= root.band-bottom - root.band-top
                      ? root.band-top + (root.band-bottom - root.band-top - card-h) / 2
                      : root.band-top) - card-y));
    }

    // ── ПРОКРУЧИВАЕМОЕ (во всю высоту; панель ПАРИТ поверх) ─────────────
    // Имя нужно ради умной прокрутки к раскрытой карточке (`reveal` выше).
    scroll := PageScroll {
        panel-h: panel.height;

        // ── Свежий релиз ──
        // Крестика нет намеренно: это единственный канал про новую
        // версию, и спрятав его, человек больше о ней не узнает.
        if root.update-version != "": Rectangle {
            border-radius: 14px;
            // Слабая подкраска, как у раскрытой карточки: плашка большая, и
            // полная сила на такой площади кричала бы. Прежние 0.09
            // прозрачным поверх страницы давали L* 9.6 — ТЕМНЕЕ обычной
            // карточки списка, и сообщение о новой версии выглядело
            // провалом в фоне.
            background: Theme.touched(root.update-state == 3 ? Theme.red : Theme.accent);
            border-width: 1px;
            border-color: Theme.edge-soft(root.update-state == 3 ? Theme.red : Theme.accent);
            height: 62px;
            HorizontalLayout {
                padding: 12px;
                padding-left: 14px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.update-state == 1 ? "Скачиваю " + root.update-version + "…"
                            : root.update-state == 2 ? "Готово — закрываю и обновляюсь"
                            : root.update-state == 3 ? root.update-error
                            : "Версия " + root.update-version + " доступна";
                        color: root.update-state == 3 ? Theme.red : Theme.accent;
                        font-size: 13px; font-weight: 700; wrap: word-wrap;
                    }
                }
                // Пока качаем или готовимся закрыться — кнопки нет:
                // решение уже принято, жать больше не на что.
                if root.update-state != 1 && root.update-state != 2: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        // Мятная: обновиться — действие хорошее, а не
                        // тревожное. При ошибке — в цвете ошибки, иначе
                        // читалась бы как чужая деталь.
                        property <color> hue: root.update-state == 3 ? Theme.red : Theme.accent;
                        width: 116px; height: 38px;
                        border-radius: 11px;
                        background: Theme.picked(self.hue);
                        border-width: 1px;
                        border-color: Theme.edge(self.hue, upd-ta.has-hover);
                        Text {
                            text: root.update-state == 3 ? "Ещё раз" : "Обновить";
                            color: parent.hue; font-size: 13px; font-weight: 700;
                            horizontal-alignment: center; vertical-alignment: center;
                            width: 100%; height: 100%;
                        }
                        upd-ta := TouchArea { clicked => { root.do-update(); } }
                    }
                }
            }
        }

        // ── Подключиться по коду ──
        SectionLabel { text: "Подключиться по коду"; }
        // СТРОКА КОДА — ЭТО САМО ПОЛЕ, А НЕ КОРОБКА С ПОЛЕМ ВНУТРИ: текст лежит
        // прямо на этой заливке, кнопки просто припаркованы в правом её конце.
        // Поэтому кромка идёт по внешнему контуру строки — там, где на самом деле
        // кончается поле; обвести вместо этого внутренний участок значило бы
        // провести линию посреди сплошной заливки одного цвета.
        //
        // КНОПКИ ВНУТРИ ОСТАЮТСЯ СИНИМИ, И ЭТО НЕ ИСКЛЮЧЕНИЕ ИЗ ПРАВИЛА, А ЕГО
        // ПРИЧИНА. Белую волосяную получает то, что заливка родителя УЖЕ отделила:
        // плитка на парящей панели отстоит от неё на 8.21 по L*, кромке там нечего
        // держать. Здесь перепад s1→s2 всего 2.42 — заливка не отделяет ничего,
        // и кромка кнопки остаётся несущей.
        Rectangle {
            height: 54px;
            border-radius: 14px;
            background: Theme.card;
            border-width: 1px;
            border-color: Theme.hairline;
            HorizontalLayout {
                padding: 5px;
                spacing: 6px;
                // Поле кода.
                Rectangle {
                    horizontal-stretch: 1;
                    code-in := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        color: Theme.fg; font-size: 15px;
                        text <=> root.code;
                        single-line: true;
                        accepted => { root.connect-code(); }
                    }
                    if root.code == "": Text {
                        x: 12px; height: parent.height;
                        text: "КОД СЕТИ"; color: Theme.dim; font-size: 15px; vertical-alignment: center;
                    }
                }
                // Вставить — второстепенное действие, поэтому тихое.
                Rectangle {
                    width: 44px; height: 44px;
                    border-radius: 10px;
                    background: paste-ta.has-hover ? Theme.card-hi.brighter(0.12) : Theme.card-hi;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconPaste { width: 18px; height: 18px; tint: Theme.dim; } } }
                    paste-ta := TouchArea { clicked => { root.paste(); } }
                }
                // Перейти — ТА ЖЕ СТУПЕНЬ, ЧТО У «ВСТАВИТЬ» (s2). Мята отсюда
                // снята: она обещает «работает/включено», а это просто
                // переход. Ступень выше соседки тут тоже была лишней — на
                // одном экране выходило три ступени кнопок; владелец
                // посмотрел и выбрал одну. Старшинство несут ДРУГИЕ признаки,
                // и их два: кнопка шире (52 против 44) и глиф в ней светлый
                // (fg против dim у «вставить»).
                Rectangle {
                    width: 52px; height: 44px;
                    border-radius: 10px;
                    background: go-ta.has-hover ? Theme.card-hi.brighter(0.12) : Theme.card-hi;
                    border-width: 1px;
                    border-color: Theme.hairline;
                    VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconArrowRight { width: 22px; height: 22px; tint: Theme.fg; } } }
                    go-ta := TouchArea { clicked => { root.connect-code(); } }
                }
            }
        }

        // ── Недавние ──
        if root.recent-ids.length > 0: SectionLabel { text: "Недавние"; }
        if root.recent-ids.length > 0: HorizontalLayout {
            spacing: 8px;
            // Тот же чип, что и везде: невыбранный на s1, выбранный — s1 плюс
            // подкраска. Раньше у него была своя пара чисел (0.16 и рамка
            // 0.5) и своя ступень (s2) — третий рецепт одного и того же.
            for name[i] in root.recent-names: Rectangle {
                property <bool> hot: root.recent-ids[i] == root.vpn-host-id;
                height: 38px;
                border-radius: 16px;
                background: hot ? Theme.picked(Theme.accent)
                    : rec-ta.has-hover ? Theme.touched(Theme.accent)
                    : Theme.card;
                border-width: 1px;
                border-color: hot ? Theme.edge(Theme.accent, rec-ta.has-hover) : transparent;
                HorizontalLayout {
                    padding-left: 13px; padding-right: 13px;
                    Text { text: name; color: hot ? Theme.accent : Theme.fg; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                }
                rec-ta := TouchArea { clicked => { if (root.vpn-state == 0) { root.code = root.recent-ids[i]; root.connect-code(); } } }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // ── Хосты ──
        // Связь потеряна, а список НЕ пуст: цифры ниже — последние
        // известные, то есть могут врать. Раньше об этом кричала
        // оранжевая полоса во всю ширину, которая ещё и дышала,
        // перетягивая взгляд с самого списка. Теперь причину называет
        // тихий знак у заголовка, а «неактуально» говорит сам список —
        // приглушением. Где искать поломку, показывает точка на ячейке
        // «Сервер» в нав-баре, видная с любой вкладки.
        HorizontalLayout {
            spacing: 8px;
            SectionLabel { text: "Хосты"; }
            Rectangle { horizontal-stretch: 1; }
            if root.coord-state == 2 && root.hosts.length > 0: StateChip { text: "последние известные"; }
        }
        if root.hosts.length == 0: Text {
            text: root.coord-state == 2
                ? "Нет связи с сервером — восстанавливаю.\nЕсли надолго, проверьте адрес во вкладке «Сервер»."
                : "Хостов пока нет.\nВведите код сети или поднимите свой во вкладке «Хост».";
            color: Theme.dim; font-size: 14px;
            horizontal-alignment: center; wrap: word-wrap;
        }
        for h in root.hosts: card := HostCard {
            h: h;
            // Данные не живые — показываем это САМИМ СПИСКОМ: приглушённое
            // читается как «неактуально» мгновенно и без слов.
            opacity: root.coord-state == 2 ? 0.55 : 1.0;
            animate opacity { duration: 400ms; easing: ease-in-out; }
            expanded: root.expanded == h.id;
            // ПОДКЛЮЧЕНО — ЭТО `vpn-state == 2`, А НЕ ПРОСТО СОВПАДЕНИЕ ID.
            // `vpn-host-id` ставится оптимистично, ещё на «Подключаюсь»: метить
            // им карточку значило бы обещать работающую сеть до того, как она
            // встала (а встать может и не выйти — тогда мы бы соврали).
            live: root.vpn-state == 2 && root.vpn-host-id == h.id;
            guest-password <=> root.guest-password;
            toggle() => {
                root.expanded = (root.expanded == h.id) ? "" : h.id;
                // Шлём ВСЕГДА, в том числе "" при сворачивании: замер отклика
                // идёт циклом, пока карточка открыта, и без сигнала о закрытии
                // его нечем было бы остановить.
                root.expanded-host(root.expanded);
            }
            // РАСКРЫЛИ — ПОКАЗАТЬ КАРТОЧКУ ЦЕЛИКОМ (правило — в `reveal`).
            //
            // ПОДТЯГИВАЕМ НА КАЖДЫЙ ТИК РОСТА, А НЕ ОДНИМ РЫВКОМ В МОМЕНТ
            // НАЖАТИЯ. Сразу после нажатия прокручивать НЕЧЕГО: страница ещё
            // короче окна, и прокрутка честно зажимает сдвиг в ноль — проверено
            // на живом окне, список не двигался вовсе. Часы тикают, пока
            // карточка растёт, и список едет вместе с ней. Почему часы, а не
            // `changed height`, — в самой карточке, у `chase`.
            grew() => { root.reveal(card.y, card.height); }
            connect(id) => { root.connect(id); }
            copy-text(t) => { root.copy-text(t); }
        }
    }

    // ── ПАРЯЩАЯ ПАНЕЛЬ (накладка поверх прокрутки; каркас — в components) ──
    //
    // Объявлена ПОСЛЕ прокрутки намеренно: `z` в Slint нет, поверх рисуется
    // тот, кто объявлен последним.
    panel := FloatPanel {
        // ── подключено: значок компактный, место отдано пользе ──
        if root.vpn-state == 2: StatusLine {
            name: "Подключено";
            clock: root.vpn-elapsed;
            tint: root.tint;
            IconShieldCheck { width: 19px; height: 19px; tint: root.tint; hole: Theme.bg; }
        }
        if root.vpn-state == 2: Text {
            text: root.vpn-country + "  ·  " + root.vpn-proto;
            color: Theme.dim; font-size: 13px;
        }
        if root.vpn-state == 2: HorizontalLayout {
            spacing: 8px;
            CopyTile { label: "IP ХОСТА"; value: root.vpn-ip; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
            StatTile {
                label: "ГОСТЕЙ"; value: root.vpn-guests; horizontal-stretch: 1;
                IconPeople { width: 12px; height: 12px; tint: Theme.fg; }
            }
        }
        // Поделиться сетью — В НИЗУ панели, прямо под тем, что копируют.
        // Отдельной полкой у нав-бара кнопки оторвались бы от своего кода.
        if root.vpn-state == 2: HorizontalLayout {
            spacing: 8px;
            padding-top: 2px;
            ShareButton {
                title: "Скопировать"; feedback: true; horizontal-stretch: 1;
                clicked => { root.copy-text(root.vpn-host-id); }
                IconCopy { width: 17px; height: 17px; tint: Theme.accent; }
            }
            ShareButton {
                title: "QR-код"; horizontal-stretch: 1;
                clicked => { root.show-qr(root.vpn-host-id); }
                IconQr { width: 17px; height: 17px; tint: Theme.accent; }
            }
        }
        Text { text: root.vpn-state == 2 ? "Позвать друзей в эту же сеть" : ""; visible: root.vpn-state == 2;
               color: Theme.dim; font-size: 11px; horizontal-alignment: center; }

        // ── не подключено: крупный круг, заголовок, подпись ──
        //
        // В подписи стоит ИМЯ ХОСТА («к ЙОШКАР-ОЛА»), а оно приходит по сети —
        // с любыми буквами. Обрезку текста держит сам «герой»: у заглавных «Й» и
        // «Ё» надстрочный знак срезался умолчанием `overflow: clip`.
        if root.vpn-state != 2: Hero {
            tint: root.tint;
            pulsing: root.vpn-state == 1;
            title: root.vpn-status;
            sub: root.vpn-sub != "" ? root.vpn-sub
                : (root.host-count == 0 ? "Введите код сети или поднимите свой хост"
                   : "Доступно хостов: " + root.host-count + " · выберите ниже или жмите «Старт»");
            if root.vpn-state == 0: IconShieldSlash { width: 32px; height: 32px; tint: root.tint; hole: Theme.bg; }
            if root.vpn-state == 1: IconShield { width: 32px; height: 32px; tint: root.tint; }
            if root.vpn-state == 3: IconShieldSlash { width: 32px; height: 32px; tint: Theme.red; hole: Theme.bg; }
        }
    }
}
