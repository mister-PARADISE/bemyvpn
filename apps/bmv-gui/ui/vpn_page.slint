// Вкладка «VPN» — построчный перенос iOS VPNTab: герой-статус, «Подключиться по
// коду» (поле + вставить + стрелка), «Сканировать QR», недавние, список хостов
// карточками с раскрытием.
import { Theme } from "theme.slint";
import { HostRow, Card, StatTile, PingTile, CopyTile, GradientButton, SectionLabel, Field, HeroCircle } from "components.slint";
import { IconShield, IconShieldCheck, IconShieldSlash, IconShieldLock, IconMask, IconLock, IconLockOpen,
         IconPeople, IconCopy, IconCheck, IconClose, IconQr, IconScan, IconPaste, IconArrowRight, IconChevronRight, IconChevronUp } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

// Значок протокола по id — семейство щита.
component ProtoIcon inherits Rectangle {
    in property <string> id;
    in property <color> tint: Theme.dim;
    if id == "noise" || id == "noise-aes": IconShieldLock { width: 100%; height: 100%; tint: root.tint; hole: Theme.card-hi; }
    if id == "noise-obfs": IconMask { width: 100%; height: 100%; tint: root.tint; }
    if id == "plain" || id == "": IconShieldSlash { width: 100%; height: 100%; tint: root.tint; hole: Theme.card-hi; }
}

// Карточка хоста: свёрнутый вид + раскрытие (детали + Подключить).
component HostCard inherits Rectangle {
    in property <HostRow> h;
    in property <int> index;
    in property <bool> expanded: false;
    in-out property <string> guest-password;
    callback toggle();
    callback connect(int);
    callback copy-text(string);
    border-radius: 16px;
    background: root.expanded ? Theme.card-hi : Theme.card;
    border-width: 1px;
    border-color: root.expanded ? Theme.accent.with-alpha(0.28) : #FFFFFF0D;
    animate background, border-color { duration: 200ms; easing: ease-in-out; }

    VerticalLayout {
        padding: 14px;
        spacing: 0px;

        // ── свёрнутая строка (тап раскрывает) ──
        header := TouchArea {
            clicked => { root.toggle(); }
            HorizontalLayout {
                spacing: 12px;
                // Флаг-аватарка слева.
                Rectangle {
                    width: 56px; height: 56px;
                    border-radius: 14px;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: #FFFFFF14;
                    if h.has-flag: Image { source: h.flag-img; width: 34px; height: 24px; }
                    if !h.has-flag: Text { text: "🌍"; font-size: 26px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    Text {
                        text: h.name; color: Theme.fg; font-size: 16px; font-weight: 600; overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Text { text: h.subtitle; color: Theme.dim; font-size: 13px; overflow: elide; vertical-alignment: center; }
                        if h.obfs: ProtoIcon { id: h.proto-id; width: 13px; height: 13px; }
                    }
                    // Полоса заполненности.
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: #FFFFFF17;
                        Rectangle {
                            x: 0;
                            width: parent.width * h.fill;
                            height: 3px;
                            border-radius: 1.5px;
                            background: h.fill < 0.8 ? Theme.green : Theme.amber;
                        }
                    }
                }
                if h.locked: VerticalLayout { alignment: center; IconLock { width: 15px; height: 15px; tint: Theme.dim; } }
                VerticalLayout {
                    alignment: center;
                    if !root.expanded: IconChevronRight { width: 15px; height: 15px; tint: Theme.dim; }
                    if root.expanded: IconChevronUp { width: 15px; height: 15px; tint: Theme.dim; }
                }
            }
        }

        // ── детали (раскрыто) — АНИМИРОВАННОЕ раскрытие по высоте (как iOS) ──
        // clip + анимация height от 0 до реальной высоты содержимого (preferred-height).
        Rectangle {
            clip: true;
            height: root.expanded ? detail.preferred-height : 0px;
            animate height { duration: 220ms; easing: ease-in-out; }
            detail := VerticalLayout {
                width: parent.width;
                padding-top: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    CopyTile { label: "КОД"; value: h.code; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                    CopyTile { label: "IP"; value: h.ip; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile { label: "СТРАНА"; value: h.country; horizontal-stretch: 1; }
                    StatTile { label: "ГОСТЕЙ"; value: h.guests; horizontal-stretch: 1; }
                    PingTile { ping: h.ping; ms: h.ping-ms; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile {
                        label: "ДОСТУП"; value: h.access; horizontal-stretch: 1;
                        if h.locked: IconLock { width: 12px; height: 12px; tint: Theme.fg; }
                        if !h.locked: IconLockOpen { width: 12px; height: 12px; tint: Theme.fg; }
                    }
                    StatTile {
                        label: "ПРОТОКОЛ"; value: h.proto; horizontal-stretch: 1;
                        ProtoIcon { id: h.proto-id; width: 12px; height: 12px; tint: Theme.fg; }
                    }
                }
                if h.locked: Field { placeholder: "Пароль"; secure: true; text <=> root.guest-password; }
                GradientButton { title: "Подключить"; enabled: h.usable; clicked => { root.connect(root.index); } }
            }
        }
    }
}

export component VpnPage inherits Rectangle {
    in property <[HostRow]> hosts;
    in property <[string]> recent-names;   // подписи недавних чипов
    in property <[string]> recent-ids;
    in property <int> vpn-state;
    in property <string> vpn-status;
    in property <int> coord-state;
    in property <string> vpn-host-id;
    in property <string> vpn-sub;
    in property <string> vpn-ip;
    in property <string> vpn-guests;
    in property <string> vpn-proto;
    in property <string> vpn-proto-id;
    in property <string> vpn-country;
    in property <string> vpn-elapsed;
    in property <int> host-count;
    /// Версия свежего релиза («1.6») или "" — плашки нет. Приходит от
    /// координатора уже с проверенной подписью, здесь только показ.
    in property <string> update-version;
    /// 0 — простаивает · 1 — качаю · 2 — готово, нужен перезапуск · 3 — ошибка
    in property <int> update-state;
    in property <string> update-error;
    property <bool> update-dismissed: false;
    in-out property <string> code;
    in-out property <string> guest-password;
    property <int> expanded: -1;
    property <bool> copied-invite: false;
    callback connect(int);
    // Карточку раскрыли — можно замерить отклик до этого хоста.
    callback expanded-host(int);
    callback connect-code();
    callback disconnect();
    callback paste();
    callback copy-text(string);
    callback open-invite();
    callback do-update();

    property <color> tint: vpn-state == 1 ? Theme.amber : vpn-state == 2 ? Theme.green : Theme.accent;

    invite-reset := Timer {
        interval: 1.3s;
        running: root.copied-invite;
        triggered() => { root.copied-invite = false; }
    }

    ScrollView {
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            alignment: start;
            padding: Theme.pad;
            padding-bottom: 108px;   // не под плавающим нав-баром (iOS navPadding 96)
            spacing: Theme.gap;

            // ── Свежий релиз ──
            // Тонкая полоса над героем: заметно, но не перекрывает работу и не
            // требует реакции. Крестик убирает её до следующего запуска —
            // навязываться обновлением неправильно, решает человек.
            if root.update-version != "" && !root.update-dismissed: Rectangle {
                border-radius: 14px;
                background: root.update-state == 3 ? Theme.red.with-alpha(0.12) : Theme.accent.with-alpha(0.12);
                border-width: 1px;
                border-color: root.update-state == 3 ? Theme.red.with-alpha(0.4) : Theme.accent.with-alpha(0.35);
                height: 46px;
                HorizontalLayout {
                    padding-left: 14px; padding-right: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                                text: root.update-state == 1 ? "Скачиваю " + root.update-version + "…"
                                    : root.update-state == 2 ? "Готово — перезапустите"
                                    : root.update-state == 3 ? root.update-error
                                    : "Версия " + root.update-version + " доступна";
                            color: root.update-state == 3 ? Theme.red : Theme.accent;
                            font-size: 13px; font-weight: 700; overflow: elide;
                        }
                    }
                    if root.update-state != 1 && root.update-state != 2: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 92px; height: 30px;
                            border-radius: 10px;
                            background: upd-ta.pressed ? Theme.accent2 : Theme.accent;
                            Text {
                                text: root.update-state == 3 ? "Ещё раз" : "Обновить";
                                color: white; font-size: 12px; font-weight: 700;
                                horizontal-alignment: center; vertical-alignment: center;
                                width: 100%; height: 100%;
                            }
                            upd-ta := TouchArea { clicked => { root.do-update(); } }
                        }
                    }
                    // Крестик рисуем ЛИНИЯМИ, а не символом: «✕» в системном
                    // шрифте отсутствовал и показывался пустым квадратом.
                    if root.update-state != 1: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 30px; height: 30px;
                            border-radius: 8px;
                            background: close-ta.has-hover ? Theme.card-sel : transparent;
                            IconClose { width: 13px; height: 13px; tint: Theme.dim; }
                            close-ta := TouchArea { clicked => { root.update-dismissed = true; } }
                        }
                    }
                }
            }

            // ── Герой-статус ──
            Rectangle {
                border-radius: 22px;
                background: @linear-gradient(180deg, Theme.panel 0%, Theme.card 100%);
                border-width: 1px;
                border-color: root.tint.with-alpha(0.2);
                VerticalLayout {
                    padding-top: 26px; padding-bottom: 26px;
                    padding-left: 18px; padding-right: 18px;
                    spacing: 12px;
                    HeroCircle {
                        tint: root.tint;
                        pulsing: root.vpn-state == 1;
                        glow: root.vpn-state == 2;
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                if root.vpn-state == 0: IconShieldSlash { width: 40px; height: 40px; tint: root.tint; hole: Theme.card; }
                                if root.vpn-state == 1: IconShield { width: 40px; height: 40px; tint: root.tint; }
                                if root.vpn-state == 2: IconShieldCheck { width: 40px; height: 40px; tint: root.tint; hole: Theme.card; }
                                if root.vpn-state == 3: IconShieldSlash { width: 40px; height: 40px; tint: Theme.red; hole: Theme.card; }
                            }
                        }
                    }
                    Text {
                        text: root.vpn-status;
                        color: Theme.fg; font-size: 21px; font-weight: 800;
                        horizontal-alignment: center; overflow: elide;
                    }
                    Text {
                        text: root.vpn-state == 2
                            ? (root.vpn-country + "  ·  " + root.vpn-proto)
                            : (root.vpn-sub != "" ? root.vpn-sub
                               : (root.host-count == 0 ? "Введите код сети или поднимите свой хост"
                                  : "Доступно хостов: " + root.host-count + " · выберите ниже или жмите «Старт»"));
                        color: Theme.dim; font-size: 13px;
                        horizontal-alignment: center; wrap: word-wrap;
                    }

                    // Подключено — время, плитки, приглашение.
                    if root.vpn-state == 2: VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: root.vpn-elapsed;
                            color: Theme.green; font-size: 15px; font-weight: 700;
                            font-family: "monospace"; horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            CopyTile { label: "IP ХОСТА"; value: root.vpn-ip; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                            StatTile {
                                label: "ГОСТЕЙ"; value: root.vpn-guests; horizontal-stretch: 1;
                                IconPeople { width: 12px; height: 12px; tint: Theme.fg; }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.dim.with-alpha(0.15); }
                        HorizontalLayout {
                            spacing: 8px;
                            // «Код сети» — копировать id.
                            // min/preferred-width: 0 — ОБЯЗАТЕЛЬНО: «Скопировано»
                            // длиннее «Код сети», и без этого ячейка на секунду
                            // раздувалась, толкая соседнюю. Ширину задаёт stretch
                            // (50/50), а не длина текста. Так же сделано в CardButton.
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                preferred-width: 0px;
                                clip: true;
                                height: 42px;
                                border-radius: 12px;
                                background: Theme.tile;
                                border-width: 1px;
                                border-color: root.copied-invite ? Theme.green.with-alpha(0.5) : #FFFFFF14;
                                HorizontalLayout {
                                    alignment: center; spacing: 6px;
                                    VerticalLayout { alignment: center;
                                        if !root.copied-invite: IconCopy { width: 13px; height: 13px; tint: Theme.accent; }
                                        if root.copied-invite: IconCheck { width: 13px; height: 13px; tint: Theme.green; }
                                    }
                                    Text {
                                        text: root.copied-invite ? "Скопировано" : "Код сети";
                                        color: root.copied-invite ? Theme.green : Theme.accent;
                                        font-size: 13px; font-weight: 700; vertical-alignment: center;
                                        overflow: elide; min-width: 0px;
                                    }
                                }
                                TouchArea { clicked => { root.copy-text(root.vpn-host-id); root.copied-invite = true; } }
                            }
                            // QR-код. Те же ограничения ширины — иначе половинки
                            // ряда перестают быть равными, когда меняется сосед.
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                                preferred-width: 0px;
                                clip: true;
                                height: 42px;
                                border-radius: 12px;
                                background: Theme.tile;
                                border-width: 1px;
                                border-color: #FFFFFF14;
                                HorizontalLayout {
                                    alignment: center; spacing: 6px;
                                    VerticalLayout { alignment: center; IconQr { width: 14px; height: 14px; tint: Theme.accent; } }
                                    Text { text: "QR-код"; color: Theme.accent; font-size: 13px; font-weight: 700; vertical-alignment: center; overflow: elide; min-width: 0px; }
                                }
                                TouchArea { clicked => { root.open-invite(); } }
                            }
                        }
                        Text { text: "Позвать друзей в эту же сеть"; color: Theme.dim; font-size: 11px; horizontal-alignment: center; }
                    }
                }
            }

            // ── Подключиться по коду ──
            SectionLabel { text: "Подключиться по коду"; }
            Rectangle {
                height: 54px;
                border-radius: 14px;
                background: Theme.card;
                HorizontalLayout {
                    padding: 5px;
                    spacing: 6px;
                    // Поле кода.
                    Rectangle {
                        horizontal-stretch: 1;
                        code-in := TextInput {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            vertical-alignment: center;
                            color: Theme.fg; font-size: 15px;
                            text <=> root.code;
                            single-line: true;
                            accepted => { root.connect-code(); }
                        }
                        if root.code == "": Text {
                            x: 12px; height: parent.height;
                            text: "КОД СЕТИ"; color: Theme.dim; font-size: 15px; vertical-alignment: center;
                        }
                    }
                    // Вставить.
                    Rectangle {
                        width: 44px; height: 44px;
                        border-radius: 10px;
                        background: #2E3B57;
                        VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconPaste { width: 18px; height: 18px; tint: white; } } }
                        TouchArea { clicked => { root.paste(); } }
                    }
                    // Перейти.
                    Rectangle {
                        width: 48px; height: 44px;
                        border-radius: 10px;
                        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
                        VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconArrowRight { width: 18px; height: 18px; tint: white; } } }
                        TouchArea { clicked => { root.connect-code(); } }
                    }
                }
            }

            // ── Недавние ──
            if root.recent-ids.length > 0: SectionLabel { text: "Недавние"; }
            if root.recent-ids.length > 0: HorizontalLayout {
                spacing: 8px;
                for name[i] in root.recent-names: Rectangle {
                    property <bool> hot: root.recent-ids[i] == root.vpn-host-id;
                    height: 38px;
                    border-radius: 16px;
                    background: hot ? Theme.accent.with-alpha(0.16) : Theme.card-sel;
                    border-width: 1px;
                    border-color: hot ? Theme.accent.with-alpha(0.5) : transparent;
                    HorizontalLayout {
                        padding-left: 13px; padding-right: 13px;
                        Text { text: name; color: hot ? Theme.accent : Theme.fg; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    }
                    TouchArea { clicked => { if (root.vpn-state == 0) { root.code = root.recent-ids[i]; root.connect-code(); } } }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            // ── Хосты ──
            SectionLabel { text: "Хосты"; }
            // Связь с сервером потеряна, а список НЕ пуст: цифры и состав хостов
            // ниже — последние известные, то есть могут врать. Молчать нельзя,
            // иначе устаревший список выглядит как живой.
            // Связь потеряна: полоса мягко ДЫШИТ — это и есть весь индикатор
            // процесса. Отдельной «крутилки» не нужно, движение само говорит,
            // что работа идёт и руками ничего делать не надо.
            if root.coord-state == 2 && root.hosts.length > 0: Rectangle {
                background: #3A2A15;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.amber;
                height: txt.preferred-height + 20px;
                property <bool> dim: false;
                opacity: dim ? 0.72 : 1.0;
                animate opacity { duration: 1100ms; easing: ease-in-out; }
                Timer {
                    interval: 1100ms;
                    running: true;
                    triggered => { parent.dim = !parent.dim; }
                }
                HorizontalLayout {
                    padding: 10px;
                    txt := Text {
                        text: "Нет связи с сервером — список ниже может устареть. Восстанавливаю связь…";
                        color: Theme.amber; font-size: 12px; wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }
            }
            if root.hosts.length == 0: Text {
                text: root.coord-state == 2
                    ? "Нет связи с сервером. Восстанавливаю…\nЕсли не проходит — проверьте адрес во вкладке «Сервер»."
                    : "Хостов пока нет.\nВведите код сети или поднимите свой во вкладке «Хост».";
                color: Theme.dim; font-size: 14px;
                horizontal-alignment: center; wrap: word-wrap;
            }
            for h[i] in root.hosts: HostCard {
                h: h;
                index: i;
                // Данные не живые — показываем это САМИМ СПИСКОМ, а не ещё одним
                // элементом: приглушённое читается как «неактуально» мгновенно
                // и без слов.
                opacity: root.coord-state == 2 ? 0.55 : 1.0;
                animate opacity { duration: 400ms; easing: ease-in-out; }
                expanded: root.expanded == i;
                guest-password <=> root.guest-password;
                toggle() => {
                    root.expanded = (root.expanded == i) ? -1 : i;
                    if (root.expanded == i) { root.expanded-host(i); }
                }
                connect(idx) => { root.connect(idx); }
                copy-text(t) => { root.copy-text(t); }
            }
        }
    }
}
