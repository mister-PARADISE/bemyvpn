// Вкладка «VPN» — герой-статус, подключение по коду, недавние, список хостов.
//
// Как и остальные вкладки: прижатая панель состояния вне прокрутки, всё
// остальное под ней. Панель адаптивная — когда подключено, круг уступает место
// цифрам (адрес хоста, гости, часы). Копирование кода сети и QR живут на нижней
// полке (app.slint), под большим пальцем.
import { Theme } from "theme.slint";
import { HostRow, Card, StatTile, PingTile, CopyTile, SectionLabel, Field,
         Badge, StatusLine, StateChip, ShareButton, CalmButton } from "components.slint";
import { IconShield, IconShieldCheck, IconShieldSlash, IconShieldLock, IconMask, IconLock, IconLockOpen,
         IconPeople, IconCopy, IconCheck, IconClose, IconQr, IconScan, IconPaste, IconArrowRight, IconChevronRight, IconChevronUp } from "icons.slint";
import { ScrollView } from "std-widgets.slint";

// Значок протокола по id — семейство щита.
component ProtoIcon inherits Rectangle {
    in property <string> id;
    in property <color> tint: Theme.dim;
    if id == "" || id == "noise" || id == "noise-aes": IconShieldLock { width: 100%; height: 100%; tint: root.tint; hole: Theme.card-hi; }
    if id == "noise-obfs": IconMask { width: 100%; height: 100%; tint: root.tint; }
    // ПУСТОЙ протокол — это «Обычный» (щит с замком), а не «без шифра»: хост
    // просто не объявил имя, канал всё равно шифрованный. Раньше он попадал в
    // последнюю ветку и рисовался перечёркнутым щитом — самый опасный из
    // возможных обманов. Последняя ветка ловит всё остальное незнакомое: пустое
    // место читалось бы как «тут ничего нет», а не как «мы это не опознали».
    if id != "" && id != "noise" && id != "noise-aes" && id != "noise-obfs": IconShieldSlash { width: 100%; height: 100%; tint: root.tint; hole: Theme.card-hi; }
}

// Карточка хоста: свёрнутый вид + раскрытие (детали + Подключить).
component HostCard inherits Rectangle {
    in property <HostRow> h;
    in property <bool> expanded: false;
    in-out property <string> guest-password;
    callback toggle();
    // ID хоста, а не номер строки: список пересобирается целиком на каждое
    // обновление каталога, и номер к моменту нажатия мог указывать на другой хост.
    callback connect(string);
    callback copy-text(string);
    border-radius: 16px;
    background: root.expanded ? Theme.card-hi : Theme.card;
    border-width: 1px;
    border-color: root.expanded ? Theme.accent.with-alpha(0.28) : #FFFFFF0D;
    animate background, border-color { duration: 200ms; easing: ease-in-out; }

    VerticalLayout {
        padding: 14px;
        spacing: 0px;

        // ── свёрнутая строка (тап раскрывает) ──
        header := TouchArea {
            clicked => { root.toggle(); }
            HorizontalLayout {
                spacing: 12px;
                // Флаг-аватарка слева.
                Rectangle {
                    width: 56px; height: 56px;
                    border-radius: 14px;
                    background: Theme.tile;
                    border-width: 1px;
                    border-color: #FFFFFF14;
                    if h.has-flag: Image { source: h.flag-img; width: 34px; height: 24px; }
                    if !h.has-flag: Text { text: "🌍"; font-size: 26px; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 5px;
                    horizontal-stretch: 1;
                    // ЗНАЧОК ПРОТОКОЛА — В СТРОКЕ ИМЕНИ, ПЕРЕД НИМ.
                    //
                    // Значок есть У КАЖДОГО протокола: раньше он был только у
                    // «Маскировки», и его отсутствие означало сразу две
                    // противоположные вещи — «Обычный» (шифр есть) и «Без
                    // шифра» (шифра нет). Хуже всего доставалось опасному
                    // случаю: незащищённый хост выглядел в списке ровно как
                    // защищённый.
                    //
                    // Стоял он в строке ПОДПИСИ, под именем; теперь — рядом с
                    // самим именем, потому что защита относится к хосту, а не к
                    // счётчику гостей. Первым, а не в хвосте: у значка ширина
                    // фиксированная, у имени — сжимаемая (overflow: elide), и
                    // узкое окно ужимает именно имя. Значок в хвосте прижимался
                    // бы к огрызку имени; слева же значки выстраиваются в ровный
                    // столбец, а многоточие съедает хвост имени — как ему и
                    // положено.
                    HorizontalLayout {
                        spacing: 5px;
                        VerticalLayout {
                            alignment: center;   // иначе значок липнет к верху строки
                            ProtoIcon { id: h.proto-id; width: 14px; height: 14px; }
                        }
                        Text {
                            text: h.name; color: Theme.fg; font-size: 16px; font-weight: 600;
                            overflow: elide; min-width: 0px; vertical-alignment: center;
                        }
                    }
                    // Подпись: страна и гости. Значка здесь больше нет — он
                    // переехал к имени.
                    Text { text: h.subtitle; color: Theme.dim; font-size: 13px; overflow: elide; }
                    // Полоса заполненности.
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: #FFFFFF17;
                        Rectangle {
                            x: 0;
                            width: parent.width * h.fill;
                            height: 3px;
                            border-radius: 1.5px;
                            background: h.fill < 0.8 ? Theme.green : Theme.amber;
                        }
                    }
                }
                if h.locked: VerticalLayout { alignment: center; IconLock { width: 15px; height: 15px; tint: Theme.dim; } }
                VerticalLayout {
                    alignment: center;
                    if !root.expanded: IconChevronRight { width: 15px; height: 15px; tint: Theme.dim; }
                    if root.expanded: IconChevronUp { width: 15px; height: 15px; tint: Theme.dim; }
                }
            }
        }

        // ── детали (раскрыто) — АНИМИРОВАННОЕ раскрытие по высоте ──
        // clip + анимация height от 0 до реальной высоты содержимого.
        Rectangle {
            clip: true;
            height: root.expanded ? detail.preferred-height : 0px;
            animate height { duration: 220ms; easing: ease-in-out; }
            detail := VerticalLayout {
                width: parent.width;
                padding-top: 12px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    CopyTile { label: "КОД"; value: h.code; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                    CopyTile { label: "IP"; value: h.ip; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile { label: "СТРАНА"; value: h.country; horizontal-stretch: 1; }
                    StatTile { label: "ГОСТЕЙ"; value: h.guests; horizontal-stretch: 1; }
                    PingTile { ping: h.ping; ms: h.ping-ms; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile {
                        label: "ДОСТУП"; value: h.access; horizontal-stretch: 1;
                        if h.locked: IconLock { width: 12px; height: 12px; tint: Theme.fg; }
                        if !h.locked: IconLockOpen { width: 12px; height: 12px; tint: Theme.fg; }
                    }
                    StatTile {
                        label: "ПРОТОКОЛ"; value: h.proto; horizontal-stretch: 1;
                        ProtoIcon { id: h.proto-id; width: 12px; height: 12px; tint: Theme.fg; }
                    }
                }
                if h.locked: Field { placeholder: "Пароль"; secure: true; text <=> root.guest-password; }
                // Та же спокойная кнопка, что и на остальных экранах — теперь
                // общий компонент, а не её копия здесь.
                CalmButton {
                    title: "Подключить";
                    enabled: h.usable;
                    clicked => { root.connect(root.h.id); }
                }
            }
        }
    }
}

export component VpnPage inherits Rectangle {
    in property <[HostRow]> hosts;
    in property <[string]> recent-names;   // подписи недавних чипов
    in property <[string]> recent-ids;
    in property <int> vpn-state;
    in property <string> vpn-status;
    in property <int> coord-state;
    in property <string> vpn-host-id;
    in property <string> vpn-sub;
    in property <string> vpn-ip;
    in property <string> vpn-guests;
    in property <string> vpn-proto;
    in property <string> vpn-proto-id;
    in property <string> vpn-country;
    in property <string> vpn-elapsed;
    in property <int> host-count;
    /// Версия свежего релиза («1.6») или "" — плашки нет. Приходит от
    /// координатора уже с проверенной подписью, здесь только показ.
    in property <string> update-version;
    /// 0 — простаивает · 1 — качаю · 2 — готово, нужен перезапуск · 3 — ошибка
    in property <int> update-state;
    in property <string> update-error;
    in-out property <string> code;
    in-out property <string> guest-password;
    // Раскрытая карточка помнится ПО ID, а не по номеру строки. Номер переживал
    // пересборку списка: состав менялся — и раскрытой оказывалась карточка
    // другого хоста, а замер отклика продолжал мерить прежний.
    property <string> expanded: "";
    callback connect(string);
    // Карточку раскрыли — можно замерить отклик до этого хоста ("" = свернули).
    callback expanded-host(string);
    callback connect-code();
    callback disconnect();
    callback paste();
    callback copy-text(string);
    callback do-update();
    callback show-qr(string);

    property <color> tint: vpn-state == 1 ? Theme.amber : vpn-state == 2 ? Theme.green : vpn-state == 3 ? Theme.red : Theme.accent;

    VerticalLayout {
        // ── ПРИЖАТАЯ ПАНЕЛЬ ──────────────────────────────────────────────────
        // Вне ScrollView — не уезжает при прокрутке. Тень отделяет её от
        // содержимого, которое под неё уходит.
        Rectangle {
            // Панель занимает РОВНО столько, сколько нужно содержимому: без
            // этого Slint отдавал ей всё свободное место, и она растягивалась
            // на пол-экрана, разгоняя строки друг от друга.
            vertical-stretch: 0;
            height: panel-box.preferred-height;
            background: Theme.bg;
            drop-shadow-blur: 14px;
            drop-shadow-color: #000000AA;
            drop-shadow-offset-y: 8px;
            panel-box := VerticalLayout {
                padding: Theme.pad;
                padding-bottom: 12px;
                Rectangle {
                    border-radius: 22px;
                    background: @linear-gradient(180deg, Theme.panel 0%, Theme.card 100%);
                    border-width: 1px;
                    border-color: root.tint.with-alpha(0.2);
                    VerticalLayout {
                        alignment: start;   // иначе строки разъезжаются по высоте
                        padding-top: 16px; padding-bottom: 18px;
                        padding-left: 18px; padding-right: 18px;
                        spacing: 8px;

                        // ── подключено: значок компактный, место отдано пользе ──
                        if root.vpn-state == 2: StatusLine {
                            name: "Подключено";
                            clock: root.vpn-elapsed;
                            tint: root.tint;
                            IconShieldCheck { width: 19px; height: 19px; tint: root.tint; hole: Theme.panel; }
                        }
                        if root.vpn-state == 2: Text {
                            text: root.vpn-country + "  ·  " + root.vpn-proto;
                            color: Theme.dim; font-size: 13px;
                        }
                        if root.vpn-state == 2: HorizontalLayout {
                            spacing: 8px;
                            CopyTile { label: "IP ХОСТА"; value: root.vpn-ip; horizontal-stretch: 1; copy(t) => { root.copy-text(t); } }
                            StatTile {
                                label: "ГОСТЕЙ"; value: root.vpn-guests; horizontal-stretch: 1;
                                IconPeople { width: 12px; height: 12px; tint: Theme.fg; }
                            }
                        }
                        // Поделиться сетью — В НИЗУ панели, прямо под тем, что
                        // копируют. Отдельной полкой у нав-бара кнопки
                        // оторвались бы от своего кода.
                        if root.vpn-state == 2: HorizontalLayout {
                            spacing: 8px;
                            padding-top: 2px;
                            ShareButton {
                                title: "Скопировать"; feedback: true; horizontal-stretch: 1;
                                clicked => { root.copy-text(root.vpn-host-id); }
                                IconCopy { width: 17px; height: 17px; tint: Theme.accent; }
                            }
                            ShareButton {
                                title: "QR-код"; horizontal-stretch: 1;
                                clicked => { root.show-qr(root.vpn-host-id); }
                                IconQr { width: 17px; height: 17px; tint: Theme.accent; }
                            }
                        }
                        Text { text: root.vpn-state == 2 ? "Позвать друзей в эту же сеть" : ""; visible: root.vpn-state == 2;
                               color: Theme.dim; font-size: 11px; horizontal-alignment: center; }

                        // ── не подключено: крупный круг ──
                        if root.vpn-state != 2: Rectangle {
                            height: 74px;
                            // Волна расходится, пока идёт пробитие.
                            if root.vpn-state == 1: Rectangle {
                                property <float> t: Math.mod(animation-tick() / 1ms, 1200) / 1200;
                                property <length> d: 72px * (1 + 0.28 * self.t);
                                x: (parent.width - self.d) / 2;
                                y: (74px - self.d) / 2;
                                width: self.d; height: self.d;
                                border-radius: self.d / 2;
                                border-width: 2px;
                                border-color: root.tint.with-alpha(0.5 * (1 - self.t));
                            }
                            Rectangle {
                                x: (parent.width - 72px) / 2;
                                y: 1px;
                                width: 72px; height: 72px;
                                border-radius: 36px;
                                background: root.tint.with-alpha(0.13);
                                border-width: 1px;
                                border-color: root.tint.with-alpha(0.3);
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        if root.vpn-state == 0: IconShieldSlash { width: 32px; height: 32px; tint: root.tint; hole: Theme.card; }
                                        if root.vpn-state == 1: IconShield { width: 32px; height: 32px; tint: root.tint; }
                                        if root.vpn-state == 3: IconShieldSlash { width: 32px; height: 32px; tint: Theme.red; hole: Theme.card; }
                                    }
                                }
                            }
                        }
                        if root.vpn-state != 2: Text {
                            text: root.vpn-status;
                            color: Theme.fg; font-size: 21px; font-weight: 800;
                            horizontal-alignment: center; overflow: elide;
                        }
                        if root.vpn-state != 2: Text {
                            text: root.vpn-sub != "" ? root.vpn-sub
                                : (root.host-count == 0 ? "Введите код сети или поднимите свой хост"
                                   : "Доступно хостов: " + root.host-count + " · выберите ниже или жмите «Старт»");
                            color: Theme.dim; font-size: 13px;
                            horizontal-alignment: center; wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── ПРОКРУЧИВАЕМОЕ ──────────────────────────────────────────────────
        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                alignment: start;
                padding: Theme.pad;
                padding-top: 2px;
                // Ниже плавают нав-бар и (при подключении) полка действий.
                padding-bottom: 108px;
                spacing: Theme.gap;

                // ── Свежий релиз ──
                // Крестика нет намеренно: это единственный канал про новую
                // версию, и спрятав его, человек больше о ней не узнает.
                if root.update-version != "": Rectangle {
                    border-radius: 14px;
                    background: root.update-state == 3 ? Theme.red.with-alpha(0.09) : Theme.accent.with-alpha(0.09);
                    border-width: 1px;
                    border-color: root.update-state == 3 ? Theme.red.with-alpha(0.3) : Theme.accent.with-alpha(0.28);
                    height: 62px;
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 14px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.update-state == 1 ? "Скачиваю " + root.update-version + "…"
                                    : root.update-state == 2 ? "Готово — закрываю и обновляю"
                                    : root.update-state == 3 ? root.update-error
                                    : "Версия " + root.update-version + " доступна";
                                color: root.update-state == 3 ? Theme.red : Theme.accent;
                                font-size: 13px; font-weight: 700; wrap: word-wrap;
                            }
                        }
                        // Пока качаем или готовимся закрыться — кнопки нет:
                        // решение уже принято, жать больше не на что.
                        if root.update-state != 1 && root.update-state != 2: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                // Зелёная: обновиться — действие хорошее, а не
                                // тревожное. При ошибке — в цвете ошибки, иначе
                                // читалась бы как чужая деталь.
                                property <color> hue: root.update-state == 3 ? Theme.red : Theme.green;
                                width: 116px; height: 38px;
                                border-radius: 11px;
                                background: upd-ta.has-hover ? self.hue.with-alpha(0.23) : self.hue.with-alpha(0.14);
                                border-width: 1px;
                                border-color: self.hue.with-alpha(0.4);
                                Text {
                                    text: root.update-state == 3 ? "Ещё раз" : "Обновить";
                                    color: parent.hue; font-size: 13px; font-weight: 700;
                                    horizontal-alignment: center; vertical-alignment: center;
                                    width: 100%; height: 100%;
                                }
                                upd-ta := TouchArea { clicked => { root.do-update(); } }
                            }
                        }
                    }
                }

                // ── Подключиться по коду ──
                SectionLabel { text: "Подключиться по коду"; }
                Rectangle {
                    height: 54px;
                    border-radius: 14px;
                    background: Theme.card;
                    HorizontalLayout {
                        padding: 5px;
                        spacing: 6px;
                        // Поле кода.
                        Rectangle {
                            horizontal-stretch: 1;
                            code-in := TextInput {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                vertical-alignment: center;
                                color: Theme.fg; font-size: 15px;
                                text <=> root.code;
                                single-line: true;
                                accepted => { root.connect-code(); }
                            }
                            if root.code == "": Text {
                                x: 12px; height: parent.height;
                                text: "КОД СЕТИ"; color: Theme.dim; font-size: 15px; vertical-alignment: center;
                            }
                        }
                        // Вставить — второстепенное действие, поэтому тихое.
                        Rectangle {
                            width: 44px; height: 44px;
                            border-radius: 10px;
                            background: paste-ta.has-hover ? #333D52 : #2A3244;
                            border-width: 1px;
                            border-color: #FFFFFF14;
                            VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconPaste { width: 18px; height: 18px; tint: Theme.dim; } } }
                            paste-ta := TouchArea { clicked => { root.paste(); } }
                        }
                        // Перейти. Подкраска вместо сплошного синего: он спорил
                        // с акцентом всего экрана. Стрелка крупнее соседней —
                        // здесь она главная.
                        Rectangle {
                            width: 52px; height: 44px;
                            border-radius: 10px;
                            background: go-ta.has-hover ? Theme.accent.with-alpha(0.28) : Theme.accent.with-alpha(0.16);
                            border-width: 1px;
                            border-color: Theme.accent.with-alpha(0.4);
                            VerticalLayout { alignment: center; HorizontalLayout { alignment: center; IconArrowRight { width: 22px; height: 22px; tint: Theme.accent; } } }
                            go-ta := TouchArea { clicked => { root.connect-code(); } }
                        }
                    }
                }

                // ── Недавние ──
                if root.recent-ids.length > 0: SectionLabel { text: "Недавние"; }
                if root.recent-ids.length > 0: HorizontalLayout {
                    spacing: 8px;
                    for name[i] in root.recent-names: Rectangle {
                        property <bool> hot: root.recent-ids[i] == root.vpn-host-id;
                        height: 38px;
                        border-radius: 16px;
                        background: hot ? Theme.accent.with-alpha(0.16) : Theme.card-sel;
                        border-width: 1px;
                        border-color: hot ? Theme.accent.with-alpha(0.5) : transparent;
                        HorizontalLayout {
                            padding-left: 13px; padding-right: 13px;
                            Text { text: name; color: hot ? Theme.accent : Theme.fg; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { if (root.vpn-state == 0) { root.code = root.recent-ids[i]; root.connect-code(); } } }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // ── Хосты ──
                // Связь потеряна, а список НЕ пуст: цифры ниже — последние
                // известные, то есть могут врать. Раньше об этом кричала
                // оранжевая полоса во всю ширину, которая ещё и дышала,
                // перетягивая взгляд с самого списка. Теперь причину называет
                // тихий знак у заголовка, а «неактуально» говорит сам список —
                // приглушением. Где искать поломку, показывает точка на ячейке
                // «Сервер» в нав-баре, видная с любой вкладки.
                HorizontalLayout {
                    spacing: 8px;
                    SectionLabel { text: "Хосты"; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    if root.coord-state == 2 && root.hosts.length > 0: StateChip { text: "последние известные"; }
                }
                if root.hosts.length == 0: Text {
                    text: root.coord-state == 2
                        ? "Нет связи с сервером. Восстанавливаю…\nЕсли не проходит — проверьте адрес во вкладке «Сервер»."
                        : "Хостов пока нет.\nВведите код сети или поднимите свой во вкладке «Хост».";
                    color: Theme.dim; font-size: 14px;
                    horizontal-alignment: center; wrap: word-wrap;
                }
                for h in root.hosts: HostCard {
                    h: h;
                    // Данные не живые — показываем это САМИМ СПИСКОМ: приглушённое
                    // читается как «неактуально» мгновенно и без слов.
                    opacity: root.coord-state == 2 ? 0.55 : 1.0;
                    animate opacity { duration: 400ms; easing: ease-in-out; }
                    expanded: root.expanded == h.id;
                    guest-password <=> root.guest-password;
                    toggle() => {
                        root.expanded = (root.expanded == h.id) ? "" : h.id;
                        // Шлём ВСЕГДА, в том числе "" при сворачивании: замер отклика
                        // идёт циклом, пока карточка открыта, и без сигнала о закрытии
                        // его нечем было бы остановить.
                        root.expanded-host(root.expanded);
                    }
                    connect(id) => { root.connect(id); }
                    copy-text(t) => { root.copy-text(t); }
                }
            }
        }
    }
}
