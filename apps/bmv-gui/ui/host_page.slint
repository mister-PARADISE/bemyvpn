// Вкладка «Хост» — раздача своего интернета.
//
// Экран разделён на ДВЕ части: прижатая к верху панель состояния (вне прокрутки)
// и прокручиваемые настройки под ней. Панель адаптивная:
//
//   • раздача выключена → крупный круг, заголовок, подсказка. Показывать нечего,
//     и круг честно занимает место — это единственный смысл экрана;
//   • раздача идёт → круг становится компактным значком, а место занимает польза:
//     код сети, гости, видимость, протокол, свой адрес.
//
// Код сети НЕ показывается, пока раздача выключена: давать его некому.
// Копирование и QR живут на нижней полке (app.slint) — под большим пальцем.
import { Theme } from "theme.slint";
import { Card, StatTile, CopyTile, CardButton, SectionLabel, Field, BigChip,
         Badge, StatusLine, BigCode, QuietButton, ShareButton } from "components.slint";
import { IconRouter, IconRenew, IconCopy, IconQr, IconGlobe, IconEyeOff, IconPeople, IconWarning,
         IconShieldLock, IconMask, IconShieldSlash } from "icons.slint";
import { ScrollView, Slider } from "std-widgets.slint";

component ProtoChipIcon inherits Rectangle {
    in property <string> id;
    in property <bool> on: false;
    // Выбранный — акцентом, а не белым по градиенту: чипы стали спокойными
    // (подкраска + рамка), и белый значок на светлой подкраске пропадал бы.
    property <color> tint: on ? Theme.accent : Theme.dim;
    if id == "noise": IconShieldLock { width: 100%; height: 100%; tint: root.tint; hole: Theme.card; }
    if id == "noise-obfs": IconMask { width: 100%; height: 100%; tint: root.tint; }
    if id == "plain": IconShieldSlash { width: 100%; height: 100%; tint: root.tint; hole: Theme.card; }
}

export component HostPage inherits Rectangle {
    in property <int> host-state;        // 0 выкл · 1 запускаюсь · 2 раздаю · 3 ошибка
    in property <string> host-status;
    in property <string> host-code;
    in property <string> host-error;
    in property <string> host-ip;
    in property <string> host-guests;
    in property <string> host-elapsed;
    in-out property <string> host-name;
    in-out property <bool> host-public: true;
    in-out property <int> host-max: 8;
    in-out property <string> host-password;
    in-out property <string> host-protocol: "noise-obfs";  // «Маскировка» — дефолт проекта
    callback toggle();
    callback copy-code();
    callback copy-text(string);
    callback new-code();
    callback apply-host();
    callback open-qr();

    // С паролем сеть ВСЕГДА скрытая — правило ядра и координатора.
    property <bool> locked-hidden: root.host-password != "";
    property <color> tint:
        root.host-state == 1 ? Theme.amber
        : root.host-state == 2 ? Theme.green
        : root.host-state == 3 ? Theme.red
        : Theme.accent;
    property <string> proto-name:
        root.host-protocol == "noise" ? "Обычный"
        : root.host-protocol == "noise-obfs" ? "Маскировка"
        : "Без шифра";

    VerticalLayout {
        // ── ПРИЖАТАЯ ПАНЕЛЬ ──────────────────────────────────────────────────
        // Лежит ВНЕ ScrollView, поэтому не уезжает при прокрутке. Отделяет её
        // от содержимого собственная рамка и градиент, а не тень: тень тут была
        // лишним блоком.
        Rectangle {
            // Панель занимает РОВНО столько, сколько нужно содержимому: без
            // этого Slint отдавал ей всё свободное место, и она растягивалась
            // на пол-экрана, разгоняя строки друг от друга.
            vertical-stretch: 0;
            height: panel-box.preferred-height;
            // Подложка РОВНО цвета страницы и БЕЗ тени. Тень рисовала под
            // панелью тёмную прямоугольную полосу во всю ширину, и рядом со
            // скруглённой карточкой она читалась как второй, лишний «блок»
            // позади шапки. Убрать подложку совсем нельзя: это она не даёт
            // прокручиваемому тексту просвечивать в зазорах по бокам карточки.
            // Совпадая с фоном страницы, подложка невидима, а панель остаётся
            // отдельным компонентом за счёт градиента и рамки в цвет состояния.
            background: Theme.bg;
            panel-box := VerticalLayout {
                padding: Theme.pad;
                padding-bottom: 12px;
                Rectangle {
                    border-radius: 22px;
                    background: @linear-gradient(180deg, Theme.panel 0%, Theme.card 100%);
                    border-width: 1px;
                    border-color: root.tint.with-alpha(0.2);
                    VerticalLayout {
                        alignment: start;   // иначе строки разъезжаются по высоте
                        padding-top: 16px; padding-bottom: 18px;
                        padding-left: 18px; padding-right: 18px;
                        spacing: 8px;

                        // ── раздача идёт: значок компактный, место отдано пользе ──
                        if root.host-state == 2: StatusLine {
                            name: "Раздаю";
                            clock: root.host-elapsed;
                            tint: root.tint;
                            IconRouter { width: 19px; height: 19px; tint: root.tint; }
                        }
                        if root.host-state == 2: BigCode { text: root.host-code == "" ? "…" : root.host-code; }
                        // «Новый код» — действие редкое, ему хватает строчки наверху.
                        // Частое (копировать, QR) живёт на нижней полке, у пальца.
                        if root.host-state == 2: QuietButton {
                            title: "Новый код";
                            feedback: true;
                            clicked => { root.new-code(); }
                            IconRenew { width: 13px; height: 13px; tint: Theme.dim; }
                        }
                        if root.host-state == 2: HorizontalLayout {
                            spacing: 8px;
                            StatTile {
                                label: "ГОСТЕЙ"; value: root.host-guests; horizontal-stretch: 1;
                                IconPeople { width: 12px; height: 12px; tint: Theme.fg; }
                            }
                            StatTile {
                                label: "ВИДИМОСТЬ";
                                value: (root.host-public && !root.locked-hidden) ? "публичный" : "по коду";
                                horizontal-stretch: 1;
                                if root.host-public && !root.locked-hidden: IconGlobe { width: 12px; height: 12px; tint: Theme.fg; }
                                if !(root.host-public && !root.locked-hidden): IconEyeOff { width: 12px; height: 12px; tint: Theme.fg; }
                            }
                        }
                        if root.host-state == 2: HorizontalLayout {
                            spacing: 8px;
                            StatTile {
                                label: "ПРОТОКОЛ"; value: root.proto-name; horizontal-stretch: 1;
                                ProtoChipIcon { id: root.host-protocol; width: 12px; height: 12px; }
                            }
                            CopyTile {
                                label: "ВАШ IP"; value: root.host-ip == "" ? "—" : root.host-ip;
                                horizontal-stretch: 1;
                                copy(t) => { root.copy-text(t); }
                            }
                        }
                        // Поделиться кодом — В НИЗУ панели, прямо под самим кодом.
                        if root.host-state == 2: HorizontalLayout {
                            spacing: 8px;
                            padding-top: 2px;
                            ShareButton {
                                title: "Скопировать"; feedback: true; horizontal-stretch: 1;
                                clicked => { root.copy-code(); }
                                IconCopy { width: 17px; height: 17px; tint: Theme.accent; }
                            }
                            ShareButton {
                                title: "QR-код"; horizontal-stretch: 1;
                                clicked => { root.open-qr(); }
                                IconQr { width: 17px; height: 17px; tint: Theme.accent; }
                            }
                        }

                        // ── не раздаём: показывать нечего, кроме статуса ──
                        if root.host-state != 2: Rectangle {
                            height: 74px;
                            // Волна расходится, пока идёт запуск.
                            if root.host-state == 1: Rectangle {
                                property <float> t: Math.mod(animation-tick() / 1ms, 1200) / 1200;
                                property <length> d: 72px * (1 + 0.28 * self.t);
                                x: (parent.width - self.d) / 2;
                                y: (74px - self.d) / 2;
                                width: self.d; height: self.d;
                                border-radius: self.d / 2;
                                border-width: 2px;
                                border-color: root.tint.with-alpha(0.5 * (1 - self.t));
                            }
                            Rectangle {
                                x: (parent.width - 72px) / 2;
                                y: 1px;
                                width: 72px; height: 72px;
                                border-radius: 36px;
                                background: root.tint.with-alpha(0.13);
                                border-width: 1px;
                                border-color: root.tint.with-alpha(0.3);
                                HorizontalLayout {
                                    alignment: center;
                                    VerticalLayout {
                                        alignment: center;
                                        IconRouter { width: 32px; height: 32px; tint: root.tint; }
                                    }
                                }
                            }
                        }
                        if root.host-state != 2: Text {
                            text: root.host-state == 1 ? "Запускаюсь…"
                                : root.host-state == 3 ? "Не удалось начать раздачу"
                                : "Раздача выключена";
                            color: Theme.fg; font-size: 21px; font-weight: 800;
                            horizontal-alignment: center; overflow: elide;
                        }
                        if root.host-state != 2: Text {
                            text: root.host-state == 1 ? "Пробиваю канал наружу…"
                                : root.host-state == 3 ? (root.host-error != "" ? root.host-error : "Попробуйте ещё раз")
                                : "Станьте выходной точкой для друзей";
                            color: Theme.dim; font-size: 13px;
                            horizontal-alignment: center; wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // ── ПРОКРУЧИВАЕМЫЕ НАСТРОЙКИ ────────────────────────────────────────
        ScrollView {
            vertical-stretch: 1;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            VerticalLayout {
                alignment: start;
                padding: Theme.pad;
                padding-top: 2px;
                // Ниже плавают нав-бар и полка действий — оставляем им место.
                padding-bottom: 108px;
                spacing: Theme.gap;

                if root.host-error != "" && root.host-state != 3: HorizontalLayout {
                    spacing: 5px;
                    VerticalLayout { alignment: center; IconWarning { width: 15px; height: 15px; tint: Theme.red; } }
                    Text { text: root.host-error; color: Theme.red; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
                }

                Text {
                    text: "Раздайте свой интернет: этот компьютер станет выходной точкой для гостей.";
                    color: Theme.dim; font-size: 13px; wrap: word-wrap;
                }

                // Имя хоста.
                SectionLabel { text: "Имя хоста (видно в каталоге)"; }
                Field { placeholder: "Имя"; text <=> root.host-name; edited => { root.apply-host(); } }

                // Видимость. С паролем «Публичный» не просто выключен, а НЕДОСТУПЕН:
                // иначе кнопка врала бы, ничего не меняя.
                SectionLabel { text: "Видимость"; }
                HorizontalLayout {
                    spacing: 8px;
                    BigChip { name: "Публичный"; on: root.host-public && !root.locked-hidden; horizontal-stretch: 1;
                        opacity: root.locked-hidden ? 0.4 : 1.0;
                        clicked => { if (!root.locked-hidden) { root.host-public = true; root.apply-host(); } }
                        IconGlobe { width: 20px; height: 20px; tint: (root.host-public && !root.locked-hidden) ? Theme.accent : Theme.dim; } }
                    BigChip { name: "Скрытый"; on: !root.host-public || root.locked-hidden; horizontal-stretch: 1;
                        clicked => { root.host-public = false; root.apply-host(); }
                        IconEyeOff { width: 20px; height: 20px; tint: (!root.host-public || root.locked-hidden) ? Theme.accent : Theme.dim; } }
                }
                Text {
                    text: root.locked-hidden
                        ? "С паролем сеть всегда скрытая: публичная карточка выдала бы её тем, от кого вы закрылись. Подключение — по коду."
                        : root.host-public ? "Виден всем в списке хостов — подключиться сможет любой." : "В списке не виден — подключиться можно только по коду.";
                    color: Theme.dim; font-size: 12px; wrap: word-wrap;
                }

                // Лимит гостей.
                HorizontalLayout {
                    Text { text: "Лимит гостей"; color: Theme.dim; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.host-max; color: Theme.accent; font-size: 17px; font-weight: 800; font-family: "monospace"; }
                }
                Slider {
                    minimum: 1; maximum: 256; value: root.host-max;
                    changed(v) => { root.host-max = Math.round(v); }
                    released(v) => { root.host-max = Math.round(v); root.apply-host(); }
                }
                HorizontalLayout {
                    spacing: 6px;
                    // Тот же спокойный приём, что и у кнопок с чипами: выбранное
                    // значение — подкраска + рамка + цветная цифра. Сплошная
                    // синяя плашка на шести кнопках подряд кричала громче, чем
                    // стоит выбор числа.
                    for v in [4, 8, 16, 32, 64, 128]: Rectangle {
                        height: 34px;
                        horizontal-stretch: 1;
                        border-radius: 10px;
                        background: root.host-max == v ? Theme.accent.with-alpha(0.15) : Theme.card-sel;
                        border-width: 1px;
                        border-color: root.host-max == v ? Theme.accent.with-alpha(0.4) : transparent;
                        Text { text: v; color: root.host-max == v ? Theme.accent : Theme.dim; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.host-max = v; root.apply-host(); } }
                    }
                }

                // Пароль.
                SectionLabel { text: "Пароль (пусто = без пароля)"; }
                Field { placeholder: "без пароля"; text <=> root.host-password; edited => { root.apply-host(); } }

                // Протокол.
                SectionLabel { text: "Протокол"; }
                HorizontalLayout {
                    spacing: 8px;
                    BigChip { name: "Обычный"; on: root.host-protocol == "noise"; horizontal-stretch: 1; clicked => { root.host-protocol = "noise"; root.apply-host(); }
                        ProtoChipIcon { id: "noise"; on: root.host-protocol == "noise"; width: 18px; height: 18px; } }
                    BigChip { name: "Маскировка"; on: root.host-protocol == "noise-obfs"; horizontal-stretch: 1; clicked => { root.host-protocol = "noise-obfs"; root.apply-host(); }
                        ProtoChipIcon { id: "noise-obfs"; on: root.host-protocol == "noise-obfs"; width: 18px; height: 18px; } }
                    BigChip { name: "Без шифра"; on: root.host-protocol == "plain"; horizontal-stretch: 1; clicked => { root.host-protocol = "plain"; root.apply-host(); }
                        ProtoChipIcon { id: "plain"; on: root.host-protocol == "plain"; width: 18px; height: 18px; } }
                }
                Text {
                    text: root.host-protocol == "noise" ? "Надёжное шифрование. Подходит почти всем — оставьте, если не уверены."
                        : root.host-protocol == "noise-obfs" ? "Прячет сам факт VPN: провайдер видит просто случайные данные. Чуть медленнее."
                        : "Шифрования нет — провайдер видит весь трафик. Только для сети, которой доверяете.";
                    color: root.host-protocol == "plain" ? Theme.amber : Theme.dim; font-size: 12px; wrap: word-wrap;
                }

                Text {
                    text: "Раздача работает, пока открыто приложение или ваш ПК не уснул.";
                    color: Theme.dim; font-size: 12px; wrap: word-wrap;
                }
            }
        }
    }
}
