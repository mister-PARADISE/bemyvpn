// Вкладка «Хост» — построчный перенос iOS HostTab: заголовок, статус-карточка
// раздачи, код сети (Новый код / Код / QR), имя, видимость, лимит (слайдер +
// пресеты), пароль, протокол (чипы), кнопка «Стать хостом».
import { Theme } from "theme.slint";
import { Card, StatTile, CopyTile, CardButton, GradientButton, SectionLabel, Field, BigChip, Dot } from "components.slint";
import { IconRouter, IconRenew, IconCopy, IconQr, IconGlobe, IconEyeOff, IconPeople, IconWarning,
         IconShieldLock, IconMask, IconShieldSlash } from "icons.slint";
import { ScrollView, Slider } from "std-widgets.slint";

component ProtoChipIcon inherits Rectangle {
    in property <string> id;
    in property <bool> on: false;
    property <color> tint: on ? white : Theme.dim;
    if id == "noise": IconShieldLock { width: 100%; height: 100%; tint: root.tint; hole: on ? Theme.accent2 : Theme.card; }
    if id == "noise-obfs": IconMask { width: 100%; height: 100%; tint: root.tint; }
    if id == "plain": IconShieldSlash { width: 100%; height: 100%; tint: root.tint; hole: on ? Theme.accent2 : Theme.card; }
}

export component HostPage inherits Rectangle {
    in property <int> host-state;        // 0 выкл · 1 запускаюсь · 2 раздаю · 3 ошибка
    in property <string> host-status;
    in property <string> host-code;
    in property <string> host-error;
    in property <string> host-ip;
    in property <string> host-guests;
    in property <string> host-elapsed;
    in-out property <string> host-name;
    in-out property <bool> host-public: true;
    in-out property <int> host-max: 8;
    in-out property <string> host-password;
    in-out property <string> host-protocol: "noise";
    callback toggle();
    callback copy-code();
    callback copy-text(string);
    callback new-code();
    callback apply-host();
    callback open-qr();

    property <bool> active: host-state == 1 || host-state == 2;

    ScrollView {
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
        VerticalLayout {
            alignment: start;
            padding: Theme.pad;
            padding-bottom: 108px;
            spacing: Theme.gap;

            // Заголовок.
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout { alignment: center; IconRouter { width: 26px; height: 26px; tint: Theme.accent; } }
                Text { text: "Хост-режим"; color: Theme.fg; font-size: 26px; font-weight: 800; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: "Раздайте свой интернет: этот компьютер станет выходной точкой для гостей."; color: Theme.dim; font-size: 13px; wrap: word-wrap; }

            // Статус-карточка (когда раздаём/запускаемся).
            if root.active: Card {
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { alignment: center; Dot { fill: root.host-state == 1 ? Theme.amber : Theme.green; pulse: root.host-state == 2; } }
                    Text { text: root.host-state == 1 ? "Запускаюсь…" : "Раздаю"; color: Theme.fg; font-size: 15px; font-weight: 700; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.host-state == 2: VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        StatTile {
                            label: "ГОСТЕЙ"; value: root.host-guests; horizontal-stretch: 1;
                            IconPeople { width: 12px; height: 12px; tint: Theme.fg; }
                        }
                        StatTile { label: "РАЗДАЮ"; value: root.host-elapsed; tint: Theme.green; horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        StatTile {
                            label: "ВИДИМОСТЬ"; value: root.host-public ? "публичный" : "по коду"; horizontal-stretch: 1;
                            if root.host-public: IconGlobe { width: 12px; height: 12px; tint: Theme.fg; }
                            if !root.host-public: IconEyeOff { width: 12px; height: 12px; tint: Theme.fg; }
                        }
                        StatTile {
                            label: "ПРОТОКОЛ";
                            value: root.host-protocol == "noise" ? "Обычный" : root.host-protocol == "noise-obfs" ? "Маскировка" : "Без шифра";
                            horizontal-stretch: 1;
                            ProtoChipIcon { id: root.host-protocol; width: 12px; height: 12px; }
                        }
                    }
                    CopyTile { label: "ВАШ IP"; value: root.host-ip == "" ? "—" : root.host-ip; copy(t) => { root.copy-text(t); } }
                }
            }
            if root.host-error != "": HorizontalLayout {
                spacing: 5px;
                VerticalLayout { alignment: center; IconWarning { width: 15px; height: 15px; tint: Theme.red; } }
                Text { text: root.host-error; color: Theme.red; font-size: 13px; wrap: word-wrap; vertical-alignment: center; }
            }

            // Код сети.
            SectionLabel { text: "Код сети (поделитесь, чтобы к вам подключились)"; }
            Card {
                Text {
                    text: root.host-code == "" ? "…" : root.host-code;
                    color: Theme.accent; font-size: 28px; font-weight: 800;
                    font-family: "monospace"; letter-spacing: 2px;
                    horizontal-alignment: center;
                }
                CardButton { title: "Новый код"; clicked => { root.new-code(); } IconRenew { width: 15px; height: 15px; tint: Theme.accent; } }
                HorizontalLayout {
                    spacing: 8px;
                    CardButton { title: "Код"; feedback: true; horizontal-stretch: 1; clicked => { root.copy-code(); } IconCopy { width: 15px; height: 15px; tint: Theme.accent; } }
                    CardButton { title: "QR"; horizontal-stretch: 1; clicked => { root.open-qr(); } IconQr { width: 15px; height: 15px; tint: Theme.accent; } }
                }
            }

            // Имя хоста.
            SectionLabel { text: "Имя хоста (видно в каталоге)"; }
            Field { placeholder: "Имя"; text <=> root.host-name; edited => { root.apply-host(); } }

            // Видимость. С паролем сеть ВСЕГДА скрытая (правило ядра и
            // координатора) — поэтому «Публичный» тут не просто выключен,
            // а недоступен: иначе кнопка врала бы, ничего не меняя.
            SectionLabel { text: "Видимость"; }
            property <bool> locked-hidden: root.host-password != "";
            HorizontalLayout {
                spacing: 8px;
                BigChip { name: "Публичный"; on: root.host-public && !locked-hidden; horizontal-stretch: 1;
                    opacity: locked-hidden ? 0.4 : 1.0;
                    clicked => { if (!locked-hidden) { root.host-public = true; root.apply-host(); } }
                    IconGlobe { width: 20px; height: 20px; tint: (root.host-public && !locked-hidden) ? white : Theme.dim; } }
                BigChip { name: "Скрытый"; on: !root.host-public || locked-hidden; horizontal-stretch: 1; clicked => { root.host-public = false; root.apply-host(); }
                    IconEyeOff { width: 20px; height: 20px; tint: (!root.host-public || locked-hidden) ? white : Theme.dim; } }
            }
            Text {
                text: locked-hidden
                    ? "С паролем сеть всегда скрытая: публичная карточка выдала бы её тем, от кого вы закрылись. Подключение — по коду."
                    : root.host-public ? "Виден всем в списке хостов — подключиться сможет любой." : "В списке не виден — подключиться можно только по коду выше.";
                color: Theme.dim; font-size: 12px; wrap: word-wrap;
            }

            // Лимит гостей.
            HorizontalLayout {
                Text { text: "Лимит гостей"; color: Theme.dim; font-size: 13px; font-weight: 700; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.host-max; color: Theme.accent; font-size: 17px; font-weight: 800; font-family: "monospace"; }
            }
            Slider {
                minimum: 1; maximum: 256; value: root.host-max;
                changed(v) => { root.host-max = Math.round(v); }
                released(v) => { root.host-max = Math.round(v); root.apply-host(); }
            }
            HorizontalLayout {
                spacing: 6px;
                for v in [4, 8, 16, 32, 64, 128]: Rectangle {
                    height: 34px;
                    horizontal-stretch: 1;
                    border-radius: 10px;
                    background: root.host-max == v ? Theme.accent : Theme.card-sel;
                    Text { text: v; color: root.host-max == v ? white : Theme.dim; font-size: 13px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { root.host-max = v; root.apply-host(); } }
                }
            }

            // Пароль.
            SectionLabel { text: "Пароль (пусто = без пароля)"; }
            Field { placeholder: "без пароля"; text <=> root.host-password; edited => { root.apply-host(); } }

            // Протокол.
            SectionLabel { text: "Протокол"; }
            HorizontalLayout {
                spacing: 8px;
                BigChip { name: "Обычный"; on: root.host-protocol == "noise"; horizontal-stretch: 1; clicked => { root.host-protocol = "noise"; root.apply-host(); }
                    ProtoChipIcon { id: "noise"; on: root.host-protocol == "noise"; width: 18px; height: 18px; } }
                BigChip { name: "Маскировка"; on: root.host-protocol == "noise-obfs"; horizontal-stretch: 1; clicked => { root.host-protocol = "noise-obfs"; root.apply-host(); }
                    ProtoChipIcon { id: "noise-obfs"; on: root.host-protocol == "noise-obfs"; width: 18px; height: 18px; } }
                BigChip { name: "Без шифра"; on: root.host-protocol == "plain"; horizontal-stretch: 1; clicked => { root.host-protocol = "plain"; root.apply-host(); }
                    ProtoChipIcon { id: "plain"; on: root.host-protocol == "plain"; width: 18px; height: 18px; } }
            }
            Text {
                text: root.host-protocol == "noise" ? "Надёжное шифрование. Подходит почти всем — оставьте, если не уверены."
                    : root.host-protocol == "noise-obfs" ? "Прячет сам факт VPN: провайдер видит просто случайные данные. Чуть медленнее."
                    : "Шифрования нет — провайдер видит весь трафик. Только для сети, которой доверяете.";
                color: root.host-protocol == "plain" ? Theme.amber : Theme.dim; font-size: 12px; wrap: word-wrap;
            }

            // Главная кнопка.
            Rectangle {
                height: 54px;
                border-radius: 18px;
                background: root.active ? Theme.red : @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
                Text {
                    text: root.host-state == 1 ? "Запускаюсь…" : root.host-state == 2 ? "Остановить хостинг" : "Стать хостом";
                    color: white; font-size: 16px; font-weight: 700;
                    horizontal-alignment: center; vertical-alignment: center; width: 100%; height: 100%;
                }
                TouchArea { clicked => { root.toggle(); } }
            }
            Text { text: "Раздача работает, пока открыто приложение или ваш ПК не уснул."; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
        }
    }
}
