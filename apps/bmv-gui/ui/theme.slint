// Дизайн-токены — ЕДИНСТВЕННОЕ место цветов и метрик. Палитра — байт-в-байт
// iOS Theme.swift (эталон вида). Меняешь тему — меняешь здесь.
export global Theme {
    // ── ЛЕСТНИЦА ПОВЕРХНОСТЕЙ: ЧЕТЫРЕ СТУПЕНИ, А НЕ ОДИННАДЦАТЬ ──
    //
    // Замер по снимкам давал одиннадцать разных подложек, и порядок в них был
    // нарушен: парящая панель оказывалась ТЕМНЕЕ карточки под ней — оттого и не
    // парила. Ступеней теперь ровно четыре, и каждая значит одно:
    // ЦВЕТНОСТЬ, А НЕ СЕРОСТЬ. Ступени были почти нейтрально-серыми (насыщенность
    // 26–30% при фоне в 29%), и рядом с фоном читались как грязь: у страницы
    // синева есть, у карточек — нет. Насыщенность поднята до 39–45% при ТОЙ ЖЕ
    // светлоте: контраст подписей зависит только от яркости, поэтому цветность
    // можно добавлять даром. Тон оставлен фоновый (220°) — это тот же цвет, что
    // хвалили, только живой.
    //
    // ШАГИ РАЗВЕДЕНЫ. Между s2 и float было 0.99 по CIE L* — глаз такой ступени
    // не видит, обе поверхности выглядели «никак». Теперь 3.0 / 2.5 / 2.4.
    // Потолок держит подпись: dim на плитке = 5.37 (было 5.34, ниже нельзя).
    out property <color> bg: #0B0E14;         // s0 — страница        L* 3.9
    out property <color> card: #121C2F;       // s1 — карточка списка, поле, кнопка «поделиться»  L* 10.3
    out property <color> card-hi: #172238;    // s2 — раскрытая карточка, выбранное, чип          L* 13.3
    out property <color> tile: #1F2C47;       // s3 — плитка внутри панели/карточки               L* 18.1
    // Парящее (панель состояния и нав-бар) — НАМЕРЕННО между s2 и s3: выше
    // карточек, но ниже плиток, которые лежат внутри него.
    out property <color> float-bg: #1B2740;   // L* 15.8

    // Подсветки при наведении здесь НЕТ: она производная от ступени
    // (`.brighter(0.12)`), а не отдельный цвет. Отдельный расходится с базой при
    // первой же правке темы.

    out property <color> accent: #7BA6F0;
    out property <color> fg: #EAECEF;
    out property <color> dim: #99A1B4;
    out property <color> green: #34E29E;
    out property <color> red: #F2707E;
    out property <color> amber: #F5B14C;

    out property <length> pad: 20px;     // отступ страницы (iOS .padding(20))
    out property <length> gap: 14px;     // зазор секций (iOS spacing: 14)
    /// Ширина завесы под парящим блоком (FloatCard). Отступы прокрутки на
    /// страницах считаются ОТ НЕЁ: покоящееся содержимое не должно попадать в
    /// полосу гашения, иначе завеса выглядит тенью на пустом месте.
    out property <length> veil: 24px;
}
