// Дизайн-токены окна.
//
// ЦВЕТА И ДОЛИ СЮДА НЕ ПИШУТ РУКАМИ. Они живут в `design/palette.toml` и
// раскладываются отсюда и по трём другим темам скриптом `design/sync-palette.py`
// — см. размеченный участок ниже. Правка мимо источника продержится до первого
// прогона сторожа (`apps/bmv-gui/tests/palette_is_one_source.rs`).
//
// Всё, что ВНЕ участка, написано руками: пояснения, отступы страницы, геометрия
// ореола. Их скрипт не трогает.
export global Theme {
    // ── ЛЕСТНИЦА ПОВЕРХНОСТЕЙ: ПЯТЬ СТУПЕНЕЙ, ФОН НЕЙТРАЛЬНЫЙ ──
    //
    // УГОЛЬ ВМЕСТО СИНЕВЫ. Прежний фон был синим (тон 220°), и синеву несла вся
    // лестница. Сам по себе фон нравился, но блоки НА нём выглядели грязными:
    // цветная поверхность поверх цветной — это два близких оттенка, а два
    // близких оттенка глаз читает не как ступень, а как пятно. Тон убран
    // целиком: у угля нет оттенка, спорить не с чем, и ступень видно как
    // ступень. Цвет на экране остаётся ровно там, где он что-то значит —
    // в акценте, янтаре и красном.
    //
    // ШАГИ ИДУТ ПО ПОРЯДКУ: 5.7 / 3.5 / 2.4 / 5.3 по CIE L*, перепад блока к
    // фону — 5.7 / 9.2 / 11.5 / 16.9. Парящее НАМЕРЕННО между s2 и s3: оно выше
    // карточек списка, но ниже плиток, лежащих внутри него.
    //
    // ШАГИ НАМЕРЕННО НЕРАВНЫЕ, И ЗАПАС РОЗДАН ПО ДЕЛУ. Между s2 и парящим всего
    // 2.4, между парящим и s3 — 5.3. Это не перекос: s2 и парящее НИГДЕ не
    // соприкасаются (парящий слой всегда окружён ореолом в цвет страницы), а
    // плитки лежат прямо НА панели, и их перепад к ней виден в каждом кадре.
    // Панель опущена с 15.94 до 13.99 намеренно: самое крупное сплошное пятно
    // экрана читалось светлой плашкой, а не поднятым слоем. Вместе с ней на 1.0
    // опущена s2 — иначе панель встала бы вровень с раскрытой карточкой.
    //
    // ПОТОЛКА ПО КОНТРАСТУ ЗДЕСЬ БОЛЬШЕ НЕТ. Прежняя лестница упиралась в порог
    // 4.5 тремя подписями разом (dim 5.34, акцент 4.58, красный 4.56). Уголь
    // темнее, и на самой светлой ступени (s3) худшая подпись теперь 5.27
    // (красный), dim 5.76, янтарь 7.21, акцент 7.89, fg 11.85.
    //
    // ── ЗЕЛЁНОГО КАК ОТДЕЛЬНОГО ЦВЕТА БОЛЬШЕ НЕТ ─────────────────────────────
    //
    // Акцент — мята. Прежний зелёный «работает» (#34E29E) от неё не отличим
    // глазом, а два разных смысла одним цветом — ровно та болезнь, которую тут
    // лечили: зелёная кнопка «Старт» горела, когда человек НЕ защищён. Токен
    // зелёного удалён, мята несёт обе роли, а различает их ФОРМА:
    //   • кнопка       = контур плюс подкраска (picked + edge);
    //   • «работает»   = залитая площадь (точка связи, значок в панели).
    // Оттого же «выключено» больше не красится акцентом: у неё свой цвет — dim.
    // Иначе кольцо панели горело бы мятой и при «выключен», и при «подключено».
    //
    // ── КРОМКИ: ИХ РОВНО ПЯТЬ, И БОЛЬШЕ НЕ БЫВАЕТ ────────────────────────────
    //
    // Это не запрет, а ИСЧЕРПЫВАЮЩИЙ СПИСОК: любая рамка в приложении — одна из
    // пяти (`hairline`, `hairline-float`, `edge`, `edge-soft`, `edge-done`), и
    // выбирать между «0.05», «0.07» и «0.08» больше не приходится. Раньше
    // приходилось: кромка невыбранного была написана в двадцати девяти местах
    // пятью разными числами, и три оболочки уже разошлись — здесь стояло
    // `#FFFFFF14` (0.0784) там, где на телефонах 0.08.
    //
    // Числа записаны ДОЛЯМИ, а не шестнадцатеричной альфой: `#FFFFFF14`
    // невозможно сверить глазом с `0.08` в Swift, а `with-alpha(0.08)` — можно.
    //
    // ── ВЫБРАННОЕ: ОДНО ПРАВИЛО НА ВСЁ ПРИЛОЖЕНИЕ ────────────────────────────
    //
    // ВЫБРАННОЕ = СВОЯ СТУПЕНЬ ПЛЮС ПОДКРАСКА, А НЕ ПОДКРАСКА ПОВЕРХ ФОНА
    // СТРАНИЦЫ. Прозрачность в Slint (как в SwiftUI и Compose) смешивается с
    // тем, что лежит СЗАДИ, то есть с почти чёрной страницей: выбранное выходило
    // ТЕМНЕЕ невыбранного и читалось как вдавленное.
    //
    // СТУПЕНЬ ЗДЕСЬ ОДНА — s1. Всякий выбираемый элемент (чип, переключатель,
    // кнопка лимита, недавняя сеть, кнопка) лежит НА СТРАНИЦЕ, а первая ступень
    // над страницей и есть s1. Ячейка нав-бара сидит на парящем слое, но
    // красится тем же цветом намеренно — иначе она спорила бы яркостью с
    // панелью состояния наверху экрана.
    //
    // СИЛУ ДЕРЖИТ УЖЕ НЕ КОНТРАСТ, А ЛЕСТНИЦА. На прежней палитре 0.15 упиралась
    // в подпись (4.57 при пороге 4.5); на угле подпись отпустила — красный
    // доходит до порога только к 0.26. Теперь силу задаёт другое: выбранное
    // должно встать НА ВЕРХНЮЮ СТУПЕНЬ, а не перепрыгнуть её. 0.14 даёт мяте
    // L* 19.54 при s3 = 19.31 — ровно вровень с плиткой, как и было задумано.
    // Подписи при этом с запасом: мята на своей подкраске 7.84, красный 5.64.
    //
    // ЦВЕТ — НЕ ЕДИНСТВЕННЫЙ ПРИЗНАК. Выбранное везде несёт ещё и рамку в
    // оттенке, и подпись со значком в нём же: человеку с нарушением
    // цветовосприятия остаётся рамка, которой у невыбранного нет вовсе.
    // ── НАЧАЛО: значения из design/palette.toml (правит design/sync-palette.py) ──
    out property <color> bg:       #08090B;       // s0 — страница
    out property <color> card:     #15181D;       // s1 — карточка списка, поле ввода, кнопка «поделиться»
    out property <color> card-hi:  #1B1F25;       // s2 — раскрытая карточка, чип
    out property <color> tile:     #2A2F39;       // s3 — плитка внутри панели или карточки
    out property <color> float-bg: #1F242B;       // парящее: панель состояния и нав-бар
    out property <color> accent:   #2FE0A8;       // мята: и «это можно нажать», и «это работает»
    out property <color> fg:       #EDF1F8;       // основной текст
    out property <color> dim:      #A5AAB5;       // второстепенный текст и «выключено»
    out property <color> red:      #FF7974;       // беда, которая сама не пройдёт
    out property <color> amber:    #F5B14C;       // беда, которая пройдёт сама

    out property <color> hairline: #FFFFFF.with-alpha(0.08);
    out property <color> hairline-float: #FFFFFF.with-alpha(0.05);
    public pure function edge(tint: color, hover: bool) -> color { return tint.with-alpha(hover ? 0.7 : 0.4); }
    public pure function edge-soft(tint: color) -> color { return tint.with-alpha(0.28); }
    public pure function edge-done(tint: color) -> color { return tint.with-alpha(0.5); }
    public pure function disc-fill(tint: color) -> color { return tint.with-alpha(0.13); }
    public pure function disc-ring(tint: color) -> color { return tint.with-alpha(0.3); }

    public pure function picked(tint: color) -> color { return root.card.mix(tint, 0.86); }
    public pure function touched(tint: color) -> color { return root.card.mix(tint, 0.94); }

    out property <duration> copied-ms: 1300ms;
    // ── КОНЕЦ: значения из design/palette.toml ──

    out property <length> pad: 20px;     // отступ страницы (iOS .padding(20))
    out property <length> gap: 14px;     // зазор секций (iOS spacing: 14)
    /// Вылет гашения от контура парящего блока наружу. Отступы прокрутки на
    /// страницах считаются ОТ НЕЁ: покоящееся содержимое не должно попадать в
    /// зону гашения, иначе оно выглядит подтенённым на пустом месте.
    /// БЫЛО 24, УКОРОЧЕНО НА ЧЕТВЕРТЬ по просьбе владельца.
    out property <length> veil: 18px;
    /// Насколько ореол уходит ЗА блок, к ближнему краю окна. Блок прижат к
    /// краю, но не вплотную; в этот просвет содержимое пролезало и обрывалось о
    /// край окна. Ореол закрывает просвет тем же силуэтом — одна форма, без
    /// второго механизма и без стыка. С запасом: за окном лишний фон ничего не
    /// стоит, а не хватило бы — вышла бы жёсткая кромка поперёк экрана.
    out property <length> halo-back: 200px;
}
