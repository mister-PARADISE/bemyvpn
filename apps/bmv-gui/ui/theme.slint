// Дизайн-токены окна.
//
// ЦВЕТА И ДОЛИ СЮДА НЕ ПИШУТ РУКАМИ. Они живут в `design/palette.toml` и
// раскладываются отсюда и по трём другим темам скриптом `design/sync-palette.py`
// — см. размеченный участок ниже. Правка мимо источника продержится до первого
// прогона сторожа (`apps/bmv-gui/tests/palette_is_one_source.rs`).
//
// Всё, что ВНЕ участка, написано руками: пояснения, отступы страницы, геометрия
// ореола. Их скрипт не трогает.
export global Theme {
    // ── ЛЕСТНИЦА ПОВЕРХНОСТЕЙ: ПЯТЬ СТУПЕНЕЙ, ФОН НЕЙТРАЛЬНЫЙ ──
    //
    // УГОЛЬ ВМЕСТО СИНЕВЫ. Прежний фон был синим (тон 220°), и синеву несла вся
    // лестница. Сам по себе фон нравился, но блоки НА нём выглядели грязными:
    // цветная поверхность поверх цветной — это два близких оттенка, а два
    // близких оттенка глаз читает не как ступень, а как пятно. Тон убран
    // целиком: у угля нет оттенка, спорить не с чем, и ступень видно как
    // ступень. Цвет на экране остаётся ровно там, где он что-то значит —
    // в акценте, янтаре и красном.
    //
    // ШАГИ ИДУТ ПО ПОРЯДКУ: 4.2 / 2.4 / 2.0 / 8.2 по CIE L*, перепад блока к
    // фону — 4.2 / 6.6 / 8.7 / 16.9. Парящее НАМЕРЕННО между s2 и s3: оно выше
    // карточек списка, но ниже плиток, лежащих внутри него.
    //
    // ПАНЕЛЬ ОПУЩЕНА ДВАЖДЫ: 15.94 → 13.99 → 11.10. Первый заход заметили и
    // оставили, после него попросили ещё темнее: панель занимает верхнюю треть
    // экрана сплошной заливкой, и чем она темнее, тем меньше спорит с тем, ради
    // чего на неё смотрят. Вместе с ней вниз поехали ОБЕ карточки (s1 −1.50,
    // s2 −2.54), и это не побочный эффект, а условие: опустив одну панель, мы
    // оставили бы раскрытую карточку ВЫШЕ неё — парить стало бы не над чем.
    //
    // ШАГИ НАМЕРЕННО НЕРАВНЫЕ, И ЗАПАС РОЗДАН ПО ЧАСТОТЕ ВЗГЛЯДА. Самый широкий
    // (4.19) — странице и карточкам: это весь список, ради него сюда и смотрят.
    // Самый узкий (2.04) — между s2 и парящим, и он же самый безопасный: они
    // НИГДЕ не соприкасаются, парящий слой всегда окружён ореолом в цвет
    // страницы. Между свёрнутой и раскрытой карточкой 2.42 — они не соседи, а
    // СМЕНЯЮТ друг друга за 200мс, и вместе со ступенью меняется кромка. Плитки
    // лежат прямо НА панели, им остался самый крупный перепад (8.21).
    //
    // s3 НЕ ТРОНУТА НАРОЧНО: это самая светлая поверхность приложения, и она
    // держит потолок по контрасту для всего остального (см. ниже). Опустив её
    // вслед за прочими, глазом мы не выиграли бы ничего, а замер потеряли.
    //
    // ПОТОЛКА ПО КОНТРАСТУ ЗДЕСЬ БОЛЬШЕ НЕТ. Прежняя лестница упиралась в порог
    // 4.5 тремя подписями разом (dim 5.34, акцент 4.58, красный 4.56). Уголь
    // темнее, и на самой светлой ступени (s3) худшая подпись теперь 5.27
    // (красный), dim 5.76, янтарь 7.21, акцент 7.89, fg 11.85.
    //
    // ── ЗЕЛЁНОГО КАК ОТДЕЛЬНОГО ЦВЕТА БОЛЬШЕ НЕТ ─────────────────────────────
    //
    // Акцент — мята. Прежний зелёный «работает» (#34E29E) от неё не отличим
    // глазом, а два разных смысла одним цветом — ровно та болезнь, которую тут
    // лечили: зелёная кнопка «Старт» горела, когда человек НЕ защищён. Токен
    // зелёного удалён, мята несёт обе роли, а различает их ФОРМА:
    //   • кнопка       = контур плюс подкраска (picked + edge);
    //   • «работает»   = залитая площадь (точка связи, значок в панели).
    // Оттого же «выключено» больше не красится акцентом: у неё свой цвет — dim.
    // Иначе кольцо панели горело бы мятой и при «выключен», и при «подключено».
    //
    // ── КРОМКИ: ИХ РОВНО ШЕСТЬ, И БОЛЬШЕ НЕ БЫВАЕТ ───────────────────────────
    //
    // Это не запрет, а ИСЧЕРПЫВАЮЩИЙ СПИСОК: любая рамка в приложении — одна из
    // шести (`hairline`, `hairline-float`, `hairline-inner`, `edge`,
    // `edge-soft`, `edge-done`), и выбирать между «0.05», «0.07» и «0.08»
    // больше не приходится. Раньше приходилось: кромка невыбранного была
    // написана в двадцати девяти местах пятью разными числами, и три оболочки
    // уже разошлись — здесь стояло `#FFFFFF14` (0.0784) там, где на телефонах
    // 0.08.
    //
    // Числа записаны ДОЛЯМИ, а не шестнадцатеричной альфой: `#FFFFFF14`
    // невозможно сверить глазом с `0.08` в Swift, а `with-alpha(0.08)` — можно.
    //
    // ── КРОМКА СИНЯЯ, НО НЕ ВЕЗДЕ ────────────────────────────────────────────
    //
    // ЦВЕТ — ВТОРОЕ КОЛЬЦО ИКОНКИ (`outline`, оно же `[brand] ring_guest_top`),
    // а не новый ряд в палитре. Смыслы разведены жёстко: МЯТА значит «работает»
    // или «можно нажать», СИНИЙ не значит ничего — он просто говорит, где
    // кончается один блок и начинается другой. Поэтому выбранное синим не
    // красится нигде: стоит синему один раз означить «нажми», и различать два
    // смысла станет нечем.
    //
    // ПЕРВЫЕ ТРИ КРОМКИ — ОДНА КРОМКА, РАЗВЁРНУТАЯ ПО МЕСТУ, и вопрос у них
    // один: на чём эта штука лежит.
    //   hairline        лежит ПРЯМО НА СТРАНИЦЕ (карточка списка, кнопка,
    //                   невыбранная плитка) → синий, кромка ДЕРЖИТ границу;
    //   hairline-float  это САМ парящий слой (панель состояния, нав-бар) →
    //                   синий, но тише: слой уже поднят заливкой;
    //   hairline-inner  лежит ВНУТРИ блока (плитка на панели, плашка флага в
    //                   карточке, негромкая кнопка) → белый, как был.
    //
    // «НЕ ВЕЗДЕ» — ЭТО ПРО ТРЕТЬЮ СТРОКУ, И ОНА ЗДЕСЬ НЕ ДЛЯ СИММЕТРИИ. Плитка
    // на панели отделена от неё перепадом заливки в 8.21 по L*: кромка там
    // ВСПОМОГАТЕЛЬНАЯ, держать ей нечего. Синий на ней читался бы не как
    // граница, а как подсветка — то есть ровно как «это выделено», чего там
    // нет. Внутри блока кромка остаётся белой, и это единственное место, где
    // она белая. Держит правило не память, а часовой
    // (`crates/bmv-common/tests/palette_is_one_source.rs`, четвёртая беда).
    //
    // СИЛА ПОДОБРАНА ПО РЕЗУЛЬТАТУ, А НЕ ПО ЧИСЛУ: синий темнее белого, и та же
    // доля даёт вдвое более тусклую кромку. Перепад к своей заливке по CIE L*:
    //   на странице (card):     было 0.08 → #25282B  9.29 · стало 0.207 → #253249 14.02
    //   на парящем слое (float): было 0.05 → #25292F  5.32 · стало 0.126 → #252F40  8.11
    // Полтора раза прибавки — сознательно: жаловались именно на слабость.
    //
    // ── ВЫБРАННОЕ: ОДНО ПРАВИЛО НА ВСЁ ПРИЛОЖЕНИЕ ────────────────────────────
    //
    // ВЫБРАННОЕ = СВОЯ СТУПЕНЬ ПЛЮС ПОДКРАСКА, А НЕ ПОДКРАСКА ПОВЕРХ ФОНА
    // СТРАНИЦЫ. Прозрачность в Slint (как в SwiftUI и Compose) смешивается с
    // тем, что лежит СЗАДИ, то есть с почти чёрной страницей: выбранное выходило
    // ТЕМНЕЕ невыбранного и читалось как вдавленное.
    //
    // СТУПЕНЬ ЗДЕСЬ ОДНА — s1. Всякий выбираемый элемент (чип, переключатель,
    // кнопка лимита, недавняя сеть, кнопка) лежит НА СТРАНИЦЕ, а первая ступень
    // над страницей и есть s1. Ячейка нав-бара сидит на парящем слое, но
    // красится тем же цветом намеренно — иначе она спорила бы яркостью с
    // панелью состояния наверху экрана.
    //
    // СИЛУ ДЕРЖИТ УЖЕ НЕ КОНТРАСТ, А ЛЕСТНИЦА. На прежней палитре 0.15 упиралась
    // в подпись (4.57 при пороге 4.5); на угле подпись отпустила — красный
    // доходит до порога только к 0.26. Теперь силу задаёт другое: выбранное
    // должно встать НА ВЕРХНЮЮ СТУПЕНЬ, а не перепрыгнуть её. 0.155 даёт мяте
    // L* 19.36 при s3 = 19.31 — ровно вровень с плиткой, как и было задумано.
    // Подписи при этом с запасом: мята на своей подкраске 7.88, красный 5.26.
    //
    // ЧИСЛО ЕДЕТ ЗА s1, А НЕ СТОИТ. Пока s1 была 8.14, вровень с плиткой
    // вставало 0.14; s1 опустилась до 6.64 — и то же 0.14 дало бы 18.17, то есть
    // выбранное провалилось бы ПОД плитку. Опускается ступень — пересчитывается
    // и подкраска, иначе правило держится на совпадении, а не на замере.
    //
    // ЦВЕТ — НЕ ЕДИНСТВЕННЫЙ ПРИЗНАК. Выбранное везде несёт ещё и рамку в
    // оттенке, и подпись со значком в нём же: человеку с нарушением
    // цветовосприятия остаётся рамка, которой у невыбранного нет вовсе.
    // ── НАЧАЛО: значения из design/palette.toml (правит design/sync-palette.py) ──
    out property <color> bg:       #08090B;       // s0 — страница
    out property <color> card:     #121519;       // s1 — карточка списка, поле ввода, кнопка «поделиться»
    out property <color> card-hi:  #161A1F;       // s2 — раскрытая карточка, чип
    out property <color> tile:     #2A2F39;       // s3 — плитка внутри панели или карточки
    out property <color> float-bg: #1A1E24;       // парящее: панель состояния и нав-бар
    out property <color> accent:   #2FE0A8;       // мята: и «это можно нажать», и «это работает»
    out property <color> fg:       #EDF1F8;       // основной текст
    out property <color> dim:      #A5AAB5;       // второстепенный текст и «выключено»
    out property <color> red:      #FF7974;       // беда, которая сама не пройдёт
    out property <color> amber:    #F5B14C;       // беда, которая пройдёт сама
    out property <color> outline:  #6EA2FF;       // кромка: ГРАНИЦА, а не «нажми» — второе кольцо иконки

    out property <color> hairline: root.outline.with-alpha(0.207);
    out property <color> hairline-float: root.outline.with-alpha(0.126);
    out property <color> hairline-inner: #FFFFFF.with-alpha(0.08);
    public pure function edge(tint: color, hover: bool) -> color { return tint.with-alpha(hover ? 0.7 : 0.4); }
    public pure function edge-soft(tint: color) -> color { return tint.with-alpha(0.28); }
    public pure function edge-done(tint: color) -> color { return tint.with-alpha(0.5); }
    public pure function disc-fill(tint: color) -> color { return tint.with-alpha(0.13); }
    public pure function disc-ring(tint: color) -> color { return tint.with-alpha(0.3); }

    public pure function picked(tint: color) -> color { return root.card.mix(tint, 0.845); }
    public pure function touched(tint: color) -> color { return root.card.mix(tint, 0.94); }

    out property <length> float-radius: 22px;     // скругление панели и нав-бара
    out property <length> veil: 18px;             // вылет гашения от контура наружу; отступы прокрутки считаются от него

    out property <length> glow-reach: 12px;       // вылет свечения от контура карточки наружу
    out property <float> glow-peak: 0.22;         // непрозрачность мяты у самого контура; дальше линейно на нет

    out property <duration> copied-ms: 1300ms;
    // ── КОНЕЦ: значения из design/palette.toml ──

    out property <length> pad: 20px;     // отступ страницы (iOS .padding(20))
    out property <length> gap: 14px;     // зазор секций (iOS spacing: 14)
    /// Насколько ореол уходит ЗА блок, к ближнему краю окна. Блок прижат к
    /// краю, но не вплотную; в этот просвет содержимое пролезало и обрывалось о
    /// край окна. Ореол закрывает просвет тем же силуэтом — одна форма, без
    /// второго механизма и без стыка. С запасом: за окном лишний фон ничего не
    /// стоит, а не хватило бы — вышла бы жёсткая кромка поперёк экрана.
    out property <length> halo-back: 200px;
}
