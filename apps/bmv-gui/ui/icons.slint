// ── Логотип «Звено» (brand/logo.svg): два сцепленных кольца ──────────────────
// Кольца — Rectangle-круги с border; сцепку в мини-размере не имитируем
// (в 22px её всё равно не разглядеть) — просто синее слева, мятное справа.
export component IconLink inherits Rectangle {
    in property <length> ring: 22px;
    in property <length> rw: 5px;
    Rectangle {
        x: 0; y: (parent.height - root.ring) / 2;
        width: root.ring; height: root.ring;
        border-radius: self.width / 2;
        border-width: root.rw;
        border-color: #5E93FF;
    }
    Rectangle {
        x: root.ring * 0.68; y: (parent.height - root.ring) / 2;
        width: root.ring; height: root.ring;
        border-radius: self.width / 2;
        border-width: root.rw;
        border-color: #34E29E;
    }
    width: root.ring * 1.68;
}

// Питание (power) — включатель раздачи в нав-баре.
export component IconPower inherits Rectangle {
    in property <color> tint: white;
    StrokeIcon {
        width: 100%; height: 100%; tint: root.tint;
        // Дуга разомкнута сверху, вертикальная черта в разрыве — канонический
        // знак питания.
        commands: "M7.6 6.6 A 7.5 7.5 0 1 0 16.4 6.6 M12 3 L12 11.5";
    }
}
