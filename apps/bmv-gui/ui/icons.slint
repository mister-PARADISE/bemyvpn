// Значки (аналоги SF Symbols с iOS) — SVG в квадрате 24×24, файлы в icons/.
//
// ПОЧЕМУ SVG, А НЕ ЭЛЕМЕНТ `Path`. Значки были нарисованы командами `Path`
// прямо здесь, и на машине С видеокартой это работало. А на машине БЕЗ неё
// приложение уходит на программный растеризатор (см. `restart_on_software_renderer`
// в main.rs), и у него `draw_path` — пустая заглушка `// TODO`
// (i-slint-core/software_renderer.rs): значок занимает своё место в раскладке и
// не выдаёт ни одного пикселя. Свежая Windows без драйвера видела экран, где щит,
// стрелки, шевроны и содержимое кнопок «вставить» и «QR» просто отсутствуют —
// кнопки выглядели пустыми квадратами. Картинку тот же растеризатор рисует, и SVG
// в нём растеризуется через resvg, поэтому один и тот же файл годится ОБОИМ путям.
//
// `colorize` красит непрозрачные точки картинки в нужный цвет, поэтому в файлах
// белое, а цвет приходит из разметки — ровно как раньше через `fill`/`stroke`.
// Растр кешируется по (файл, размер, масштаб экрана), на Retina растеризуется в
// физическом размере (femtovg itemrenderer: `target_size * scale_factor`), то есть
// чёткость не теряется. Менять размер значка АНИМАЦИЕЙ теперь нельзя: каждый
// кадр — новый размер, то есть заново resvg и заново текстура. Ни один значок
// размер не анимирует, и заводить такую анимацию не нужно.
//
// РАЗНИЦА, КОТОРУЮ СТОИТ ЗНАТЬ: у `Path` толщина обводки задавалась в точках
// ЭКРАНА и не зависела от размера значка (2px и в 12, и в 32 точках). У SVG
// обводка живёт в координатах картинки и масштабируется вместе с ней — как у
// любого значкового набора. Мелкие значки стали тоньше, крупные толще; числа
// толщины в файлах те же, что стояли в `stroke-width`.
//
// `hole` — прорезь В ЦВЕТ ТОЙ ПОВЕРХНОСТИ, НА КОТОРОЙ ЗНАЧОК ЛЕЖИТ. Значения по
// умолчанию берутся из темы, а не вписаны числом: вписанные отстали от палитры
// на две правки подряд и рисовали поперёк значка щель чужого оттенка.

import { Theme } from "theme.slint";

// Базовый значок: картинка, перекрашенная в цвет значка.
//
// `image-fit: contain` — форма квадратная, как и все места, куда значок ставят;
// с ним значок не растянется, даже если однажды попадёт в неквадратную ячейку.
component Glyph inherits Image {
    in property <color> tint: white;
    colorize: root.tint;
    image-fit: contain;
}

// ── Щиты (протоколы/статусы VPN) ─────────────────────────────────────────────

// Щит целиком (shield.fill).
export component IconShield inherits Glyph {
    source: @image-url("icons/shield.svg");
}

// Щит с галочкой (checkmark.shield.fill) — «подключено».
export component IconShieldCheck inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: Theme.card;
    Glyph { width: 100%; height: 100%; tint: root.tint; source: @image-url("icons/shield.svg"); }
    Glyph { width: 100%; height: 100%; tint: root.hole; source: @image-url("icons/shield-check.svg"); }
}

// Щит перечёркнут (shield.slash.fill) — «VPN выключен» / «без шифра».
export component IconShieldSlash inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: Theme.card;
    Glyph { width: 100%; height: 100%; tint: root.tint; source: @image-url("icons/shield.svg"); }
    Glyph { width: 100%; height: 100%; tint: root.hole; source: @image-url("icons/shield-slash.svg"); }
}

// Щит с замочной скважиной (lock.shield.fill) — «Обычный» протокол.
export component IconShieldLock inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: Theme.card;
    Glyph { width: 100%; height: 100%; tint: root.tint; source: @image-url("icons/shield.svg"); }
    Glyph { width: 100%; height: 100%; tint: root.hole; source: @image-url("icons/shield-keyhole.svg"); }
}

// «Маскировка» протокол — маскарадная маска с прорезями-глазами (evenodd). Как iOS
// theatermasks.fill; чистая на любом размере.
export component IconMask inherits Glyph {
    source: @image-url("icons/mask.svg");
}

// ── Нав-бар и действия ───────────────────────────────────────────────────────

export component IconBolt inherits Glyph {
    source: @image-url("icons/bolt.svg");
}

export component IconX inherits Glyph {
    source: @image-url("icons/x.svg");
}

// Сервер (server.rack): две полки с индикаторами.
export component IconServer inherits Glyph {
    source: @image-url("icons/server.svg");
}

// Роутер (wifi.router.fill): корпус + антенны.
export component IconRouter inherits Glyph {
    source: @image-url("icons/router.svg");
}

// ── Мелкие статусные ─────────────────────────────────────────────────────────

export component IconLock inherits Glyph {
    source: @image-url("icons/lock.svg");
}

export component IconLockOpen inherits Glyph {
    source: @image-url("icons/lock-open.svg");
}

// Копировать (doc.on.doc): два листа.
export component IconCopy inherits Glyph {
    source: @image-url("icons/copy.svg");
}

// Галочка «готово» — линиями, а не символом «✓»: его нет в системном шрифте.
export component IconCheck inherits Glyph {
    source: @image-url("icons/check.svg");
}

// QR-код: три угловых квадрата + точки.
export component IconQr inherits Glyph {
    source: @image-url("icons/qr.svg");
}

export component IconArrowRight inherits Glyph {
    source: @image-url("icons/arrow-right.svg");
}

// Вставить (doc.on.clipboard): планшет + прищепка.
export component IconPaste inherits Glyph {
    source: @image-url("icons/paste.svg");
}

// Новый код (arrow.triangle.2.circlepath): две дуги со стрелками.
export component IconRenew inherits Glyph {
    source: @image-url("icons/renew.svg");
}

// Антенна (antenna.radiowaves.left.and.right).
export component IconAntenna inherits Glyph {
    source: @image-url("icons/antenna.svg");
}

// Антенна перечёркнута — «нет связи». Прорезь шире самой черты: она отделяет
// черту от антенны цветом поверхности, на которой значок лежит.
export component IconAntennaOff inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: Theme.tile;
    IconAntenna { width: 100%; height: 100%; tint: root.tint; }
    Glyph { width: 100%; height: 100%; tint: root.hole; source: @image-url("icons/antenna-cut.svg"); }
    Glyph { width: 100%; height: 100%; tint: root.tint; source: @image-url("icons/antenna-slash.svg"); }
}

export component IconChevronRight inherits Glyph {
    source: @image-url("icons/chevron-right.svg");
}

export component IconChevronUp inherits Glyph {
    source: @image-url("icons/chevron-up.svg");
}

// Гости (person.2.fill): две фигурки.
export component IconPeople inherits Glyph {
    source: @image-url("icons/people.svg");
}

// Глобус (публичный хост).
export component IconGlobe inherits Glyph {
    source: @image-url("icons/globe.svg");
}

// Глаз перечёркнут (скрытый хост).
export component IconEyeOff inherits Glyph {
    source: @image-url("icons/eye-off.svg");
}

// Предупреждение (exclamationmark.triangle.fill).
export component IconWarning inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: Theme.bg;
    Glyph { width: 100%; height: 100%; tint: root.tint; source: @image-url("icons/warning.svg"); }
    Glyph { width: 100%; height: 100%; tint: root.hole; source: @image-url("icons/warning-bang.svg"); }
}

// Питание (power) — включатель раздачи в нав-баре. Дуга разомкнута сверху,
// вертикальная черта в разрыве — канонический знак питания.
export component IconPower inherits Glyph {
    source: @image-url("icons/power.svg");
}
