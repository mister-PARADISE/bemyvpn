// Векторные иконки (аналоги SF Symbols с iOS) — Path-команды в viewbox 24×24.
// femtovg не рисует эмодзи, поэтому ВСЕ значки — вектор. Стиль единый:
// заливка для «телесных» форм, обводка 2px для линейных.

// Базовый заливной значок.
component FillIcon inherits Path {
    in property <color> tint: white;
    fill: root.tint;
    viewbox-width: 24;
    viewbox-height: 24;
}

// Базовый линейный значок.
component StrokeIcon inherits Path {
    in property <color> tint: white;
    stroke: root.tint;
    stroke-width: 2px;
    fill: transparent;
    viewbox-width: 24;
    viewbox-height: 24;
}

// ── Щиты (протоколы/статусы VPN) ─────────────────────────────────────────────

// Щит целиком (shield.fill).
export component IconShield inherits FillIcon {
    commands: "M12 2 L20 5 L20 11 C20 16.5 16.6 20.4 12 22 C7.4 20.4 4 16.5 4 11 L4 5 Z";
}

// Щит с галочкой (checkmark.shield.fill) — «подключено».
export component IconShieldCheck inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: #121722;
    FillIcon { width: 100%; height: 100%; tint: root.tint; commands: "M12 2 L20 5 L20 11 C20 16.5 16.6 20.4 12 22 C7.4 20.4 4 16.5 4 11 L4 5 Z"; }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.hole; stroke-width: 2.4px; fill: transparent;
        commands: "M8.4 11.8 L11 14.4 L15.8 9.2";
    }
}

// Щит перечёркнут (shield.slash.fill) — «VPN выключен» / «без шифра».
export component IconShieldSlash inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: #121722;
    FillIcon { width: 100%; height: 100%; tint: root.tint; commands: "M12 2 L20 5 L20 11 C20 16.5 16.6 20.4 12 22 C7.4 20.4 4 16.5 4 11 L4 5 Z"; }
    Path {
        width: 100%; height: 100%;
        viewbox-width: 24; viewbox-height: 24;
        stroke: root.hole; stroke-width: 2.6px; fill: transparent;
        commands: "M4.5 3.5 L19.5 20.5";
    }
}

// Щит с замочной скважиной (lock.shield.fill) — «Обычный» протокол.
export component IconShieldLock inherits Rectangle {
    in property <color> tint: white;
    in property <color> hole: #121722;
    FillIcon { width: 100%; height: 100%; tint: root.tint; commands: "M12 2 L20 5 L20 11 C20 16.5 16.6 20.4 12 22 C7.4 20.4 4 16.5 4 11 L4 5 Z"; }
    FillIcon {
        width: 100%; height: 100%;
        tint: root.hole;
        commands: "M12 8 A 2.4 2.4 0 0 1 14.4 10.4 C 14.4 11.3 13.9 12.1 13.1 12.5 L 14 16 L 10 16 L 10.9 12.5 C 10.1 12.1 9.6 11.3 9.6 10.4 A 2.4 2.4 0 0 1 12 8 Z";
    }
}

// «Маскировка» протокол — маскарадная маска с прорезями-глазами (evenodd). Как iOS
// theatermasks.fill; чистая на любом размере.
export component IconMask inherits FillIcon {
    fill-rule: evenodd;
    commands: "M3 8 C6 6.4 9 6.4 12 8 C15 6.4 18 6.4 21 8 C21.6 11.2 20 14.6 16.2 14.6 C14.1 14.6 12.9 13.1 12 11.7 C11.1 13.1 9.9 14.6 7.8 14.6 C4 14.6 2.4 11.2 3 8 Z M6.2 9.9 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 Z M14.8 9.9 a1.5 1.5 0 1 0 3 0 a1.5 1.5 0 1 0 -3 0 Z";
}

