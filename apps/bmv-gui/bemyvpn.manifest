<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Манифест приложения BeMyVPN (Windows).
     requireAdministrator: VPN создаёт TUN-адаптер и правит таблицу маршрутов —
     это требует прав администратора. С этим уровнем Windows САМА показывает
     диалог UAC при запуске, без «запустите от имени администратора» вручную и
     без отдельного процесса-хелпера.
     PerMonitorV2: чёткий интерфейс на HiDPI-мониторах. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WSDL/State">PerMonitorV2</dpiAwareness>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WSDL/State">true</longPathAware>
    </windowsSettings>
  </application>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
